---
import Link from "../design/primitives/Link.astro";
interface Props {
  email: string;
}
const { email } = Astro.props;
---

<footer class="site-footer shell">
  <span>Burooj Rashid</span>
  <Link href={`mailto:${email}`} arrow>
    {email}
  </Link>
  <Link href="/resume" arrow>
    Resume
  </Link>
  <span class="thanks">Thanks for stopping by.</span>
</footer>
<style>
  .site-footer {
    border-top: var(--rule-width) solid var(--color-border);
    padding-top: var(--space-l);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    font-size: var(--text-sm);
    margin-top: var(--space-xl);
  }
  .thanks {
    margin-left: auto;
  }
  @media (max-width: 40.625rem) {
    .thanks {
      margin-left: 0;
    }
  }
</style>

---
import type { SiteData } from "../content.config";
import Link from "../design/primitives/Link.astro";
import { resolveLink } from "../lib/rules";
interface Props {
  site: SiteData;
}
const { site } = Astro.props;
const links = site.footer.links.map((link) => resolveLink(site, link));
---

<footer class="site-footer shell">
  <span>{site.name}</span>
  <Link href={`mailto:${site.email}`}>{site.email}</Link>
  {links.map((link) => <Link href={link.href}>{link.label}</Link>)}
  <span class="thanks">{site.footer.signoff}</span>
</footer>
<style>
  .site-footer {
    border-top: var(--rule-width) solid var(--color-border);
    padding-top: var(--space-l);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    font-size: var(--text-sm);
    margin-top: var(--space-xl);
  }
  .thanks {
    margin-left: auto;
  }
  @media (max-width: 40.625rem) {
    .thanks {
      margin-left: 0;
    }
  }
</style>

---
/** Composition: an entry's page in reading order, in Daylight. Its prose
 * is set as written; every other block is drawn plainly and marked as its
 * part (`block.gallery`, by the entry and the block's name). A page with
 * no block but prose is given no stylesheet and no script for them; an
 * embed and a model ask for nothing until they are asked for.
 */
import BlockPicture from "./blocks/BlockPicture.astro";
import BlockScript from "./blocks/BlockScript.astro";
import BlockStage from "./blocks/BlockStage.astro";
import BlockTree from "./blocks/BlockTree.astro";
import Inline from "../design/primitives/Inline.astro";
import Link from "../design/primitives/Link.astro";
import { quoteDateLabel, type Block } from "../lib/blocks";
import { plainInline } from "../lib/inline";
import { blockRef, part } from "../prism/parts";
import type { SiteContent } from "../prism/shells/types";
import stylesheet from "../styles/blocks.css?url";

interface Props {
  blocks: Block[];
  /** The entry whose page this is. */
  slug: string;
  /** `blocks` in site/config.json. */
  copy: SiteContent["site"]["blocks"];
}
const { blocks, slug, copy } = Astro.props;
type Told = Exclude<Block, { type: "text" }>;
const told = blocks.some((block) => block.type !== "text");
// What needs the script: something loaded on a press, or a film that
// plays by itself.
const live = blocks.some(
  (block) =>
    block.type === "embed" ||
    block.type === "model" ||
    (block.type === "film" && block.loop),
);
const mark = (block: Told) =>
  part(`block.${block.type}`, blockRef(slug, block.name));
/** What a piece of media is, in plain words. */
const named = (media: { alt?: string; caption?: string }) =>
  media.alt ?? plainInline(media.caption ?? "");
const stageId = (block: Told) => `block-${slug}-${block.name}`;
---

{told && <link rel="stylesheet" href={stylesheet} />}
{
  blocks.map((block) => (
    <>
      {block.type === "text" && <Fragment set:html={block.html} />}
      {block.type === "gallery" && (
        <div class="block block-gallery" {...mark(block)}>
          {block.items.map((picture) => (
            <BlockPicture picture={picture} />
          ))}
        </div>
      )}
      {block.type === "compare" && (
        <figure class="block block-compare" {...mark(block)}>
          <div class="block-compare__sides">
            <BlockPicture
              picture={block.before}
              label={block.before.label ?? copy.compare.before}
            />
            <BlockPicture
              picture={block.after}
              label={block.after.label ?? copy.compare.after}
            />
          </div>
          {block.caption && (
            <figcaption>
              <Inline text={block.caption} links="plain" />
            </figcaption>
          )}
        </figure>
      )}
      {block.type === "embed" && (
        <figure class="block block-embed" {...mark(block)}>
          <BlockStage
            id={stageId(block)}
            title={named(block)}
            poster={block.poster}
            ratio={block.ratio}
            load={copy.embed.load[block.kind]}
            close={copy.embed.close}
            note={copy.embed.note}
            data-frame={block.frame}
          >
            <Link slot="open" href={block.src} arrow>
              {copy.embed.open[block.kind]}
            </Link>
          </BlockStage>
          {block.caption && (
            <figcaption>
              <Inline text={block.caption} links="plain" />
            </figcaption>
          )}
        </figure>
      )}
      {block.type === "model" && (
        <figure class="block block-model" {...mark(block)}>
          <BlockStage
            id={stageId(block)}
            title={named(block)}
            poster={block.poster}
            ratio={block.ratio}
            load={copy.model.load}
            close={copy.model.close}
            note={copy.model.note}
            data-model={block.src}
            data-format={block.format}
            data-rotation={block.rotation?.join(",")}
            data-hint={copy.model.hint}
            data-failed={copy.model.failed}
          />
          {block.caption && (
            <figcaption>
              <Inline text={block.caption} links="plain" />
            </figcaption>
          )}
        </figure>
      )}
      {block.type === "code" && (
        <figure class="block block-code" {...mark(block)}>
          <pre tabindex="0" data-language={block.language}><code set:text={block.code.trimEnd()} /></pre>
          {block.caption && (
            <figcaption>
              <Inline text={block.caption} links="plain" />
            </figcaption>
          )}
        </figure>
      )}
      {block.type === "quote" && (
        <figure class="block block-quote" {...mark(block)}>
          <blockquote>
            {block.text
              .split(/\n\s*\n/)
              .map((paragraph) => (
                <p>
                  <Inline text={paragraph.trim()} links="plain" />
                </p>
              ))}
          </blockquote>
          <figcaption>
            <cite>{block.source}</cite>
            {block.date && (
              <time datetime={block.date}>{quoteDateLabel(block.date)}</time>
            )}
          </figcaption>
        </figure>
      )}
      {block.type === "steps" && (
        <ol class="block-steps" {...mark(block)}>
          {block.items.map((step) => (
            <li>
              <div class="block-step">
                {step.title && <p class="block-step__title">{step.title}</p>}
                <p>
                  <Inline text={step.text} links="plain" />
                </p>
                {step.image && <BlockPicture picture={step.image} />}
              </div>
            </li>
          ))}
        </ol>
      )}
      {block.type === "tree" && (
        <figure class="block block-tree" {...mark(block)}>
          <BlockTree nodes={block.tree} />
          {block.caption && (
            <figcaption>
              <Inline text={block.caption} links="plain" />
            </figcaption>
          )}
        </figure>
      )}
      {block.type === "audio" && (
        <figure class="block block-audio" {...mark(block)}>
          <audio
            controls
            preload="none"
            src={block.src}
            aria-label={named(block)}
          />
          <figcaption>
            <Inline text={block.caption ?? block.alt ?? ""} links="plain" />
          </figcaption>
        </figure>
      )}
      {block.type === "film" && (
        <figure class="block block-film" {...mark(block)}>
          <video
            controls
            muted
            playsinline
            loop={block.loop}
            preload="metadata"
            poster={block.poster}
            aria-label={named(block)}
            data-block-loop={block.loop ? "" : undefined}
          >
            <source src={block.src} />
          </video>
          {block.caption && (
            <figcaption>
              <Inline text={block.caption} links="plain" />
            </figcaption>
          )}
        </figure>
      )}
    </>
  ))
}
{live && <BlockScript />}

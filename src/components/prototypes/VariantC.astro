---
import type { PrototypeData } from './types';
const { projects, updates, site } = Astro.props as PrototypeData;
---

<div class="index-home" id="c-home">
  <div class="top-layout">
    <aside class="identity" aria-label="About Burooj and site navigation">
      <p class="greeting">Hey there!</p>
      <h1>Burooj<br />here!</h1>
      <p class="occupation">Web Dev/signer</p>
      <p class="welcome">Welcome to my home on the internet. Feel free to look around!</p>
      <nav class="circle-nav" aria-label="Site navigation">
        <svg class="nav-line" viewBox="0 0 310 330" aria-hidden="true"><path d="M 170 5 C 310 60 80 70 130 150 S 310 245 130 320" /></svg>
        <a class="circle circle-projects" href="/projects">Projects <span aria-hidden="true">↗</span></a>
        <a class="circle circle-about" href="/about">About me <span aria-hidden="true">↗</span></a>
        <a class="circle circle-lab" href="/lab">Lab <span aria-hidden="true">↗</span></a>
        <a class="circle circle-writing" href={site.writingUrl}>Writing <span aria-hidden="true">↗</span></a>
        <a class="circle circle-resume" href="/resume">Resume <span aria-hidden="true">↗</span></a>
      </nav>
      <div class="portrait-note">
        <img src="/images/burooj4.jpg" alt="Burooj Rashid wearing round sunglasses" width="1080" height="1920" />
        <div class="social-links" aria-label="Elsewhere on the web">
          {site.social.map((link) => <a href={link.href}>{link.label} <span aria-hidden="true">↗</span></a>)}
        </div>
      </div>
    </aside>
    <section class="projects" aria-labelledby="c-projects">
      <header class="section-header"><h2 id="c-projects">Selected projects</h2><a href="/projects">All projects <span aria-hidden="true">↗</span></a></header>
      <div class="project-list">
        {projects.map((project, index) => (
          <article class="project-entry">
            <div class="project-body">
              <p class="project-meta">{project.dateLabel} <span aria-hidden="true">·</span> {project.role}</p>
              <h3><a href={project.href}>{project.title}</a></h3>
              <p class="project-summary">{project.summary}</p>
              <ul class="project-tools" aria-label={`${project.title} tools`}>{project.tools.map((tool) => <li>{tool}</li>)}</ul>
            </div>
            <a class="project-preview" href={project.href} aria-label={`View ${project.title}`}>
              <img src={project.cover} alt="" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" width="640" height="400" />
              <span class="preview-arrow" aria-hidden="true">↗</span>
            </a>
          </article>
        ))}
      </div>
    </section>
  </div>
  <div class="journal-layout">
    <section class="currently" aria-labelledby="c-currently">
      <h2 id="c-currently">Currently</h2>
      <p>I’m maintaining <a href="/lab">bjslab</a>, my home-lab environment for the tools and services I use.</p>
      <a class="text-link" href="/about">More about me <span aria-hidden="true">↗</span></a>
      <div class="other-links"><a href="/lab">Lab <span aria-hidden="true">↗</span></a><a href={site.writingUrl}>Writing <span aria-hidden="true">↗</span></a></div>
    </section>
    <section class="updates" aria-labelledby="c-updates">
      <header class="section-header"><h2 id="c-updates">Recent updates</h2></header>
      <div class="update-list">
        {updates.map((update) => (
          <article class="update-entry">
            <time datetime={update.date}>{update.dateLabel}</time>
            <div><h3>{update.title}</h3><p>{update.summary}</p><a href={update.href}>{update.linkLabel} <span aria-hidden="true">↗</span></a></div>
          </article>
        ))}
      </div>
    </section>
  </div>
  <footer class="index-footer">
    <a class="footer-name" href={`mailto:${site.email}`}>{site.name}</a>
    <a href={`mailto:${site.email}`}>{site.email}</a>
    <a class="back-top" href="#c-home">Back to top <span aria-hidden="true">↑</span></a>
  </footer>
</div>

<style>
  .index-home { --paper: #d9d7d0; --burgundy: #7c2621; --peach: #e5b483; --ink: #25231f; --muted: #625851; --rule: #b6a79a; --display: "Newsreader Variable", "Newsreader", Georgia, serif; background: var(--paper); color: var(--ink); font-family: "Lato", sans-serif; font-size: 16px; line-height: 1.55; padding: 68px clamp(24px, 6vw, 96px) 0; position: relative; overflow: hidden; isolation: isolate; scroll-margin-top: 25px; }
  .index-home::before { content: ""; width: 380px; height: 380px; border-radius: 50%; background: var(--burgundy); position: absolute; left: -310px; top: -150px; z-index: -1; }
  .index-home::after { content: ""; position: absolute; width: 1500px; height: 740px; border-radius: 50%; background: var(--burgundy); bottom: -635px; right: -500px; z-index: -1; }
  .index-home a { color: var(--burgundy); text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .index-home a:hover { text-decoration: underline; }
  .index-home a:focus-visible { outline: 3px solid var(--burgundy); outline-offset: 5px; }
  .index-home h1, .index-home h2, .index-home h3, .index-home p { margin: 0; }
  .index-home h1, .index-home h2, .index-home h3 { font-family: var(--display); }
  .top-layout, .journal-layout { position: relative; display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: clamp(48px, 7vw, 100px); max-width: 1260px; margin: 0 auto; }
  .identity { min-width: 0; padding-top: 8px; }
  .greeting { font-size: 27px; font-weight: 900; letter-spacing: -.5px; }
  .index-home h1 { font-size: 91px; font-weight: 800; line-height: .84; letter-spacing: -3.5px; color: var(--burgundy); margin-top: 22px; }
  .occupation { margin-top: 22px !important; color: var(--burgundy); font-size: 23px; }
  .welcome { margin-top: 20px !important; max-width: 250px; font-size: 16px; }
  .circle-nav { width: 300px; height: 300px; position: relative; margin-top: 32px; }
  .nav-line { position: absolute; width: 275px; height: 280px; top: 4px; right: 0; fill: none; stroke: var(--burgundy); stroke-width: 1.5; opacity: .6; pointer-events: none; }
  .circle { display: flex; flex-direction: column; align-items: center; justify-content: center; position: absolute; border-radius: 50%; background: var(--peach); text-decoration: none; font-size: 17px; line-height: 1.35; box-shadow: -5px 7px 0 rgba(124, 38, 33, .07); }
  .circle:hover { box-shadow: -5px 7px 0 rgba(124, 38, 33, .18); }
  .circle span { font-size: 20px; line-height: 1.1; }
  .circle-projects { width: 118px; height: 118px; left: 3px; top: 9px; background: var(--burgundy); color: var(--peach) !important; }
  .circle-about { width: 103px; height: 103px; left: 149px; top: 0; }
  .circle-lab { width: 88px; height: 88px; left: 116px; top: 118px; }
  .circle-writing { width: 103px; height: 103px; left: 4px; top: 167px; }
  .circle-resume { width: 89px; height: 89px; left: 207px; top: 202px; }
  .portrait-note { display: flex; align-items: center; gap: 23px; margin-top: 12px; }
  .portrait-note img { width: 91px; height: 112px; border-radius: 50%; object-fit: cover; object-position: 50% 42%; }
  .social-links { display: flex; flex-wrap: wrap; gap: 8px 16px; align-content: center; max-width: 170px; }
  .social-links a { font-size: 14px; }
  .projects { min-width: 0; }
  .section-header { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 0 0 20px; border-bottom: 1px solid var(--burgundy); }
  .section-header h2 { font-size: 30px; line-height: 1.1; font-weight: 500; color: var(--burgundy); letter-spacing: -.7px; }
  .section-header > a { font-size: 14px; white-space: nowrap; }
  .project-entry { display: grid; grid-template-columns: minmax(0, 1fr) 205px; gap: 28px; align-items: center; padding: 34px 0 32px; border-bottom: 1px solid var(--rule); }
  .project-meta { color: var(--muted); font-size: 14px; line-height: 1.5; }
  .project-meta span { margin-inline: 4px; }
  .project-entry h3 { font-size: clamp(36px, 3.65vw, 52px); font-weight: 650; line-height: .99; letter-spacing: -1.4px; margin-top: 13px; }
  .project-entry h3 a { text-decoration: none; }
  .project-summary { margin-top: 15px !important; font-size: 15px; line-height: 1.55; }
  .project-tools { display: flex; flex-wrap: wrap; gap: 3px 13px; padding: 0; margin: 14px 0 0; list-style: none; color: var(--muted); font-size: 14px; }
  .project-preview { display: block; position: relative; width: 100%; margin-top: 13px; }
  .project-preview::before { content: ""; position: absolute; inset: 10px -8px -10px 8px; background: repeating-linear-gradient(135deg, transparent 0 3px, rgba(124,38,33,.23) 3px 4px); z-index: -1; }
  .project-preview img { width: 100%; height: auto; aspect-ratio: 1.35; object-fit: cover; display: block; }
  .preview-arrow { display: grid; place-items: center; position: absolute; bottom: -16px; right: 9px; border-radius: 50%; width: 41px; height: 41px; background: var(--peach); font-size: 23px; }
  .journal-layout { margin-top: 70px; padding-top: 44px; }
  .journal-layout::before { content: ""; position: absolute; height: 15px; top: 0; left: -100px; right: -100px; background: repeating-linear-gradient(135deg, transparent 0 3px, rgba(124,38,33,.18) 3px 4px); }
  .currently h2 { color: var(--burgundy); font-size: 39px; font-weight: 600; letter-spacing: -1px; }
  .currently p { margin-top: 17px; font-size: 18px; line-height: 1.6; }
  .currently p a { font-weight: 700; }
  .text-link { display: inline-block; margin-top: 17px; font-size: 14px; }
  .other-links { display: flex; gap: 25px; margin-top: 28px; padding-top: 21px; border-top: 1px solid var(--rule); }
  .other-links a { font-size: 18px; }
  .updates { min-width: 0; }
  .update-entry { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 24px; padding: 25px 0; border-bottom: 1px solid var(--rule); }
  .update-entry time { color: var(--muted); font-size: 14px; padding-top: 2px; }
  .update-entry h3 { font-size: 26px; line-height: 1.12; letter-spacing: -.4px; font-weight: 600; color: var(--burgundy); }
  .update-entry p { font-size: 15px; margin-top: 9px; }
  .update-entry a { display: inline-block; margin-top: 9px; font-size: 14px; }
  .index-footer { position: relative; max-width: 1260px; margin: 75px auto 0; padding: 28px 0 100px; display: flex; gap: 20px; align-items: baseline; flex-wrap: wrap; border-top: 1px solid var(--rule); }
  .footer-name { font-family: var(--display); font-size: 27px; font-weight: 600; text-decoration: none; }
  .index-footer > a:not(.footer-name) { font-size: 14px; }
  .back-top { margin-left: auto; }
  @media (max-width: 1100px) {
    .index-home { padding-inline: 38px; }
    .top-layout, .journal-layout { grid-template-columns: 265px minmax(0, 1fr); gap: 44px; }
    .index-home h1 { font-size: 82px; }
    .circle-nav { transform: scale(.87); transform-origin: left top; margin-bottom: -36px; }
    .project-entry { grid-template-columns: minmax(0, 1fr) 155px; gap: 20px; }
    .project-entry h3 { font-size: 39px; }
    .project-preview img { aspect-ratio: 1; }
  }
  @media (max-width: 800px) {
    .index-home { padding: 40px 26px 0; }
    .index-home::before { width: 270px; height: 270px; left: -255px; top: -125px; }
    .top-layout, .journal-layout { grid-template-columns: minmax(0, 1fr); gap: 42px; }
    .identity { display: grid; grid-template-columns: minmax(0, 1fr) 285px; column-gap: 20px; }
    .greeting, .identity h1, .occupation, .welcome { grid-column: 1; }
    .greeting { font-size: 23px; }
    .index-home h1 { font-size: 80px; margin-top: 18px; }
    .occupation { margin-top: 18px !important; font-size: 21px; }
    .welcome { margin-top: 16px !important; }
    .circle-nav { grid-column: 2; grid-row: 1 / 6; margin-top: 4px; transform: scale(.94); height: 300px; }
    .portrait-note { grid-column: 1 / -1; margin-top: 28px; gap: 22px; }
    .portrait-note img { width: 62px; height: 75px; }
    .social-links { max-width: none; gap: 16px; }
    .project-entry { grid-template-columns: minmax(0, 1fr) 205px; }
    .project-preview img { aspect-ratio: 1.35; }
    .project-entry h3 { font-size: 45px; }
    .journal-layout { margin-top: 46px; }
    .currently { max-width: 500px; }
    .index-footer { margin-top: 48px; }
  }
  @media (max-width: 570px) {
    .index-home { padding-inline: 22px; }
    .identity { display: block; }
    .index-home h1 { font-size: 77px; line-height: .86; }
    .welcome { max-width: 320px; }
    .circle-nav { display: grid; grid-template-columns: repeat(3, 1fr); width: 100%; height: auto; gap: 8px 12px; align-items: center; justify-items: center; transform: none; margin: 28px 0 0; padding: 0 0 7px; }
    .nav-line { inset: 0; width: 100%; height: 100%; opacity: .25; }
    .circle { position: relative; inset: auto; width: 86px; height: 86px; font-size: 15px; }
    .circle-projects { width: 96px; height: 96px; }
    .circle-writing { grid-column: 1 / 3; justify-self: center; margin-left: 32px; }
    .circle-resume { grid-column: 3; margin-left: -42px; }
    .portrait-note { margin-top: 22px; }
    .social-links { gap: 8px 16px; }
    .section-header h2 { font-size: 27px; }
    .section-header { gap: 10px; }
    .project-entry { grid-template-columns: minmax(0, 1fr); gap: 20px; padding: 27px 0 34px; }
    .project-entry h3 { font-size: 45px; }
    .project-preview { margin-top: 0; width: calc(100% - 8px); }
    .project-preview img { aspect-ratio: 1.8; }
    .update-entry { grid-template-columns: minmax(0, 1fr); gap: 9px; }
    .index-footer { column-gap: 16px; padding-bottom: 100px; }
    .footer-name { width: 100%; }
    .index-home::after { right: -780px; bottom: -650px; }
  }
  @media (max-width: 370px) {
    .index-home { padding-inline: 18px; }
    .index-home h1 { font-size: 66px; }
    .circle-nav { gap: 8px; }
    .circle { width: 79px; height: 79px; }
    .circle-projects { width: 88px; height: 88px; }
  }
</style>

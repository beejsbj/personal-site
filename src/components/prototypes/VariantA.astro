---
import type { PrototypeData } from './types';
const { projects, updates, site } = Astro.props as PrototypeData;
---

<div class="open-home">
  <div class="edge-circle" aria-hidden="true"></div>
  <header>
    <a href="/?variant=A" class="home-link" aria-current="page">Home</a>
    <nav aria-label="Main navigation">
      <a href="/about">About</a><a href="/projects">Projects</a>
      <a href="/lab">Lab</a><a href={site.writingUrl}>Writing ↗</a>
    </nav>
    <a href={`mailto:${site.email}`} class="say-hello">Say hello ↗</a>
  </header>

  <section class="hello" aria-labelledby="a-title">
    <div class="hello-copy">
      <p class="greeting">Hey there!</p>
      <h1 id="a-title">Burooj here<span>!</span></h1>
      <p class="occupation">Web Dev/signer</p>
      <p class="welcome">Welcome to my home on the internet.<br />Feel free to look around!</p>
      <div class="socials">
        {site.social.filter(link => ['GitHub', 'LinkedIn', 'Email'].includes(link.label)).map(link => <a href={link.href}>{link.label} ↗</a>)}
        <a href="/resume">Resume ↗</a>
      </div>
    </div>
    <figure>
      <img src="/images/burooj4.jpg" alt="Burooj Rashid wearing round sunglasses" width="1080" height="1920" />
      <figcaption>That's me. <a href="/about">A little more about me ↗</a></figcaption>
    </figure>
  </section>

  <div class="turn" aria-hidden="true"><svg viewBox="0 0 270 70" fill="none"><path d="M3 1C75 2 80 64 150 48S227 18 262 54" stroke="currentColor" stroke-width="2"/><path d="m251 49 13 7-2-14" stroke="currentColor" stroke-width="2"/></svg></div>
  <div class="below">
    <section class="projects" aria-labelledby="a-projects">
      <div class="section-heading"><h2 id="a-projects">Some things I've built</h2><a href="/projects">All projects ↗</a></div>
      {projects.map(project => <article>
        <a href={project.href} class="project-image" tabindex="-1" aria-hidden="true"><img src={project.cover} alt="" loading="lazy" /></a>
        <div class="project-copy">
          <p class="meta">{project.dateLabel} · {project.role}</p>
          <h3><a href={project.href}>{project.title} <span aria-hidden="true">↗</span></a></h3>
          <p>{project.summary}</p>
          <p class="tools">{project.tools.slice(0, 3).join(' / ')}</p>
        </div>
      </article>)}
    </section>
    <aside aria-label="Current work and updates">
      <section class="currently" aria-labelledby="a-currently">
        <h2 id="a-currently">Currently</h2>
        <p>I’m maintaining <strong>bjslab</strong>, my home-lab environment for the tools and services I use.</p>
        <a href="/about">More about me ↗</a>
      </section>
      <section class="updates" aria-labelledby="a-updates">
        <h2 id="a-updates">Recent updates</h2>
        {updates.map(update => <article>
          <time datetime={update.date}>{update.dateLabel}</time>
          <h3><a href={update.href}>{update.title} ↗</a></h3>
          <p>{update.summary}</p>
        </article>)}
      </section>
    </aside>
  </div>

  <section class="elsewhere" aria-label="Elsewhere on the site">
    <div><h2><a href="/lab">In the lab ↗</a></h2><p>Experiments, prototypes, and smaller things.</p></div>
    <div><h2><a href={site.writingUrl}>Writing ↗</a></h2><p>My notes and writing on Substack.</p></div>
  </section>
  <footer><span>Burooj Rashid</span><a href={`mailto:${site.email}`}>{site.email} ↗</a><span>Thanks for stopping by.</span></footer>
</div>

<style>
.open-home { --wine:#7c2621; --paper:#d9d7d0; --peach:#e5b483; --ink:#302320; --rule:#bcb2a9; position:relative; isolation:isolate; overflow:clip; background:var(--paper); color:var(--ink); font:16px/1.6 'Lato',sans-serif; padding:25px max(40px,calc((100vw - 1140px)/2)) 140px; }
.edge-circle { position:absolute; z-index:-1; top:-170px; left:-305px; width:430px; height:540px; border-radius:50%; background:var(--wine); }
h1,h2,h3,p,figure { margin:0; } h1,h2,h3 { font-family:'Newsreader Variable',serif; color:var(--wine); font-weight:600; }
a { color:var(--wine); text-decoration:none; text-underline-offset:5px; } a:hover { text-decoration:underline; } a:focus-visible { outline:2px solid var(--wine); outline-offset:6px; }
header { display:flex; align-items:center; gap:25px; padding:0 0 25px; }
.home-link { font-size:19px; font-weight:700; margin-right:auto; }
nav { display:flex; gap:12px; align-items:center; }
nav a { display:grid; place-items:center; width:75px; height:75px; background:var(--peach); border-radius:50%; font-size:14px; }
nav a:nth-child(2) { background:var(--wine); color:var(--paper); width:88px; height:88px; }
nav a:nth-child(3) { width:59px; height:59px; }
nav a:hover { background:#edc39d; color:var(--wine); }
.say-hello { font-size:14px; }
.hello { display:grid; grid-template-columns:minmax(0,1fr) 220px; gap:35px; align-items:center; padding:58px 0 8px; }
.greeting { font-size:34px; font-weight:400; line-height:1.2; }
h1 { font-size:clamp(65px,8.5vw,120px); letter-spacing:-.048em; font-weight:700; line-height:1; margin:26px 0 10px; }
.occupation { font-size:32px; font-weight:300; color:var(--wine); }
.welcome { font-size:18px; margin-top:23px; }
.socials { display:flex; flex-wrap:wrap; gap:22px; margin-top:22px; }
.socials a { font-size:14px; border-bottom:1px solid #7c26214a; }
figure { padding-top:45px; }
figure img { width:100%; height:250px; display:block; object-fit:cover; object-position:50% 33%; border-radius:50% 50% 46% 54%; border:9px solid var(--peach); transform:rotate(4deg); }
figcaption { font-size:13px; margin-top:20px; text-align:center; color:#65534b; } figcaption a { display:block; }
.turn { height:85px; width:220px; color:var(--wine); margin:12px 0 10px; } .turn svg { width:100%; height:100%; }
.below { display:grid; grid-template-columns:minmax(0,1fr) 270px; gap:55px; border-top:1px solid var(--rule); padding-top:33px; }
h2 { font-size:32px; line-height:1.15; letter-spacing:-.03em; }
.section-heading { display:flex; gap:20px; justify-content:space-between; align-items:baseline; margin-bottom:25px; } .section-heading > a { font-size:14px; white-space:nowrap; }
.projects article { display:grid; grid-template-columns:190px minmax(0,1fr); gap:25px; border-top:1px solid var(--rule); padding:27px 0; }
.project-image { align-self:start; padding:12px; background:repeating-linear-gradient(130deg,transparent 0 3px,#7c262115 3px 4px); }
.project-image img { display:block; width:100%; aspect-ratio:1.4; object-fit:contain; }
.meta,.tools { font-size:13px; color:#65534b; } h3 { font-size:27px; line-height:1.15; letter-spacing:-.02em; margin:6px 0 10px; }
.project-copy > p:not(.meta):not(.tools) { font-size:15px; line-height:1.55; } .tools { margin-top:12px; }
.currently { padding:23px; background:#e5b48373; border-radius:0 45px 0 0; } .currently p { margin:13px 0; font-size:15px; } .currently > a { font-size:14px; }
.updates { padding-top:27px; } .updates h2 { font-size:29px; } .updates article { border-top:1px solid var(--rule); padding:20px 0; } .updates article:first-of-type { margin-top:18px; }
time { font-size:13px; color:#65534b; } .updates h3 { font:700 16px/1.4 'Lato',sans-serif; margin:6px 0 8px; } .updates p { font-size:14px; }
.elsewhere { display:grid; grid-template-columns:1fr 1fr; gap:40px; border-top:1px solid var(--rule); padding:40px 0; margin-top:30px; }
.elsewhere p { margin-top:12px; color:#65534b; }
footer { border-top:1px solid var(--rule); padding-top:25px; display:flex; flex-wrap:wrap; gap:20px; font-size:14px; } footer span:last-child { margin-left:auto; }
@media(max-width:1000px) { .edge-circle { left:-365px; } .hello { grid-template-columns:minmax(0,1fr) 175px; } figure img { height:205px; } .below { gap:30px; grid-template-columns:minmax(0,1fr) 240px; } .projects article { grid-template-columns:1fr; } .project-image { max-width:300px; } }
@media(max-width:650px) { .open-home { padding:25px 20px 130px; } .edge-circle { top:-160px; left:-380px; height:330px; } header { flex-wrap:wrap; gap:20px; padding:0 0 15px; } .home-link { margin-left:55px; } .say-hello { display:none; } nav { margin-left:auto; gap:10px; } nav a { width:62px;height:62px;font-size:13px;white-space:nowrap; } nav a:nth-child(2) { width:72px;height:72px; } .hello { grid-template-columns:1fr; padding-top:35px; gap:20px; } .greeting { font-size:27px; } h1 { font-size:clamp(54px,14vw,88px); margin-top:19px; } .occupation { font-size:27px; } figure { display:flex; align-items:center; gap:25px; padding-top:10px; } figure img { width:132px; height:145px; border-width:6px; flex-shrink:0; } figcaption { text-align:left; margin:0; } .turn { height:65px; margin-top:0; } .below { grid-template-columns:1fr; } .section-heading { flex-wrap:wrap; gap:10px; } .project-image { max-width:none; } .project-image img { height:190px; } .projects article { gap:15px; } .elsewhere { grid-template-columns:1fr; gap:28px; } footer span:last-child { margin-left:0; } }
</style>

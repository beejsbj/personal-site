---
import type { PrototypeData } from './types';
const { projects, updates, site } = Astro.props as PrototypeData;
---

<div class="open-home">
  <header>
    <a href="/?variant=A" class="home-link" aria-current="page">Home</a>
    <nav aria-label="Main navigation">
      <a href="/about">About</a><a href="/projects">Projects</a>
      <a href="/lab">Lab</a><a href={site.writingUrl}>Writing ↗</a>
    </nav>
    <a href={`mailto:${site.email}`} class="say-hello">Say hello ↗</a>
  </header>

  <section class="hello" aria-labelledby="a-title">
    <div class="hello-copy">
      <p class="greeting">Hey there!</p>
      <h1 id="a-title">Burooj here<span>!</span></h1>
      <p class="occupation"><span aria-hidden="true">{'{'}</span> Web Dev/signer <span aria-hidden="true">{'}'}</span></p>
      <p class="welcome">Welcome to my home on the internet.<br />Feel free to look around!</p>
      <div class="socials">
        {site.social.filter(link => ['GitHub', 'LinkedIn', 'Email'].includes(link.label)).map(link => <a href={link.href}>{link.label} ↗</a>)}
        <a href="/resume">Resume ↗</a>
      </div>
    </div>
    <figure>
      <img src="/images/burooj4.jpg" alt="Burooj Rashid wearing round sunglasses" width="1080" height="1920" />
      <figcaption>That's me. <a href="/about">A little more about me ↗</a></figcaption>
    </figure>
  </section>

  <div class="below">
    <section class="projects" aria-labelledby="a-projects">
      <div class="section-heading"><h2 id="a-projects">Some things I've built</h2><a href="/projects">All projects ↗</a></div>
      {projects.map(project => <article>
        <a href={project.href} class="project-image" tabindex="-1" aria-hidden="true"><img src={project.cover} alt="" loading="lazy" /></a>
        <div class="project-copy">
          <p class="meta">{project.dateLabel} · {project.role}</p>
          <h3><a href={project.href}>{project.title} <span aria-hidden="true">↗</span></a></h3>
          <p>{project.summary}</p>
          <p class="tools">{project.tools.slice(0, 3).join(' / ')}</p>
        </div>
      </article>)}
    </section>
    <aside aria-label="Current work and updates">
      <section class="currently" aria-labelledby="a-currently">
        <h2 id="a-currently"><span aria-hidden="true">{'{'}</span> Currently <span aria-hidden="true">{'}'}</span></h2>
        <p>I’m maintaining <strong>bjslab</strong>, my home-lab environment for the tools and services I use.</p>
        <a href="/about">More about me ↗</a>
      </section>
      <section class="updates" aria-labelledby="a-updates">
        <h2 id="a-updates">Recent updates</h2>
        {updates.map(update => <article>
          <time datetime={update.date}>{update.dateLabel}</time>
          <h3><a href={update.href}>{update.title} ↗</a></h3>
          <p>{update.summary}</p>
        </article>)}
      </section>
    </aside>
  </div>

  <section class="elsewhere" aria-label="Elsewhere on the site">
    <div><h2><a href="/lab">In the lab ↗</a></h2><p>Experiments, prototypes, and smaller things.</p></div>
    <div><h2><a href={site.writingUrl}>Writing ↗</a></h2><p>My notes and writing on Substack.</p></div>
  </section>
  <footer><span>Burooj Rashid</span><a href={`mailto:${site.email}`}>{site.email} ↗</a><span>Thanks for stopping by.</span></footer>
</div>

<style>
  .open-home { max-width: 1160px; padding: 0 36px 130px; margin: auto; color: #171c18; font: 16px/1.6 system-ui, sans-serif; }
  a { color: #087443; text-decoration: none; text-underline-offset: 5px; }
  a:hover { text-decoration: underline; }
  a:focus-visible { outline: 2px solid #087443; outline-offset: 5px; }
  p, h1, h2, h3, figure { margin: 0; }
  header { display: flex; align-items: center; gap: 26px; padding: 38px 0; }
  header a { padding-block: 6px; }
  nav { display: flex; flex-wrap: wrap; gap: 26px; }
  .home-link { font-weight: 700; text-decoration: underline; }
  .say-hello { margin-left: auto; }
  .hello { display: grid; grid-template-columns: 1fr 245px; gap: 65px; align-items: center; padding: 76px 0 82px; }
  .greeting { font-size: 25px; font-weight: 650; }
  h1 { font-size: clamp(48px, 7.8vw, 94px); letter-spacing: -.045em; line-height: 1.1; margin: 13px 0 17px; font-weight: 750; }
  h1 span { color: #087443; }
  .occupation { font-size: 23px; letter-spacing: -.04em; }
  .occupation span { color: #087443; padding-inline: 3px; }
  .welcome { margin-top: 21px; font-size: 18px; }
  .socials { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 25px; font-size: 14px; }
  figure img { display: block; width: 100%; height: 295px; object-fit: cover; object-position: 50% 38%; }
  figcaption { margin-top: 13px; font-size: 13px; color: #5b635d; }
  figcaption a { display: block; }
  .below { display: grid; grid-template-columns: minmax(0, 1fr) 265px; gap: 60px; border-top: 1px solid #d5ded7; padding-top: 38px; }
  .section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 15px; margin-bottom: 25px; }
  h2 { font-size: 22px; line-height: 1.25; letter-spacing: -.035em; }
  .section-heading > a { font-size: 14px; white-space: nowrap; }
  .projects article { margin-bottom: 40px; }
  .project-image { display: block; background: #f3f6f3; padding: 25px; }
  .project-image img { display: block; width: 100%; height: 235px; object-fit: contain; }
  .project-copy { padding-top: 17px; }
  .meta, .tools { font-size: 13px; color: #5b635d; }
  h3 { font-size: 22px; letter-spacing: -.03em; line-height: 1.3; margin: 6px 0 9px; }
  .project-copy h3 a { color: #171c18; }
  .project-copy h3 span { color: #087443; }
  .project-copy > p:not(.meta):not(.tools) { color: #454e48; }
  .tools { margin-top: 12px; }
  .currently { padding: 0 0 30px; }
  .currently h2 span { color: #087443; font-weight: 400; }
  .currently p { margin: 20px 0 13px; }
  .currently > a { font-size: 14px; }
  .updates { border-top: 1px solid #d5ded7; padding-top: 27px; }
  .updates article { margin-top: 26px; }
  time { font-size: 13px; color: #5b635d; }
  .updates h3 { font-size: 16px; line-height: 1.5; letter-spacing: -.01em; }
  .updates p { font-size: 14px; color: #454e48; }
  .elsewhere { border-top: 1px solid #d5ded7; padding: 30px 0; display: grid; grid-template-columns: 1fr 1fr; gap: 30px; }
  .elsewhere p { margin-top: 10px; color: #5b635d; }
  footer { display: flex; flex-wrap: wrap; gap: 24px; border-top: 1px solid #d5ded7; padding-top: 25px; color: #5b635d; font-size: 14px; }
  footer span:last-child { margin-left: auto; }
  @media(max-width: 900px) { .hello { gap: 30px; grid-template-columns: 1fr 200px; } .below { gap: 30px; grid-template-columns: minmax(0, 1fr) 235px; } h1 { font-size: 65px; } }
  @media(max-width: 650px) {
    .open-home { padding-inline: 22px; } header { flex-wrap: wrap; gap: 18px; padding: 25px 0; } nav { gap: 17px; } .say-hello { display: none; }
    .hello { grid-template-columns: 1fr; padding: 35px 0 40px; gap: 30px; } h1 { font-size: clamp(47px, 12.5vw, 72px); } .greeting { font-size: 21px; }
    figure { display: flex; align-items: end; gap: 20px; } figure img { width: 130px; height: 155px; } figcaption { max-width: 150px; padding-bottom: 5px; }
    .below { grid-template-columns: 1fr; } aside { border-top: 1px solid #d5ded7; padding-top: 30px; } .project-image { padding: 15px; } .project-image img { height: 190px; }
    .section-heading { flex-wrap: wrap; } .elsewhere { margin-top: 35px; grid-template-columns: 1fr; } footer span:last-child { margin-left: 0; }
  }
</style>

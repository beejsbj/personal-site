---
/** A project told as a journey: an ordered thread of dated beats, each led
 * by one line and followed by its evidence (pictures, a film, the owner's
 * own words, the decisions that turned). Daylight draws the thread; the
 * same markup, unstyled, is appended to the project's body in
 * /prism/content.json, so every lens tells the same journey in its own
 * prose. Keep it semantic: lenses only get the elements, not this style. */
import type { JourneyData } from "../content.config";
import Inline from "../design/primitives/Inline.astro";
import { plainInline } from "../lib/inline";
import { phoneCopy } from "../lib/journey";

interface Props {
  journey: JourneyData;
  /** Screen-reader words for a turn (what it was, what it became), the
   * enlarged picture's close button (src/lib/lightbox.ts) and a pile's turn
   * buttons. */
  labels: { was: string; now: string; close: string; previous: string; next: string };
  /** Daylight deals a strip of slides into a pile you turn; a lens gets the
   * plain strip markup to set in its own way. Pictures enlarge everywhere. */
  interactive?: boolean;
}

const { journey, labels, interactive = true } = Astro.props;

type Media = JourneyData["beats"][number]["media"][number];
type Layout = JourneyData["beats"][number]["layout"];
/** How wide each layout shows a frame, for the browser to pick a file. */
const SIZES: Record<Layout | "full", string> = {
  wide: "(min-width: 62.5rem) 60rem, 92vw",
  full: "(min-width: 62.5rem) 60rem, 92vw",
  pair: "(min-width: 40.6rem) 30rem, 92vw",
  strip: "(min-width: 40.6rem) 34rem, 60vw",
  sheet: "(min-width: 40.6rem) 12rem, 45vw",
};
/** A raster wider than 1000px has a phone-sized copy beside it. */
const sources = (item: Media, layout: Layout) => {
  const srcset = phoneCopy(item.src, item.width);
  return srcset ? { srcset, sizes: SIZES[item.full ? "full" : layout] } : {};
};
---

<section
  class:list={["journey", { "journey--open": journey.open }]}
  aria-label={journey.label}
  data-close-label={labels.close}
  data-previous-label={labels.previous}
  data-next-label={labels.next}
>
  <ol class="journey__thread">
    {journey.beats.map((beat) => (
      <li class:list={["journey__beat", `journey__beat--${beat.layout}`]}>
        <p class="journey__when">
          {beat.date ? <time datetime={beat.date}>{beat.when}</time> : beat.when}
        </p>
        <div class="journey__body">
          <h2 class="journey__line"><Inline text={beat.line} links="plain" /></h2>
          {beat.note && <p class="journey__note"><Inline text={beat.note} links="plain" /></p>}
          {beat.quotes.length > 0 && (
            <div class="journey__quotes">
              {beat.quotes.map((quote) => (
                <figure class="journey__quote">
                  <blockquote><p>{quote.text}</p></blockquote>
                  <figcaption>{quote.when}</figcaption>
                </figure>
              ))}
            </div>
          )}
          {beat.code && (
            <figure class="journey__code">
              <pre><code>{beat.code.text.trimEnd()}</code></pre>
              <figcaption><Inline text={beat.code.caption} links="plain" /></figcaption>
            </figure>
          )}
          {beat.media.length > 0 && (
            <div
              class:list={["journey__media", `journey__media--${beat.layout}`]}
              {...(beat.layout === "strip"
                ? {
                    tabindex: 0,
                    role: "group",
                    "aria-label": plainInline(beat.line),
                    ...(interactive ? { "data-pile": "" } : {}),
                  }
                : {})}
            >
              {beat.media.map((item) => (
                <figure class:list={["journey__figure", { "journey__figure--full": item.full }]}>
                  {item.type === "video" ? (
                    <video
                      controls
                      muted
                      playsinline
                      preload="none"
                      poster={item.poster}
                      width={item.width}
                      height={item.height}
                      aria-label={item.alt}
                    >
                      <source src={item.src} type="video/mp4" />
                    </video>
                  ) : (
                    <a class="journey__zoom" href={item.src}>
                      <img
                        src={item.src}
                        {...sources(item, beat.layout)}
                        alt={item.alt}
                        width={item.width}
                        height={item.height}
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                  )}
                  {item.caption && <figcaption><Inline text={item.caption} links="plain" /></figcaption>}
                </figure>
              ))}
            </div>
          )}
          {beat.turns.length > 0 && (
            <ul class="journey__turns">
              {beat.turns.map((turn) => (
                <li class="journey__turn">
                  <span class="journey__turn-when">{turn.when}</span>
                  <del><span class="visually-hidden">{labels.was} </span>{turn.from}</del>
                  <ins><span class="visually-hidden">{labels.now} </span>{turn.to}</ins>
                </li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))}
  </ol>
  {journey.open && (
    <div class="journey__open">
      <p class="journey__line journey__line--open"><Inline text={journey.open.line} links="plain" /></p>
      {journey.open.note && <p class="journey__note"><Inline text={journey.open.note} links="plain" /></p>}
    </div>
  )}
</section>

<script>
  /* A strip of slides is dealt into a pile, squared on the table: the top
     slide large, the next ones' edges showing beneath. Next tosses the top
     slide aside and tucks it under; previous brings the last one back. The
     buttons, the arrow keys and a sideways swipe all turn it, and the top
     slide still opens full size. Without script it stays a strip. */
  const SHOWN = 4; // slides whose edges show; the rest wait out of sight

  function deal(pile: HTMLElement) {
    if (pile.dataset.dealt !== undefined) return;
    const host = pile.closest<HTMLElement>(".journey");
    const words = { previous: host?.dataset.previousLabel, next: host?.dataset.nextLabel };
    const cards = [...pile.querySelectorAll<HTMLElement>(":scope > .journey__figure")];
    if (!words.previous || !words.next || cards.length < 2) return;
    pile.dataset.dealt = "";

    const controls = document.createElement("div");
    controls.className = "journey-pile__controls";
    const button = (glyph: string, label: string) => {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "journey-pile__turn";
      b.setAttribute("aria-label", label);
      const g = document.createElement("span");
      g.setAttribute("aria-hidden", "true");
      g.textContent = glyph;
      b.append(g);
      return b;
    };
    const previous = button("‹", words.previous);
    const next = button("›", words.next);
    const count = document.createElement("span");
    count.className = "journey-pile__count";
    count.setAttribute("aria-live", "polite");
    const caption = document.createElement("p");
    caption.className = "journey-pile__caption";
    caption.setAttribute("aria-hidden", "true");
    controls.append(previous, count, next, caption);
    pile.after(controls);

    let top = 0;
    const lay = () => {
      cards.forEach((card, index) => {
        const depth = (index - top + cards.length) % cards.length;
        card.style.setProperty("--depth", String(depth));
        card.dataset.depth = depth < SHOWN ? String(depth) : "under";
        card.inert = depth !== 0;
      });
      count.textContent = `${top + 1} / ${cards.length}`;
      caption.textContent = cards[top].querySelector("figcaption")?.textContent?.trim() ?? "";
    };
    lay();

    const still = matchMedia("(prefers-reduced-motion: reduce)");
    // the end of a card's move: its transition, or a beat later if none runs
    const settle = (card: HTMLElement, done: () => void) => {
      let over = false;
      const finish = () => {
        if (over) return;
        over = true;
        done();
      };
      card.addEventListener("transitionend", finish, { once: true });
      setTimeout(finish, 900);
    };
    const frame = (fn: () => void) => requestAnimationFrame(() => requestAnimationFrame(fn));
    const turn = (step: 1 | -1) => {
      const n = cards.length;
      if (still.matches) {
        top = (top + step + n) % n;
        lay();
        return;
      }
      if (pile.dataset.turning !== undefined) return;
      pile.dataset.turning = "";
      if (step === 1) {
        const leaving = cards[top];
        leaving.classList.add("is-tossed");
        settle(leaving, () => {
          leaving.classList.add("is-placed");
          leaving.classList.remove("is-tossed");
          top = (top + 1) % n;
          lay();
          frame(() => {
            leaving.classList.remove("is-placed");
            delete pile.dataset.turning;
          });
        });
      } else {
        const arriving = cards[(top - 1 + n) % n];
        arriving.classList.add("is-placed", "is-tossed");
        top = (top - 1 + n) % n;
        lay();
        frame(() => {
          arriving.classList.remove("is-placed", "is-tossed");
          settle(arriving, () => delete pile.dataset.turning);
        });
      }
    };
    previous.addEventListener("click", () => turn(-1));
    next.addEventListener("click", () => turn(1));
    pile.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") turn(1);
      else if (event.key === "ArrowLeft") turn(-1);
      else return;
      event.preventDefault();
    });
    // a sideways swipe turns it; the lightbox ignores the click that ends it
    let from: number | undefined;
    // a slide is not dragged off as a file: the gesture belongs to the pile
    pile.addEventListener("dragstart", (event) => event.preventDefault());
    pile.addEventListener("pointerdown", (event) => {
      from = event.clientX;
    });
    pile.addEventListener("pointerup", (event) => {
      if (from === undefined) return;
      const moved = event.clientX - from;
      from = undefined;
      if (Math.abs(moved) < 40) return;
      pile.dataset.swiping = "";
      setTimeout(() => delete pile.dataset.swiping, 0);
      turn(moved < 0 ? 1 : -1);
    });
  }

  document.addEventListener("astro:page-load", () => {
    for (const pile of document.querySelectorAll<HTMLElement>(".journey__media[data-pile]")) deal(pile);
  });
</script>

<style>
  /* The thread: a hairline down the left, a dot and a date at each beat.
     Past beats are filled; the open end is a ring on a dashed line that
     fades out instead of stopping, because the work hasn't. */
  .journey {
    --gutter: calc(var(--journey-rail) * 2 + var(--space-xl));
    /* the first line of the date, whose middle the dot sits on */
    --mark-middle: calc(var(--text-sm) * var(--leading-tight) / 2);
    margin-top: var(--space-3xl);
  }
  .journey__thread {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .journey__beat {
    position: relative;
    display: grid;
    gap: var(--space-s);
    padding: 0 0 var(--space-4xl) var(--gutter);
  }
  /* the hairline, beat by beat, from this dot to the next */
  .journey__beat::before {
    content: "";
    position: absolute;
    top: var(--mark-middle);
    bottom: calc(-1 * var(--mark-middle));
    left: var(--journey-rail);
    border-left: var(--rule-width) solid var(--color-border);
  }
  .journey:not(.journey--open) .journey__beat:last-child::before {
    display: none;
  }
  /* into an open end, the last stretch reaches that end's ring */
  .journey--open .journey__beat:last-child::before {
    bottom: calc(-1 * var(--text-post) * var(--leading-heading) / 2);
  }
  .journey__beat::after,
  .journey__open::after {
    content: "";
    position: absolute;
    top: calc(var(--mark-middle) - var(--journey-dot) / 2);
    left: calc(var(--journey-rail) - var(--journey-dot) / 2 + var(--rule-width) / 2);
    width: var(--journey-dot);
    height: var(--journey-dot);
    border-radius: var(--radius-round);
    background: var(--color-accent);
  }
  .journey__when {
    color: var(--color-text-soft);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    line-height: var(--leading-tight);
  }
  .journey__body {
    display: grid;
    gap: var(--space-m);
    min-width: 0;
  }
  .journey__line {
    max-width: var(--journey-line-measure);
    margin: 0;
    font-size: var(--text-post);
    line-height: var(--leading-heading);
    text-wrap: balance;
  }
  .journey__note {
    max-width: var(--intro-width);
    font-size: var(--text-lead);
    text-wrap: pretty;
  }
  .journey__media {
    display: grid;
    gap: var(--space-m);
    margin-top: var(--space-xs);
  }
  .journey__figure {
    display: grid;
    align-content: start;
    min-width: 0;
  }
  .journey__figure :is(img, video) {
    width: 100%;
    height: auto;
    background: var(--color-surface);
    border: var(--rule-width) solid var(--color-border);
  }
  .journey__figure figcaption {
    max-width: 48ch;
  }
  /* one wide frame, or a full-row one: whole, never past one screen */
  :is(.journey__media--wide, .journey__figure--full) :is(img, video) {
    width: auto;
    max-width: 100%;
    max-height: var(--journey-frame-max);
  }
  .journey__figure--full {
    grid-column: 1 / -1;
  }
  /* a contact sheet: many small frames on a light table, each shown
     whole (posters, menus and drawings must not be cropped) */
  .journey__media--sheet {
    grid-template-columns: repeat(
      auto-fill,
      minmax(min(100%, var(--journey-sheet-min)), 1fr)
    );
    gap: var(--space-l) var(--space-m);
  }
  .journey__media--sheet .journey__figure:not(.journey__figure--full) :is(img, video) {
    aspect-ratio: 4 / 3;
    object-fit: contain;
    padding: var(--space-2xs);
  }
  /* a strip: a filmstrip of frames at one height, each at its own width,
     scrolled sideways in order; a caption wraps to its frame */
  .journey__media--strip {
    grid-auto-flow: column;
    grid-auto-columns: max-content;
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    padding-bottom: var(--space-s);
  }
  .journey__media--strip .journey__figure {
    width: min-content;
    scroll-snap-align: start;
  }
  .journey__media--strip .journey__figure :is(img, video) {
    width: auto;
    max-width: none;
    height: var(--journey-strip-height);
  }
  /* dealt into a pile (script): every slide in one cell, offset by its depth,
     the ones beneath each keeping their own slight skew, like printed slides
     squared on a table */
  .journey__media--strip[data-dealt] {
    grid-template-areas: "pile";
    grid-auto-flow: row;
    grid-auto-columns: auto;
    width: min(100%, var(--journey-pile-width));
    padding: 0 var(--journey-pile-room) var(--journey-pile-room) 0;
    overflow: visible;
    touch-action: pan-y;
    cursor: grab;
  }
  .journey__media--strip[data-dealt] .journey__figure {
    /* the script sets each slide's depth in the pile; 0 is the top */
    --depth: 0;
    --skew: var(--journey-pile-skew-a);
    grid-area: pile;
    width: auto;
    z-index: calc(var(--journey-pile-shown) - var(--depth));
    translate: calc(var(--depth) * var(--journey-pile-step))
      calc(var(--depth) * var(--journey-pile-step));
    rotate: calc(var(--skew) * min(var(--depth), 1));
    transition:
      translate var(--duration-reveal) var(--ease-settle),
      rotate var(--duration-reveal) var(--ease-settle),
      opacity var(--duration-reveal) var(--ease-settle);
  }
  .journey__media--strip[data-dealt] .journey__figure:nth-child(4n + 2) {
    --skew: var(--journey-pile-skew-b);
  }
  .journey__media--strip[data-dealt] .journey__figure:nth-child(4n + 3) {
    --skew: var(--journey-pile-skew-c);
  }
  .journey__media--strip[data-dealt] .journey__figure:nth-child(4n) {
    --skew: var(--journey-pile-skew-d);
  }
  .journey__media--strip[data-dealt] .journey__figure[data-depth="under"] {
    opacity: 0;
  }
  .journey__media--strip[data-dealt] .journey__figure.is-tossed {
    translate: var(--journey-pile-toss-x) var(--journey-pile-toss-y);
    rotate: var(--journey-pile-toss-turn);
    opacity: 0;
  }
  .journey__media--strip[data-dealt] .journey__figure.is-placed {
    transition: none;
  }
  .journey__media--strip[data-dealt] .journey__figure :is(img, video) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: contain;
    background: var(--color-page);
  }
  .journey__media--strip[data-dealt] figcaption {
    position: absolute;
    width: var(--rule-width);
    height: var(--rule-width);
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  /* the pile's own row: turn back, where you are, turn on, what it shows */
  .journey__media + :global(.journey-pile__controls) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-m);
    max-width: var(--journey-pile-width);
  }
  :global(.journey-pile__turn) {
    display: grid;
    place-items: center;
    width: var(--control-min-height);
    height: var(--control-min-height);
    padding: 0;
    border: 0;
    border-radius: var(--radius-round);
    background: var(--ball-fill);
    color: var(--ball-ink);
    font: var(--weight-bold) var(--text-lead) / 1 var(--font-serif);
    cursor: pointer;
    transition: background var(--duration-hover) var(--ease-settle);
  }
  :global(.journey-pile__turn:hover) {
    background: var(--ball-fill-hover);
  }
  :global(.journey-pile__turn:focus-visible) {
    outline: var(--focus-width) solid var(--color-accent);
    outline-offset: var(--focus-offset);
  }
  :global(.journey-pile__count) {
    min-width: 3.5ch;
    color: var(--color-text-soft);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    text-align: center;
  }
  :global(.journey-pile__caption) {
    flex: 1 1 var(--journey-pile-caption-min);
    margin: 0;
    color: var(--color-text-soft);
    font-size: var(--text-xs);
  }
  @media (prefers-reduced-motion: reduce) {
    .journey__media--strip[data-dealt] .journey__figure {
      transition: none;
    }
  }
  /* every picture opens full size */
  .journey__zoom {
    display: block;
    cursor: zoom-in;
  }
  /* the code behind the work, verbatim */
  .journey__code {
    display: grid;
    max-width: var(--title-width);
    margin-top: var(--space-xs);
  }
  .journey__code pre {
    max-width: 100%;
    overflow-x: auto;
    padding: var(--space-m);
    background: var(--color-surface);
    border-left: var(--focus-width) solid var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
  }
  /* the owner's words lead each beat: the thought, then the work it made */
  .journey__quotes {
    display: grid;
    gap: var(--space-l);
    max-width: var(--title-width);
  }
  .journey__quote blockquote {
    padding-left: var(--space-m);
    border-left: var(--focus-width) solid var(--color-surface-strong);
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: var(--text-card);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-heading);
    text-wrap: pretty;
  }
  .journey__quote figcaption {
    padding: var(--space-2xs) 0 0 var(--space-m);
  }
  /* turns: what it was, struck through; what it became, beside it */
  .journey__turns {
    list-style: none;
    display: grid;
    gap: var(--space-s);
    max-width: var(--title-width);
    margin: var(--space-s) 0 0;
    padding: 0;
  }
  .journey__turn {
    display: grid;
    grid-template-columns: var(--journey-when-width) minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-m);
    align-items: baseline;
    padding-top: var(--space-s);
    border-top: var(--rule-width) solid var(--color-border);
  }
  .journey__turn-when {
    color: var(--color-text-soft);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }
  .journey__turn del {
    color: var(--color-text-soft);
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: var(--rule-width);
  }
  .journey__turn ins {
    text-decoration: none;
  }
  /* the end that isn't one */
  .journey__open {
    position: relative;
    display: grid;
    gap: var(--space-s);
    padding: 0 0 var(--space-4xl) var(--gutter);
    --mark-middle: calc(var(--text-post) * var(--leading-heading) / 2);
  }
  .journey__open::before {
    content: "";
    position: absolute;
    top: var(--mark-middle);
    bottom: 0;
    left: var(--journey-rail);
    border-left: var(--rule-width) dashed var(--color-accent);
    mask-image: linear-gradient(to bottom, var(--color-accent) 35%, transparent);
  }
  .journey__open::after {
    border: var(--focus-width) solid var(--color-accent);
    background: var(--color-page);
  }
  .journey__line--open {
    color: var(--color-accent);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-heading);
  }

  /* Wide screens: the date takes its own column left of the thread and
     lines up with the middle of the beat's first line. */
  @media (min-width: 62.501rem) {
    .journey {
      --journey-rail: calc(var(--journey-when-width) + var(--space-l));
      --mark-middle: calc(var(--text-post) * var(--leading-heading) / 2);
    }
    .journey__when {
      position: absolute;
      top: calc(var(--mark-middle) - var(--text-sm) * var(--leading-tight) / 2);
      left: 0;
      width: var(--journey-when-width);
      text-align: right;
    }
  }
  @media (min-width: 40.626rem) {
    .journey__media--pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 40.625rem) {
    .journey__beat {
      padding-bottom: var(--space-3xl);
    }
    /* the owner's words stay large, but not six lines a sentence */
    .journey__quote blockquote {
      font-size: var(--text-lead);
      line-height: var(--leading-body);
    }
    /* two frames a row on a phone, so a sheet still reads as a set */
    .journey__media--sheet {
      grid-template-columns: repeat(
        auto-fill,
        minmax(min(100%, var(--journey-sheet-min-compact)), 1fr)
      );
    }
    .journey__turn {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2xs);
    }
  }
</style>

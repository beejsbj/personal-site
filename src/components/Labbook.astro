---
import Heading from "../design/primitives/Heading.astro";
import Link from "../design/primitives/Link.astro";
import Artifact from "../design/compounds/Artifact.astro";
import UpdateEntry from "../design/compounds/UpdateEntry.astro";
import {
  labbookAnchor,
  labbookMonths,
  labbookSubjects,
  monthLabel,
  narrowHref,
  relatedLinks,
  subjectsOf,
  updateDateLabel,
  type Update,
} from "../lib/labbook";
import type { getLabPage } from "../lib/portfolio";
import { part } from "../prism/parts";
/** Composition: the Labbook, the complete dated record of updates, kept as
 * a lab notebook is. Its months are chapters, newest first, each named in
 * the margin beside its entries where there is room and over them where
 * there is not; an entry's day sits in the margin, its words, its artifact
 * and what it is about to the right of the margin's rule, a redacted one
 * as its line among the rest.
 * It can be narrowed to one experiment or project and back: a link to
 * each is at its head, and the choice is the address's query
 * (`narrowHref`), read by the script below as the page is drawn, before
 * the entries are, so nothing else shows first. Without scripts the
 * Labbook is whole and offers no narrowing.
 * Each update sits in an element whose id is where a link to it would
 * land (`labbookHref`), though nothing links there unless it is written
 * to. An update with nowhere to go is text, not a link. With no updates
 * there is no section.
 */
interface Props {
  /** Every update, in any order. */
  updates: Update[];
  /** `labbook` in pages/lab.md. */
  copy: Awaited<ReturnType<typeof getLabPage>>["labbook"];
  /** How each kind and source of update is named. */
  labels: { kinds: Record<string, string>; sources: Record<string, string> };
  /** The experiments and projects an update may link to: the ones shown. */
  shown: Parameters<typeof relatedLinks>[1];
  /** Whose a Pen named by its id alone is. */
  penUser?: string;
  /** The page it is on, path and query, which its narrowing links keep. */
  at?: string;
  class?: string;
}
const {
  copy,
  labels,
  shown,
  penUser,
  at = "/lab",
  class: className,
} = Astro.props;
const months = labbookMonths(Astro.props.updates);
const subjects = labbookSubjects(Astro.props.updates, shown);
const count = (n: number) =>
  n === 1
    ? copy.narrow.count.one
    : copy.narrow.count.other.replace("{count}", String(n));
// What an entry is about, written on it for the narrowing to find.
const about = (update: Update) =>
  Object.fromEntries(
    subjectsOf(update, shown).map((subject) => [
      `data-${subject.kind}`,
      subject.slug,
    ]),
  );
---

{months.length > 0 && (
  <section
    class:list={["labbook", className]}
    id="labbook"
    aria-labelledby="labbook-title"
    data-labbook
  >
    <header class="labbook-head">
      <Heading id="labbook-title">{copy.title}</Heading>
      <p class="labbook-note">{copy.note}</p>
    </header>
    {subjects.length > 0 && (
      <nav
        class="labbook-index"
        aria-labelledby="labbook-index-label"
        data-labbook-index
        hidden
      >
        <p class="labbook-index__label" id="labbook-index-label">
          {copy.narrow.label}
        </p>
        <ul class="labbook-index__list" role="list">
          {subjects.map((subject) => (
            <li>
              <Link
                href={narrowHref(subject, at)}
                treatment="pill"
                data-no-cover=""
                data-labbook-subject=""
                data-title={subject.title}
                {...part("labbook.subject", `${subject.kind}:${subject.slug}`)}
              >
                {subject.title}{" "}
                <span class="labbook-count">
                  <span aria-hidden="true">{subject.count}</span>
                  <span class="labbook-said">, {count(subject.count)}</span>
                </span>
              </Link>
            </li>
          ))}
        </ul>
      </nav>
    )}
    <p class="labbook-narrowed" data-labbook-narrowed tabindex="-1" hidden>
      {`${copy.narrow.showing} `}
      <strong data-labbook-narrowed-to></strong>.{" "}
      <Link
        href={narrowHref(undefined, at)}
        data-no-cover=""
        data-labbook-all=""
      >
        {copy.narrow.all}
      </Link>
    </p>
    <script is:inline>
      // Narrow the Labbook to what the address names (?experiment= or
      // ?project=), before its entries are drawn: a rule hides every entry
      // about something else, and every month left empty. It runs once
      // per document; the router's swaps are narrowed by its listeners.
      (() => {
        const narrow = (section) => {
          const query = new URLSearchParams(location.search);
          const kind = ["experiment", "project"].find((k) => query.get(k));
          const want = kind && `${kind}:${query.get(kind)}`;
          const index = section.querySelector("[data-labbook-index]");
          if (index) index.hidden = false;
          const links = section.querySelectorAll("[data-labbook-subject]");
          const chosen = [...links].find((link) => link.dataset.ref === want);
          for (const link of links) {
            const on = link === chosen;
            if (on) link.setAttribute("aria-current", "true");
            else link.removeAttribute("aria-current");
            link.classList.toggle("ds-link--wine", on);
            link.classList.toggle("ds-link--paper", !on);
          }
          const status = section.querySelector("[data-labbook-narrowed]");
          let rule = section.querySelector("style[data-labbook-rule]");
          if (!rule) {
            rule = document.createElement("style");
            rule.dataset.labbookRule = "";
            section.append(rule);
          }
          if (!chosen) {
            delete section.dataset.narrowed;
            status.hidden = true;
            rule.textContent = "";
            return;
          }
          section.dataset.narrowed = want;
          status.querySelector("[data-labbook-narrowed-to]").textContent =
            chosen.dataset.title;
          status.hidden = false;
          const it = `[data-${kind}="${CSS.escape(query.get(kind))}"]`;
          rule.textContent = `#labbook[data-narrowed] .labbook-entry:not(${it}), #labbook[data-narrowed] .labbook-month:not(:has(${it})) { display: none; }`;
        };
        // Where the keyboard goes once a narrowing link has taken the
        // visitor there: to what it is narrowed to, or, coming back, to
        // the link it was narrowed by. Kept for the next page, which may
        // be a whole load (without the client router) or a swap.
        const KEY = "labbook:land";
        const land = (section) => {
          let to;
          try {
            to = sessionStorage.getItem(KEY);
            sessionStorage.removeItem(KEY);
          } catch {}
          if (!to) return;
          const target =
            to === "narrowed"
              ? section.querySelector("[data-labbook-narrowed]:not([hidden])")
              : section.querySelector(
                  `[data-labbook-subject][data-ref="${CSS.escape(to)}"]`,
                );
          target?.focus({ preventScroll: true });
        };
        const section = document.currentScript.closest("[data-labbook]");
        narrow(section);
        // On a whole load the browser goes to #labbook once the page has
        // loaded, which would undo an earlier focus; on a swap it already
        // has.
        if (document.readyState === "complete") land(section);
        else addEventListener("load", () => land(section), { once: true });
        if (window.labbookNarrow) return;
        window.labbookNarrow = narrow;
        document.addEventListener(
          "click",
          (event) => {
            const link = event.target.closest?.(
              "[data-labbook-subject], [data-labbook-all]",
            );
            if (
              !link ||
              event.button !== 0 ||
              event.metaKey ||
              event.ctrlKey ||
              event.shiftKey ||
              event.altKey
            )
              return;
            try {
              sessionStorage.setItem(
                KEY,
                link.hasAttribute("data-labbook-all")
                  ? link.closest("[data-labbook]").dataset.narrowed
                  : "narrowed",
              );
            } catch {}
          },
          { capture: true },
        );
        // The router's swap puts in the new page before its scripts run
        // again: narrow it then, so it is never seen whole first.
        document.addEventListener("astro:after-swap", () => {
          const section = document.querySelector("[data-labbook]");
          if (section) narrow(section);
        });
        // The router does not run this script again on the page it swaps
        // in (it has run it once), so the keyboard is landed here.
        document.addEventListener("astro:page-load", () => {
          const section = document.querySelector("[data-labbook]");
          if (section) land(section);
        });
      })();
    </script>
    <ol class="labbook-months" aria-label={copy.listLabel}>
      {months.map(({ month, updates }) => (
        <li class="labbook-month" data-labbook-month={month}>
          <h3
            class="labbook-month__name"
            id={`labbook-${month}`}
            {...part("labbook.month", month)}
          >
            {(() => {
              const [name, year] = monthLabel(month).split(" ");
              return (
                <>
                  <span class="labbook-month__month">{name}</span>{" "}
                  <span class="labbook-month__year">{year}</span>
                </>
              );
            })()}
          </h3>
          <ol class="labbook-list" aria-labelledby={`labbook-${month}`}>
            {updates.map((update) => (
              <li
                id={labbookAnchor(update.id)}
                class="labbook-entry"
                {...about(update)}
              >
                {update.visibility === "open" ? (
                  <UpdateEntry
                    id={update.id}
                    title={update.title}
                    summary={update.summary}
                    href={update.href}
                    kind={update.kind}
                    source={update.source}
                    date={update.date}
                    dateLabel={updateDateLabel(update.date)}
                    labels={labels}
                    layout="notebook"
                    detailed
                  >
                    {update.artifact && (
                      <Artifact
                        slot="artifact"
                        artifact={update.artifact}
                        copy={copy.artifact}
                        penUser={penUser}
                      />
                    )}
                    {relatedLinks(update, shown).map((related) => (
                      <p class="labbook-related" data-related={related.kind}>
                        <span>{copy.related[related.kind]}</span>{" "}
                        <Link href={related.href} arrow>
                          {related.title}
                        </Link>
                      </p>
                    ))}
                  </UpdateEntry>
                ) : (
                  <UpdateEntry
                    id={update.id}
                    date={update.date}
                    dateLabel={updateDateLabel(update.date)}
                    redacted={{
                      parts: update.shape.parts,
                      work: copy.redacted.works[update.shape.work],
                      label: copy.redacted.label,
                      bar: copy.redacted.bar,
                    }}
                    layout="notebook"
                  />
                )}
              </li>
            ))}
          </ol>
        </li>
      ))}
    </ol>
  </section>
)}
<style>
  /* Headed as a place in the room is (LabRoom). */
  .labbook {
    scroll-margin-top: var(--space-l);
  }
  .labbook-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-m);
    margin-bottom: var(--space-l);
    padding-top: var(--space-xl);
    border-top: var(--rule-width) solid var(--color-border);
  }
  .labbook-note {
    color: var(--color-text-soft);
  }

  /* The index: a pill for each experiment and project it can be narrowed
     to, with how many entries each has; the one it is narrowed to is the
     burgundy of a current page. Shown only where the script can act. */
  .labbook-index {
    display: grid;
    gap: var(--space-2xs);
    margin-bottom: var(--space-l);
  }
  .labbook-index[hidden] {
    display: none;
  }
  .labbook-index__label {
    font-size: var(--text-xs);
    line-height: var(--leading-tight);
    color: var(--color-text-soft);
  }
  .labbook-index__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .labbook-index__list :global(.ds-link--pill) {
    max-width: 100%;
    white-space: normal;
  }
  .labbook-count {
    margin-inline-start: var(--space-2xs);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    opacity: var(--ring-opacity);
  }
  .labbook-said {
    position: absolute;
    width: var(--rule-width);
    height: var(--rule-width);
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* While narrowed: a slip saying to what, and the way back. */
  .labbook-narrowed {
    justify-self: start;
    width: fit-content;
    max-width: 100%;
    margin-bottom: var(--space-l);
    padding: var(--space-s) var(--space-l) var(--space-s) var(--space-m);
    border-radius: var(--radius-note);
    background: var(--color-surface);
    font-size: var(--text-copy);
  }
  .labbook-narrowed[hidden] {
    display: none;
  }
  .labbook-narrowed strong {
    color: var(--color-accent);
  }
  /* It takes the focus after a narrowing only so it is read first; the
     next Tab is the way back, which shows its own focus. */
  .labbook-narrowed:focus {
    outline: none;
  }

  /* Months are chapters: each ruled off from the one before, its name
     over its entries, and, where there is room, standing in the margin
     beside them, staying in view while they are read. */
  .labbook-months,
  .labbook-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .labbook-month {
    display: grid;
    align-items: start;
    gap: var(--space-2xs) var(--space-xl);
    padding-block: var(--space-l) var(--space-xl);
  }
  .labbook-month + .labbook-month {
    border-top: var(--rule-width) solid var(--color-border);
  }
  .labbook-month__name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-xs);
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-section);
    font-weight: var(--weight-medium);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-accent);
  }
  .labbook-month__year {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: normal;
    color: var(--color-text-soft);
  }
  @media (min-width: 62.501rem) {
    .labbook-month {
      grid-template-columns: var(--labbook-month-width) minmax(0, 1fr);
    }
    .labbook-month__name {
      position: sticky;
      top: var(--space-l);
      flex-direction: column;
      padding-top: var(--space-m);
    }
  }

  /* Entries are ruled off from each other. */
  .labbook-entry + .labbook-entry {
    border-top: var(--rule-width) solid var(--color-border);
  }
  /* A link to an update lands with a little air above it. */
  .labbook-entry {
    scroll-margin-top: var(--space-xl);
  }
  /* The update a link landed on: its day is the nav's current ball. */
  .labbook-entry:target :global(.date-day) {
    background: var(--ball-fill-current);
    color: var(--ball-ink-current);
  }
  /* A picture is laid in as a print pasted into a notebook: a touch off
     the straight, turned one way and then the other down the page, and
     straightened when its entry is pointed at. */
  .labbook-entry :global(.event-artifact .ds-media) {
    rotate: var(--settle-angle);
  }
  .labbook-entry:nth-child(even) :global(.event-artifact .ds-media) {
    rotate: calc(-1 * var(--settle-angle));
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .labbook-entry :global(.event-artifact .ds-media) {
      transition: rotate var(--duration-hover) var(--ease-settle);
    }
    .labbook-entry:is(:hover, :has(:focus-visible))
      :global(.event-artifact .ds-media) {
      rotate: 0deg;
    }
  }
  .labbook-related {
    font-size: var(--text-sm);
    line-height: var(--leading-tight);
  }
  .labbook-related > span {
    color: var(--color-text-soft);
  }
</style>

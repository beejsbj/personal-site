---
import Heading from "../design/primitives/Heading.astro";
import Link from "../design/primitives/Link.astro";
import MediaFrame from "../design/primitives/MediaFrame.astro";
import TagList from "../design/primitives/TagList.astro";
import { part } from "../prism/parts";
/** Compound: cover + metadata + linked heading + summary + tools.
 * layout=row|stack|feature is the only axis. Children own interaction/typography.
 * Do not paste this assembly into another screen; import it.
 */
interface Props {
  href: string;
  title: string;
  summary: string;
  dateLabel: string;
  role: string;
  tools: string[];
  cover: string;
  /** The project's slug, marking its parts. */
  slug?: string;
  layout?: "row" | "stack" | "feature";
}
const {
  href,
  title,
  summary,
  dateLabel,
  role,
  tools,
  cover,
  slug,
  layout = "row",
} = Astro.props;
const mark = (name: Parameters<typeof part>[0]) =>
  slug === undefined ? {} : part(name, slug);
---

<article class:list={["project-row", `project-row--${layout}`]}>
  <MediaFrame src={cover} alt="" href={href} />
  <div class="project-copy">
    <p class="meta" {...mark("project.meta")}>
      {dateLabel} · {role}
    </p>
    <Heading
      level={3}
      scale={layout === "feature" ? "section" : "card"}
      {...mark("project.title")}
    >
      <Link href={href} arrow>
        {title}
      </Link>
    </Heading>
    <p class="summary" {...mark("project.summary")}>{summary}</p>
    <TagList items={tools.slice(0, 3)} label={`${title} tools`} />
  </div>
</article>
<style>
  .project-row {
    display: grid;
    grid-template-columns: var(--media-width) minmax(0, 1fr);
    gap: var(--space-l);
    border-top: var(--rule-width) solid var(--color-border);
    padding-block: var(--space-l);
  }
  .project-copy {
    display: grid;
    align-content: start;
    gap: var(--space-xs);
    min-width: 0;
  }
  .meta {
    font-size: var(--text-xs);
    color: var(--color-text-soft);
  }
  .summary {
    font-size: var(--text-copy);
  }
  .project-row--stack {
    grid-template-columns: 1fr;
  }
  .project-row--feature {
    grid-template-columns: var(--feature-media-width) minmax(0, 1fr);
    align-items: start;
  }
  .project-row--feature .summary {
    font-size: var(--text-base);
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .project-row:hover :global(.ds-media),
    .project-row:has(:focus-visible) :global(.ds-media) {
      transform: translateY(calc(-1 * var(--motion-lift)));
    }
    .project-row:hover :global(.ds-media)::before,
    .project-row:has(:focus-visible) :global(.ds-media)::before {
      transform: translate(
        calc(-1 * var(--motion-nudge)),
        calc(-1 * var(--motion-nudge))
      );
    }
    .project-row:hover :global(.ds-media)::after,
    .project-row:has(:focus-visible) :global(.ds-media)::after {
      transform: translate(var(--motion-nudge), var(--motion-nudge));
    }
  }
  @media (max-width: 62.5rem) {
    .project-row {
      grid-template-columns: 1fr;
    }
  }
</style>

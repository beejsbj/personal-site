---
import Heading from "../design/primitives/Heading.astro";
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  level?: 1 | 2;
}
const { eyebrow, title, intro, level = 1 } = Astro.props;
---

<header class="page-header">
  <div class="page-header__main">
    {eyebrow && <p class="page-header__eyebrow">{eyebrow}</p>}
    <Heading level={level} scale="page">
      {title}
    </Heading>
    {intro && <p class="page-header__intro">{intro}</p>}
    {Astro.slots.has("actions") && (
      <div class="page-header__actions">
        <slot name="actions" />
      </div>
    )}
  </div>
  {Astro.slots.has("aside") && (
    <aside class="page-header__aside">
      <slot name="aside" />
    </aside>
  )}
</header>

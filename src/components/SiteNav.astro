---
import type { SiteData } from "../content.config";
import Link from "../design/primitives/Link.astro";
interface Props {
  site: Pick<SiteData, "nav" | "email" | "header">;
  currentPath: string;
  label?: string;
}
const { site, currentPath, label = site.header.label } = Astro.props;
const items = [
  { label: site.header.home, href: "/", external: false },
  ...site.header.items.flatMap((name) =>
    site.nav.filter((item) => item.label === name),
  ),
  { label: site.header.hello, href: `mailto:${site.email}`, external: true },
];
const current = (href: string) =>
  href === "/"
    ? currentPath === "/"
    : currentPath === href || currentPath.startsWith(href + "/");
---

<nav class="site-nav" aria-label={label}>
  <ul>
    {items.map((item) => (
      <li>
        <Link
          href={item.href}
          treatment="nav"
          current={current(item.href)}
          arrow={item.external}
        >
          {item.label}
        </Link>
      </li>
    ))}
  </ul>
</nav>
<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-l);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav {
    font-size: var(--text-base);
  }
  @media (max-width: 40.625rem) {
    .site-nav {
      width: 100%;
    }
    ul {
      display: grid;
      grid-template-columns: repeat(3, max-content);
      justify-content: space-between;
      column-gap: var(--space-s);
    }
  }
</style>

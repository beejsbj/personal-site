---
import Heading from "../design/primitives/Heading.astro";
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  compact?: boolean;
  level?: 1 | 2 | 3;
}
const { eyebrow, title, intro, compact = false, level = 2 } = Astro.props;
---

<header class="section-intro">
  {eyebrow && <p class="section-intro__eyebrow">{eyebrow}</p>}
  <Heading level={level} scale={compact ? "card" : "section"}>
    {title}
  </Heading>
  {intro && <p class="section-intro__intro">{intro}</p>}
</header>

---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  compact?: boolean;
  level?: 1 | 2 | 3;
}

const { eyebrow, title, intro, compact = false, level = 2 } = Astro.props;
---

<header class:list={["section-intro", compact && "is-compact"]}>
  {eyebrow && <p class="section-intro__eyebrow">{eyebrow}</p>}
  {level === 1 ? (
    <h1 class="section-intro__title">{title}</h1>
  ) : level === 3 ? (
    <h3 class="section-intro__title">{title}</h3>
  ) : (
    <h2 class="section-intro__title">{title}</h2>
  )}
  {intro && <p class="section-intro__intro">{intro}</p>}
</header>

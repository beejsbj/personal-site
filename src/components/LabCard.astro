---
import Heading from "../design/primitives/Heading.astro";
import Link from "../design/primitives/Link.astro";
import MediaFrame from "../design/primitives/MediaFrame.astro";
interface Props {
  href: string;
  title: string;
  summary: string;
  type: string;
  sourceEra: string;
  cover: string;
}
const { href, title, summary, type, sourceEra, cover } = Astro.props;
---

<article class="lab-card">
  <MediaFrame src={cover} alt="" fit="cover" />
  <p class="meta">
    {type} · {sourceEra}
  </p>
  <Heading level={2} scale="card">
    <Link href={href} arrow>
      {title}
    </Link>
  </Heading>
  <p>{summary}</p>
</article>
<style>
  .lab-card {
    display: grid;
    align-content: start;
    gap: var(--space-s);
    border-top: var(--rule-width) solid var(--color-border);
    padding-top: var(--space-l);
  }
  .meta {
    font-size: var(--text-xs);
    color: var(--color-text-soft);
  }
</style>

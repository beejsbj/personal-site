---
interface Props {
  href: string;
  title: string;
  summary: string;
  type: string;
  sourceEra: string;
  cover: string;
}

const { href, title, summary, type, sourceEra, cover } = Astro.props;
---

<article class="lab-card">
  <div class="lab-card__media">
    <img src={cover} alt={`${title} cover`} loading="lazy" decoding="async" />
  </div>

  <div class="lab-card__body">
    <p class="lab-card__meta">{type} · {sourceEra}</p>
    <h2 class="lab-card__title">
      <a href={href}>{title}</a>
    </h2>
    <p class="lab-card__summary">{summary}</p>
  </div>
</article>

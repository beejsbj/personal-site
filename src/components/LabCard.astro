---
import Heading from "../design/primitives/Heading.astro";
import Link from "../design/primitives/Link.astro";
import MediaFrame from "../design/primitives/MediaFrame.astro";
import { part } from "../prism/parts";
interface Props {
  /** The entry's slug, marking its parts. */
  slug?: string;
  href: string;
  title: string;
  summary: string;
  type: string;
  sourceEra: string;
  cover?: string;
}
const { slug, href, title, summary, type, sourceEra, cover } = Astro.props;
const mark = (name: Parameters<typeof part>[0]) =>
  slug === undefined ? {} : part(name, slug);
---

<article class="lab-card">
  {cover && <MediaFrame src={cover} alt="" fit="cover" />}
  <p class="meta" {...mark("lab.meta")}>
    {type} · {sourceEra}
  </p>
  <Heading level={2} scale="card" {...mark("lab.title")}>
    <Link href={href} arrow>
      {title}
    </Link>
  </Heading>
  <p {...mark("lab.summary")}>{summary}</p>
</article>
<style>
  .lab-card {
    display: grid;
    align-content: start;
    gap: var(--space-s);
    border-top: var(--rule-width) solid var(--color-border);
    padding-top: var(--space-l);
  }
  .meta {
    font-size: var(--text-xs);
    color: var(--color-text-soft);
  }
</style>

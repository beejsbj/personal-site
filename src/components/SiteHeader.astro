---
import SiteNav from "./SiteNav.astro";
interface Props {
  nav: { label: string; href: string; external?: boolean }[];
  currentPath: string;
  email: string;
}
const { nav, currentPath, email } = Astro.props;
---

<header class="site-header shell">
  <a class="home-link" href="/" aria-label="Burooj — home">
    burooj.
  </a>
  <SiteNav nav={nav} currentPath={currentPath} email={email} />
</header>
<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s) var(--space-xl);
    padding-block: var(--space-l);
    border-bottom: var(--rule-width) solid var(--color-border);
  }
  .home-link {
    font-family: var(--font-serif);
    font-size: var(--text-section);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-heading);
  }
  @media (max-width: 40.625rem) {
    .home-link {
      margin-left: var(--space-xl);
    }
    .site-header {
      padding-block: var(--space-m) var(--space-s);
    }
  }
</style>

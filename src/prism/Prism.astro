---
/** Runtime for the Curiosity Reveal, the Prism Lure and the prism stage.
 * Adds nothing to the page until the visitor shows curiosity. */
---

<script>
  import { installPrism } from "./prism";
  import { syncShell } from "./shell-runtime";
  syncShell();
  document.addEventListener("astro:page-load", () => syncShell());
  installPrism();
</script>

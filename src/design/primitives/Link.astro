---
/** Primitive: label + optional decorative arrow. No nested controls.
 * Axes: treatment=text|circle|action, tone=paper|wine, size=sm|md|lg.
 * States: rest, hover, focus, active, current, disabled; no loading behavior.
 * Native anchor navigation; disabled renders a non-interactive span.
 */
interface Props {
  href: string;
  treatment?: "text" | "circle" | "action";
  tone?: "paper" | "wine";
  size?: "sm" | "md" | "lg";
  current?: boolean;
  arrow?: boolean;
  disabled?: boolean;
  newTab?: boolean;
}
const {
  href,
  treatment = "text",
  tone = "paper",
  size = "md",
  current = false,
  arrow = false,
  disabled = false,
  newTab = false,
} = Astro.props;
const Tag = disabled ? "span" : "a";
---

<Tag
  href={disabled ? undefined : href}
  class:list={[
    "ds-link",
    `ds-link--${treatment}`,
    `ds-link--${tone}`,
    `ds-link--${size}`,
  ]}
  aria-current={current ? "page" : undefined}
  aria-disabled={disabled || undefined}
  target={!disabled && newTab ? "_blank" : undefined}
  rel={!disabled && newTab ? "noreferrer" : undefined}
>
  <span>
    <slot />
    {arrow && (
      <span class="link-arrow" aria-hidden="true">
        {" "}
        ↗
      </span>
    )}
  </span>
</Tag>
<style>
  .ds-link {
    color: var(--color-accent);
    font: inherit;
    text-decoration: none;
    text-underline-offset: var(--underline-offset);
  }
  .ds-link:hover {
    text-decoration: underline;
  }
  .ds-link--text {
    position: relative;
    display: inline-block;
  }
  .ds-link--text::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: calc(-1 * var(--link-dot-size));
    width: var(--link-dot-size);
    height: var(--link-dot-size);
    background: currentColor;
    border-radius: var(--radius-round);
    transform: translateX(-50%);
  }
  .ds-link--text::before {
    content: "";
    position: absolute;
    left: 0;
    bottom: calc(-1 * var(--link-dot-size));
    width: 100%;
    height: var(--rule-width);
    background: currentColor;
    transform: scaleX(0);
    transition: transform var(--duration-blob-feedback) var(--ease-blob-settle);
  }
  .ds-link--text:focus-visible::after {
    opacity: 0;
  }
  .ds-link--text:focus-visible::before {
    transform: scaleX(1);
    transition: none;
  }
  .ds-link--text:active::after {
    opacity: 1;
    width: var(--link-press-size);
    height: var(--link-press-size);
    background: var(--color-link-rule);
  }
  .link-arrow {
    display: inline-block;
  }
  @media (hover: hover) and (pointer: fine) {
    .ds-link--text:hover {
      text-decoration: none;
    }
    .ds-link--text:hover::after {
      opacity: 0;
    }
    .ds-link--text:hover::before {
      transform: scaleX(1);
    }
    .link-arrow {
      transition: transform var(--duration-fast) var(--ease-feedback);
    }
    .ds-link:hover .link-arrow {
      transform: translate(
        var(--link-arrow-lift),
        calc(-1 * var(--link-arrow-lift))
      );
    }
  }
  .ds-link:focus-visible {
    outline: var(--focus-width) solid var(--color-accent);
    outline-offset: var(--focus-offset);
  }
  .ds-link--circle,
  .ds-link--action {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    background: var(--color-surface-strong);
    font-size: var(--text-sm);
    line-height: var(--leading-tight);
    white-space: nowrap;
    transition: transform var(--duration-fast) var(--ease-feedback);
  }
  .ds-link--circle {
    width: var(--circle-md);
    height: var(--circle-md);
    border-radius: var(--radius-round);
  }
  .ds-link--circle.ds-link--sm {
    width: var(--circle-sm);
    height: var(--circle-sm);
  }
  .ds-link--circle.ds-link--lg {
    width: var(--circle-lg);
    height: var(--circle-lg);
  }
  .ds-link--action {
    padding: var(--space-s) var(--space-m);
    border: var(--rule-width) solid var(--color-accent);
  }
  .ds-link--wine {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }
  .ds-link--circle:hover,
  .ds-link--action:hover {
    background: var(--color-hover);
    color: var(--color-accent);
    text-decoration: none;
  }
  .ds-link[aria-current] {
    text-decoration: underline;
  }
  .ds-link--circle:active,
  .ds-link--action:active {
    transform: scale(var(--press-scale));
  }
  .ds-link[aria-disabled] {
    opacity: var(--disabled-opacity);
    pointer-events: none;
  }
  @media (max-width: 40.625rem) {
    .ds-link--circle {
      width: var(--circle-compact);
      height: var(--circle-compact);
      font-size: var(--text-xs);
    }
    .ds-link--circle.ds-link--lg {
      width: var(--circle-compact-lg);
      height: var(--circle-compact-lg);
    }
    .ds-link--circle.ds-link--sm {
      width: var(--circle-sm);
      height: var(--circle-sm);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ds-link,
    .link-arrow,
    .ds-link--text::before {
      transition: none;
    }
    .ds-link:hover .link-arrow {
      transform: none;
    }
    .ds-link:active {
      transform: none;
    }
  }
</style>

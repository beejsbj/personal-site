---
/** Primitive: label + optional decorative arrow. No nested controls.
 * Axes: treatment=text|nav|action|ball, tone=paper|wine.
 * States: rest, hover, focus, active, current, disabled; no loading behavior.
 * Native anchor navigation; disabled renders a non-interactive span.
 * Hover draws the underline in from the left; arrows nudge the way they point.
 * Ball (v2's .button): a peach ball rests behind the label's first letters
 * and stretches into a pill under the whole label on hover or focus.
 */
interface Props {
  href: string;
  treatment?: "text" | "nav" | "action" | "ball";
  tone?: "paper" | "wine";
  current?: boolean;
  arrow?: boolean;
  disabled?: boolean;
  newTab?: boolean;
}
const {
  href,
  treatment = "text",
  tone = "paper",
  current = false,
  arrow = false,
  disabled = false,
  newTab = false,
} = Astro.props;
const Tag = disabled ? "span" : "a";
const outbound = /^(https?:|mailto:)/.test(href);
---

<Tag
  href={disabled ? undefined : href}
  class:list={["ds-link", `ds-link--${treatment}`, `ds-link--${tone}`]}
  aria-current={current ? "page" : undefined}
  aria-disabled={disabled || undefined}
  target={!disabled && newTab ? "_blank" : undefined}
  rel={!disabled && newTab ? "noreferrer" : undefined}
>
  <span>
    <span class="link-label">
      <slot />
    </span>
    {arrow && (
      <svg
        class:list={["link-arrow", { "link-arrow--out": outbound }]}
        aria-hidden="true"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d={outbound ? "M4 12 12 4M4 4h8v8" : "M2 8h11M8 3l5 5-5 5"} />
      </svg>
    )}
  </span>
</Tag>
<style>
  .ds-link {
    color: var(--color-accent);
    font: inherit;
    text-decoration: none;
    text-underline-offset: var(--underline-offset);
  }
  .ds-link:hover {
    text-decoration: underline;
  }
  /* Text and navigation underlines are painted on the label so the ink can
     draw in from the left; the resting pencil rule stays full width. */
  .ds-link--text .link-label,
  .ds-link--nav .link-label {
    padding-bottom: var(--underline-pad);
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 100% 100%;
    background-size: 0% var(--rule-width);
  }
  .ds-link--text .link-label {
    background-image:
      linear-gradient(currentColor, currentColor),
      linear-gradient(var(--color-link-rule), var(--color-link-rule));
    background-position:
      100% 100%,
      0 100%;
    background-size:
      0% var(--rule-width),
      100% var(--rule-width);
  }
  .ds-link--text:hover,
  .ds-link--nav:hover {
    text-decoration: none;
  }
  .ds-link--text:is(:hover, :focus-visible) .link-label {
    background-position:
      0 100%,
      0 100%;
    background-size:
      100% var(--rule-width),
      100% var(--rule-width);
  }
  .ds-link--nav .link-label {
    background-size: 0% var(--focus-width);
  }
  .ds-link--nav:is(:hover, :focus-visible) .link-label {
    background-position: 0 100%;
    background-size: 100% var(--focus-width);
  }
  .link-arrow {
    display: inline-block;
    width: var(--icon-inline);
    height: var(--icon-inline);
    margin-left: var(--space-2xs);
    vertical-align: baseline;
  }
  .ds-link--nav {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-min-height);
    color: var(--color-text-soft);
    white-space: nowrap;
    text-decoration-thickness: var(--focus-width);
  }
  .ds-link--nav:is(:hover, :focus-visible, [aria-current]) {
    color: var(--color-accent);
  }
  .ds-link--nav[aria-current] {
    font-weight: var(--weight-bold);
  }
  .ds-link--nav[aria-current] .link-label {
    background-image: none;
  }
  .ds-link--nav:active {
    color: var(--color-accent-pressed);
  }
  @media (hover: hover) and (pointer: fine) {
    .ds-link--text .link-label,
    .ds-link--nav .link-label {
      transition: background-size var(--duration-hover) var(--ease-settle);
    }
    .link-arrow {
      transition: transform var(--duration-hover) var(--ease-settle);
    }
    .ds-link:hover .link-arrow {
      transform: translateX(var(--link-arrow-lift));
    }
    .ds-link:hover .link-arrow--out {
      transform: translate(
        var(--link-arrow-lift),
        calc(-1 * var(--link-arrow-lift))
      );
    }
  }
  .ds-link:focus-visible {
    outline: var(--focus-width) solid var(--color-accent);
    outline-offset: var(--focus-offset);
  }
  .ds-link--ball {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    min-height: var(--control-min-height);
    padding-inline: var(--space-s);
  }
  .ds-link--ball::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: 50%;
    left: 0;
    width: var(--ball-link-size);
    height: var(--ball-link-size);
    border-radius: var(--ball-link-size);
    background: var(--color-surface-strong);
    translate: 0 -50%;
  }
  .ds-link--ball:is(:hover, :focus-visible) {
    text-decoration: none;
  }
  .ds-link--ball:is(:hover, :focus-visible)::before {
    width: 100%;
    background: var(--color-hover);
  }
  .ds-link--ball:active::before {
    background: var(--color-surface-strong);
    scale: var(--press-scale);
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .ds-link--ball::before {
      transition:
        width var(--duration-hover) var(--ease-pop),
        background-color var(--duration-hover) var(--ease-feedback),
        scale var(--duration-fast) var(--ease-feedback);
    }
  }
  .ds-link--action {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    background: var(--color-surface-strong);
    font-size: var(--text-sm);
    line-height: var(--leading-tight);
    white-space: nowrap;
    transition: transform var(--duration-fast) var(--ease-feedback);
  }
  .ds-link--action {
    padding: var(--space-s) var(--space-m);
    border: var(--rule-width) solid var(--color-accent);
  }
  .ds-link--wine {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }
  .ds-link--action:hover {
    background: var(--color-hover);
    color: var(--color-accent);
    text-decoration: none;
  }
  .ds-link[aria-current] {
    text-decoration: underline;
  }
  .ds-link--action:active {
    transform: scale(var(--press-scale));
  }
  .ds-link[aria-disabled] {
    opacity: var(--disabled-opacity);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .ds-link,
    .link-arrow,
    .link-label {
      transition: none;
    }
    .ds-link:hover .link-arrow {
      transform: none;
    }
    .ds-link:active {
      transform: none;
    }
  }
</style>

---
/** Primitive: label + optional decorative arrow. No nested controls.
 * Axes: treatment=text|ball|pill, tone=paper|wine.
 * States: rest, hover, focus, active, current, disabled; no loading behavior.
 * Native anchor navigation; disabled renders a non-interactive span.
 * Hover draws the underline in from the left; arrows nudge the way they point.
 * Ball: the label sits inside a peach ball (the site navigation); the
 * current page's ball is burgundy. Pill (v2's .button): a peach ball rests
 * behind the label's first letters and stretches into a pill on hover.
 * Both paint their shape on ::before, so hover lift and press squish never
 * move the hit area: a press is always a click.
 */
import type { HTMLAttributes } from "astro/types";
interface Props extends Omit<HTMLAttributes<"a">, "href"> {
  href: string;
  treatment?: "text" | "ball" | "pill";
  tone?: "paper" | "wine";
  current?: boolean;
  arrow?: boolean;
  disabled?: boolean;
  newTab?: boolean;
}
const {
  href,
  treatment = "text",
  tone = "paper",
  current = false,
  arrow = false,
  disabled = false,
  newTab = false,
  ...attrs
} = Astro.props;
const Tag = disabled ? "span" : "a";
const outbound = /^(https?:|mailto:)/.test(href);
---

<Tag
  {...attrs}
  href={disabled ? undefined : href}
  class:list={["ds-link", `ds-link--${treatment}`, `ds-link--${tone}`]}
  aria-current={current ? "page" : undefined}
  aria-disabled={disabled || undefined}
  target={!disabled && newTab ? "_blank" : undefined}
  rel={!disabled && newTab ? "noreferrer" : undefined}
>
  <span>
    <span class="link-label">
      <slot />
    </span>
    {arrow && (
      <svg
        class:list={["link-arrow", { "link-arrow--out": outbound }]}
        aria-hidden="true"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d={outbound ? "M4 12 12 4M4 4h8v8" : "M2 8h11M8 3l5 5-5 5"} />
      </svg>
    )}
  </span>
</Tag>
<style>
  .ds-link {
    color: var(--color-accent);
    font: inherit;
    text-decoration: none;
    text-underline-offset: var(--underline-offset);
  }
  .ds-link:hover {
    text-decoration: underline;
  }
  /* Text links rest on a pencil rule painted on the label. Their hover
     belongs to the ball family: the rule gives way to a peach pill that
     grows behind the words from the left (the whole link, arrow too). */
  .ds-link--text .link-label {
    padding-bottom: var(--underline-pad);
    background-repeat: no-repeat;
    background-image: linear-gradient(
      var(--color-link-rule),
      var(--color-link-rule)
    );
    background-position: 0 100%;
    background-size: 100% var(--rule-width);
  }
  .ds-link--text > span {
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    border-radius: var(--radius-pill);
    background-image: linear-gradient(
      var(--ball-fill-hover),
      var(--ball-fill-hover)
    );
    background-repeat: no-repeat;
    background-position: 0 0;
    background-size: 0% 100%;
  }
  .ds-link--text:hover {
    text-decoration: none;
  }
  .ds-link--text:is(:hover, :focus-visible) > span {
    background-size: 100% 100%;
  }
  .ds-link--text:is(:hover, :focus-visible) .link-label {
    background-size: 0% var(--rule-width);
  }
  .link-arrow {
    display: inline-block;
    width: var(--icon-inline);
    height: var(--icon-inline);
    margin-left: var(--space-2xs);
    vertical-align: baseline;
  }
  @media (hover: hover) and (pointer: fine) {
    .ds-link--text .link-label,
    .ds-link--text > span {
      transition: background-size var(--duration-hover) var(--ease-settle);
    }
    .link-arrow {
      transition: transform var(--duration-hover) var(--ease-settle);
    }
    .ds-link:hover .link-arrow {
      transform: translateX(var(--link-arrow-lift));
    }
    .ds-link:hover .link-arrow--out {
      transform: translate(
        var(--link-arrow-lift),
        calc(-1 * var(--link-arrow-lift))
      );
    }
  }
  .ds-link:focus-visible {
    outline: var(--focus-width) solid var(--color-accent);
    outline-offset: var(--focus-offset);
  }
  /* Ball: the label inside a peach ball. Width comes from the caller (the
     nav sets it); the ball is a circle of that width. */
  .ds-link--ball {
    position: relative;
    isolation: isolate;
    display: inline-grid;
    place-items: center;
    aspect-ratio: 1;
    padding: var(--space-2xs);
    border-radius: var(--radius-round);
    color: var(--ball-ink);
    font-family: var(--font-serif);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-display);
    text-align: center;
    user-select: none;
    -webkit-user-drag: none;
    touch-action: manipulation;
  }
  .ds-link--ball > span {
    max-inline-size: var(--ball-label-measure);
    text-wrap: balance;
  }
  .ds-link--ball::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: inherit;
    background: var(--ball-fill);
    box-shadow: var(--ball-shadow-rest);
  }
  .ds-link--ball:is(:hover, :focus-visible) {
    text-decoration: none;
  }
  .ds-link--ball:is(:hover, :focus-visible)::before {
    background: var(--ball-fill-hover);
    box-shadow: var(--shadow-ball-raised);
  }
  .ds-link--ball[aria-current] {
    color: var(--ball-ink-current);
    text-decoration: none;
  }
  .ds-link--ball[aria-current]::before {
    background: var(--ball-fill-current);
  }
  .ds-link--ball[aria-current]:is(:hover, :focus-visible)::before {
    background: var(--ball-fill-current-hover);
  }
  .ds-link--ball:active::before {
    scale: var(--press-scale);
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .ds-link--ball::before {
      transition:
        scale var(--duration-hover) var(--ease-pop),
        translate var(--duration-hover) var(--ease-pop),
        background-color var(--duration-hover) var(--ease-feedback),
        box-shadow var(--duration-hover) var(--ease-settle);
    }
    .ds-link--ball:hover::before {
      scale: var(--ball-hover-scale);
      translate: 0 calc(-1 * var(--motion-lift));
    }
    .ds-link--ball:hover:active::before {
      scale: var(--press-scale);
      translate: none;
      transition-duration: var(--duration-fast);
    }
  }
  @media (forced-colors: active) {
    .ds-link--ball::before {
      border: var(--focus-width) solid CanvasText;
    }
    .ds-link--ball[aria-current]::before {
      border-color: Highlight;
    }
  }
  /* Pill (v2's .button), the family's action link: a peach ball rests
     behind the label's first letters and stretches into a pill on hover.
     Wine: the pill is already full and burgundy (a primary action). */
  .ds-link--pill {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    min-height: var(--control-min-height);
    padding-inline: var(--space-s);
    border-radius: var(--radius-pill);
    color: var(--ball-ink);
    white-space: nowrap;
    user-select: none;
    -webkit-user-drag: none;
  }
  .ds-link--pill::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: 50%;
    left: 0;
    width: var(--ball-link-size);
    height: var(--ball-link-size);
    border-radius: var(--ball-link-size);
    background: var(--ball-fill);
    translate: 0 -50%;
  }
  .ds-link--pill:is(:hover, :focus-visible) {
    text-decoration: none;
  }
  .ds-link--pill:is(:hover, :focus-visible)::before {
    width: 100%;
    background: var(--ball-fill-hover);
  }
  .ds-link--pill.ds-link--wine {
    padding-inline: var(--space-m);
    color: var(--ball-ink-current);
  }
  .ds-link--pill.ds-link--wine::before {
    width: 100%;
    background: var(--ball-fill-current);
  }
  .ds-link--pill.ds-link--wine:is(:hover, :focus-visible)::before {
    background: var(--ball-fill-current-hover);
  }
  .ds-link--pill:active::before {
    scale: var(--press-scale);
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .ds-link--pill::before {
      transition:
        width var(--duration-hover) var(--ease-pop),
        background-color var(--duration-hover) var(--ease-feedback),
        scale var(--duration-fast) var(--ease-feedback);
    }
  }
  @media (forced-colors: active) {
    .ds-link--pill::before {
      border: var(--rule-width) solid CanvasText;
    }
  }
  .ds-link[aria-disabled] {
    opacity: var(--disabled-opacity);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .ds-link,
    .link-arrow,
    .link-label {
      transition: none;
    }
    .ds-link:hover .link-arrow {
      transform: none;
    }
    .ds-link:active {
      transform: none;
    }
  }
</style>

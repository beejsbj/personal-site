---
/** Primitive: label + optional decorative arrow. No nested controls.
 * Axes: treatment=text|circle|action, tone=paper|wine, size=sm|md|lg.
 * States: rest, hover, focus, active, current, disabled; no loading behavior.
 * Native anchor navigation; disabled renders a non-interactive span.
 */
interface Props {
  href: string;
  treatment?: "text" | "circle" | "action";
  tone?: "paper" | "wine";
  size?: "sm" | "md" | "lg";
  current?: boolean;
  arrow?: boolean;
  disabled?: boolean;
  newTab?: boolean;
}
const {
  href,
  treatment = "text",
  tone = "paper",
  size = "md",
  current = false,
  arrow = false,
  disabled = false,
  newTab = false,
} = Astro.props;
const Tag = disabled ? "span" : "a";
---

<Tag
  href={disabled ? undefined : href}
  class:list={[
    "ds-link",
    `ds-link--${treatment}`,
    `ds-link--${tone}`,
    `ds-link--${size}`,
  ]}
  aria-current={current ? "page" : undefined}
  aria-disabled={disabled || undefined}
  target={!disabled && newTab ? "_blank" : undefined}
  rel={!disabled && newTab ? "noreferrer" : undefined}
>
  <span>
    <slot />
    {arrow && <span aria-hidden="true"> ↗</span>}
  </span>
</Tag>
<style>
  .ds-link {
    color: var(--color-accent);
    font: inherit;
    text-decoration: none;
    text-underline-offset: var(--underline-offset);
  }
  .ds-link:hover {
    text-decoration: underline;
  }
  .ds-link:focus-visible {
    outline: var(--focus-width) solid var(--color-accent);
    outline-offset: var(--focus-offset);
  }
  .ds-link--circle,
  .ds-link--action {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    background: var(--color-surface-strong);
    font-size: var(--text-sm);
    line-height: var(--leading-tight);
    white-space: nowrap;
    transition: transform var(--duration-fast) var(--ease-feedback);
  }
  .ds-link--circle {
    width: var(--circle-md);
    height: var(--circle-md);
    border-radius: var(--radius-round);
  }
  .ds-link--circle.ds-link--sm {
    width: var(--circle-sm);
    height: var(--circle-sm);
  }
  .ds-link--circle.ds-link--lg {
    width: var(--circle-lg);
    height: var(--circle-lg);
  }
  .ds-link--action {
    padding: var(--space-s) var(--space-m);
    border: var(--rule-width) solid var(--color-accent);
  }
  .ds-link--wine {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }
  .ds-link--circle:hover,
  .ds-link--action:hover {
    background: var(--color-hover);
    color: var(--color-accent);
    text-decoration: none;
  }
  .ds-link[aria-current] {
    text-decoration: underline;
  }
  .ds-link--circle:active,
  .ds-link--action:active {
    transform: scale(var(--press-scale));
  }
  .ds-link[aria-disabled] {
    opacity: var(--disabled-opacity);
    pointer-events: none;
  }
  @media (max-width: 40.625rem) {
    .ds-link--circle {
      width: var(--circle-compact);
      height: var(--circle-compact);
      font-size: var(--text-xs);
    }
    .ds-link--circle.ds-link--lg {
      width: var(--circle-compact-lg);
      height: var(--circle-compact-lg);
    }
    .ds-link--circle.ds-link--sm {
      width: var(--circle-sm);
      height: var(--circle-sm);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ds-link {
      transition: none;
    }
    .ds-link:active {
      transform: none;
    }
  }
</style>

---
/** Passive metadata list. Inline editorial separators, not button-like pills. */
interface Props {
  items: string[];
  label?: string;
}
const { items, label = "Tools" } = Astro.props;
---

<ul class="ds-tags" aria-label={label}>
  {items.map((item) => (
    <li>{item}</li>
  ))}
</ul>
<style>
  .ds-tags {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: var(--space-2xs);
    color: var(--color-text-soft);
    font-size: var(--text-xs);
  }
  li + li::before {
    content: "/";
    margin-right: var(--space-2xs);
  }
</style>

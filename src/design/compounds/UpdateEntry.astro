---
import type { CollectionEntry } from "astro:content";
import Heading from "../primitives/Heading.astro";
import Link from "../primitives/Link.astro";
type Props = CollectionEntry<"updates">["data"];
const { title, date, dateLabel, href, summary } = Astro.props;
---

<article class="update-entry">
  <time datetime={date}>{dateLabel}</time>
  <Heading level={3} scale="label">
    <Link href={href} arrow>
      {title}
    </Link>
  </Heading>
  <p>{summary}</p>
</article>
<style>
  .update-entry {
    display: grid;
    gap: var(--space-2xs);
    border-top: var(--rule-width) solid var(--color-border);
    padding-block: var(--space-m);
  }
  time {
    font-size: var(--text-xs);
    color: var(--color-text-soft);
  }
  p {
    font-size: var(--text-sm);
  }
</style>

---
import type { UpdateData } from "../../content.config";
import { selectActivitySnapshot } from "../../lib/activity.mjs";
import UpdateEntry from "./UpdateEntry.astro";

interface Props {
  updates: (UpdateData & { id?: string })[];
  copy: {
    intro: string;
    listLabel: string;
    empty: string;
    caption: string;
    limit: number;
  };
  labels: { kinds: Record<string, string>; sources: Record<string, string> };
}
const { copy, labels } = Astro.props;
// Curated build-time snapshot, not a connected presence service. Expiry is
// evaluated only when rendering/building; deployed HTML does not self-expire.
// Publish no live signals until a runtime or scheduled-refresh layer exists.
const updates = selectActivitySnapshot(Astro.props.updates).slice(0, copy.limit);
---

<div class="activity-stream">
  <p class="stream-intro">{copy.intro}</p>
  {updates.length ? (
    <ol aria-label={copy.listLabel} class="stream-events">
      {updates.map((update, index) => (
        <li>
          <UpdateEntry
            {...update}
            labels={labels}
            connected={index < updates.length - 1}
          />
        </li>
      ))}
    </ol>
  ) : (
    <p class="stream-empty">{copy.empty}</p>
  )}
  <p class="stream-caption">{copy.caption}</p>
</div>
<style>
  .stream-intro,
  .stream-empty {
    font-size: var(--text-sm);
    color: var(--color-text-soft);
    margin-bottom: var(--space-m);
  }
  .stream-events {
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .stream-caption {
    padding-top: var(--space-s);
    border-top: var(--rule-width) solid var(--color-border);
    font-size: var(--text-xs);
    color: var(--color-text-soft);
  }
</style>

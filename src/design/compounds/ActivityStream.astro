---
import type { UpdateData } from "../../content.config";
import { selectActivitySnapshot } from "../../lib/activity.mjs";
import UpdateEntry from "./UpdateEntry.astro";
import LiveActivity from "./LiveActivity.astro";

interface Props {
  updates: UpdateData[];
}
// Durable stories use a static snapshot; live postcards have their own runtime
// freshness boundary and never become permanent milestone entries.
const updates = selectActivitySnapshot(Astro.props.updates).slice(0, 8);
---

<div class="activity-stream">
  <p class="stream-intro">Things taking shape around here.</p>
  <LiveActivity />
  <ol
    aria-label="Recent activity, newest first"
    class="stream-events"
    data-runtime-events
    data-events={JSON.stringify(updates)}
    hidden={!updates.length}
  >
    {updates.map((update, index) => (
      <li>
        <UpdateEntry {...update} connected={index < updates.length - 1} />
      </li>
    ))}
  </ol>
  <p class="stream-empty" data-stream-empty hidden={updates.length > 0}>
    A quiet moment. More when there's something to share.
  </p>
  {(
    [
      "project",
      "pull-request",
      "repository",
      "writing",
      "lab",
      "milestone",
    ] as const
  ).map((kind) => (
    <template data-event-template={kind}>
      <li>
        <UpdateEntry
          title="Postcard"
          summary=""
          href="/house"
          linkLabel="Read more"
          date="1970-01-01"
          dateLabel=""
          kind={kind}
          source="site"
        />
      </li>
    </template>
  ))}
  <p class="stream-caption">
    {updates.some((update) => update.id)
      ? "A few postcards from the things I'm making."
      : "A few things I've been up to."}
  </p>
</div>
<style>
  .stream-intro,
  .stream-empty {
    font-size: var(--text-sm);
    color: var(--color-text-soft);
    margin-bottom: var(--space-m);
  }
  .stream-events {
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .stream-caption {
    padding-top: var(--space-s);
    border-top: var(--rule-width) solid var(--color-border);
    font-size: var(--text-xs);
    color: var(--color-text-soft);
  }
</style>

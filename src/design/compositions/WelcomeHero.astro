---
import Heading from "../primitives/Heading.astro";
import Link from "../primitives/Link.astro";
import Portrait from "../unique/Portrait.astro";
import { part } from "../../prism/parts";
/** Composition: approved A introduction. The guide imports this same region. */
interface Props {
  hero: {
    greeting: string;
    headline: string;
    occupation: string;
    welcome: string;
    portrait: { src: string; alt: string; caption: string; href: string };
    links: { label: string; href: string }[];
  };
  level?: 1 | 2;
  id?: string;
}
const { hero, level = 1, id = "home-title" } = Astro.props;
// Only the page's own hero carries the home page's parts.
const mark = (name: Parameters<typeof part>[0]) =>
  level === 1 ? part(name, name === "page.title" ? "home" : undefined) : {};
---

<section class="hello" aria-labelledby={id}>
  <Portrait {...hero.portrait} {...mark("home.portrait")} />
  <div class="copy">
    <p class="greeting" {...mark("home.greeting")}>{hero.greeting}</p>
    <div class="title">
      <Heading level={level} scale="display" id={id} {...mark("page.title")}>
        {hero.headline}
      </Heading>
    </div>
    <p class="occupation" {...mark("home.occupation")}>{hero.occupation}</p>
    <p class="welcome" {...mark("home.welcome")}>{hero.welcome}</p>
    <div class="socials" {...mark("home.links")}>
      {hero.links.map((link) => (
        <Link href={link.href} arrow>
          {link.label}
        </Link>
      ))}
    </div>
  </div>
</section>
<style>
  .hello {
    display: grid;
    grid-template-columns: var(--portrait-width) minmax(0, 1fr);
    gap: var(--space-2xl);
    align-items: center;
    padding: var(--space-2xl) 0 var(--space-3xl);
    max-width: var(--welcome-width);
  }
  .greeting {
    font-size: var(--text-lead);
    line-height: var(--leading-heading);
    color: var(--color-text-soft);
  }
  .title {
    margin: var(--space-xs) 0 var(--space-s);
  }
  .occupation {
    font-size: var(--text-lead);
    color: var(--color-accent);
  }
  .welcome {
    font-size: var(--text-lead);
    max-width: var(--welcome-copy-width);
    margin-top: var(--space-m);
    text-wrap: pretty;
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    margin-top: var(--space-m);
    font-size: var(--text-base);
  }
  @media (max-width: 62.5rem) {
    .hello {
      grid-template-columns: var(--portrait-width-mid) minmax(0, 1fr);
    }
  }
  @media (max-width: 40.625rem) {
    .hello {
      grid-template-columns: var(--portrait-width-compact) minmax(0, 1fr);
      padding-top: var(--space-m);
      padding-bottom: var(--space-2xl);
      gap: var(--space-s) var(--space-l);
    }
    .copy {
      display: contents;
    }
    .greeting,
    .title,
    .welcome,
    .socials {
      grid-column: 1 / -1;
    }
    .hello :global(figure) {
      grid-row: 3;
      grid-column: 1;
    }
    .occupation {
      grid-row: 3;
      grid-column: 2;
    }
    .title {
      margin-top: var(--space-xs);
    }
    .socials {
      column-gap: var(--space-l);
      row-gap: var(--space-s);
    }
  }
</style>

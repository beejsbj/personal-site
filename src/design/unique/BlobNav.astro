---
/** Unique specimen: the v1 menu's unequal, offset circle constellation.
 * Geometry belongs here; color, shadow and timing belong to shared tokens.
 * Links work without JavaScript. The small runtime adds optional pointer play.
 */
interface Props {
  nav: { label: string; href: string; external?: boolean }[];
  currentPath: string;
  label?: string;
}
const { nav, currentPath, label = "Main navigation" } = Astro.props;
const items = [
  { label: "Home", href: "/" },
  ...["About", "Projects", "Lab"].flatMap((name) =>
    nav.filter((item) => item.label === name),
  ),
];
const current = (href: string) =>
  href === "/"
    ? currentPath === "/"
    : currentPath === href || currentPath.startsWith(href + "/");
---

<nav class="blob-nav" aria-label={label} data-blob-nav>
  <ul class="blob-nav__cluster">
    {items.map((item, index) => (
      <li class={`blob-nav__slot blob-nav__slot--${index + 1}`}>
        <a
          class="blob-nav__link"
          href={item.href}
          aria-current={current(item.href) ? "page" : undefined}
        >
          <span class="blob-nav__magnet">
            <span class="blob-nav__float">
              <span class="blob-nav__body">
                <span class="blob-nav__label">{item.label}</span>
              </span>
            </span>
          </span>
        </a>
      </li>
    ))}
  </ul>
  <button class="blob-nav__motion" type="button" aria-pressed="false" hidden>
    Pause motion
  </button>
</nav>

<script>
  import { installBlobNavigation } from "./blob-navigation";
  installBlobNavigation();
</script>

<style>
  .blob-nav {
    width: var(--blob-nav-width);
    max-width: 100%;
    flex-shrink: 0;
  }
  .blob-nav__cluster {
    position: relative;
    width: 100%;
    aspect-ratio: 1.08;
    list-style: none;
    margin: 0;
    padding: 0;
    isolation: isolate;
  }
  /* v1 offsets interpreted as a fixed constellation, not a regular nav grid.
     Room around each resting circle reserves travel and focus-ring space. */
  .blob-nav__slot {
    position: absolute;
    aspect-ratio: 1;
    --float-delay: 0s;
    --float-duration: var(--duration-blob-rest);
  }
  .blob-nav__slot--1 {
    width: 44%;
    left: 10%;
    top: 4%;
  }
  .blob-nav__slot--2 {
    width: 35%;
    left: 57%;
    top: 11%;
    --float-delay: -1.7s;
    --float-duration: calc(var(--duration-blob-rest) * 1.2);
  }
  .blob-nav__slot--3 {
    width: 40%;
    left: 1%;
    top: 47%;
    --float-delay: -3.1s;
    --float-duration: calc(var(--duration-blob-rest) * 1.4);
  }
  .blob-nav__slot--4 {
    width: 44%;
    left: 48%;
    top: 54%;
    --float-delay: -2.3s;
    --float-duration: calc(var(--duration-blob-rest) * 1.6);
  }
  .blob-nav__slot:focus-within {
    z-index: 2;
  }
  .blob-nav__link,
  .blob-nav__magnet,
  .blob-nav__float,
  .blob-nav__body {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-round);
  }
  .blob-nav__link {
    position: relative;
    color: var(--color-accent);
    text-decoration: none;
    outline: none;
    -webkit-tap-highlight-color: transparent;
  }
  .blob-nav__magnet {
    pointer-events: none;
  }
  .blob-nav__body {
    background: var(--color-surface-strong);
    box-shadow: var(--shadow-blob);
    transition:
      transform var(--duration-blob-feedback) var(--ease-blob-settle),
      background-color var(--duration-fast) var(--ease-feedback),
      color var(--duration-fast) var(--ease-feedback),
      box-shadow var(--duration-blob-feedback) var(--ease-feedback);
  }
  .blob-nav__label {
    display: block;
    font-size: var(--text-brand);
    line-height: var(--leading-tight);
  }
  .blob-nav__link[aria-current="page"] .blob-nav__body {
    background: var(--color-accent);
    color: var(--color-surface-strong);
    transform: scale(1.08);
  }
  .blob-nav__link:focus-visible .blob-nav__body {
    outline: var(--focus-width) solid var(--color-accent);
    outline-offset: var(--focus-offset);
    background: var(--color-accent-hover);
    color: var(--color-surface-strong);
  }
  .blob-nav__link:active .blob-nav__body {
    background: var(--color-accent-pressed);
    color: var(--color-surface-strong);
    transform: scale(var(--press-scale));
  }
  .blob-nav__motion {
    display: block;
    margin: var(--space-s) 0 0 auto;
    padding: var(--space-xs) var(--space-s);
    font: inherit;
    font-size: var(--text-xs);
    line-height: var(--leading-body);
    color: var(--color-text-soft);
    background: transparent;
    border: var(--rule-width) solid var(--color-border);
    border-radius: var(--radius-note);
    cursor: pointer;
  }
  .blob-nav__motion[hidden] {
    display: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .blob-nav__link:hover .blob-nav__body {
      background: var(--color-accent-hover);
      color: var(--color-surface-strong);
      box-shadow: var(--shadow-blob-raised);
    }
    .blob-nav__link:active .blob-nav__body,
    .blob-nav__link[aria-current="page"]:active .blob-nav__body {
      background: var(--color-accent-pressed);
    }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .blob-nav[data-motion="running"] .blob-nav__float {
      animation: blob-rest var(--float-duration) ease-in-out var(--float-delay)
        infinite;
    }
    .blob-nav:has(.blob-nav__link:focus-visible) .blob-nav__float {
      animation-play-state: paused;
    }
    .blob-nav__link:hover .blob-nav__body {
      transform: scale(1.06);
    }
    .blob-nav__link[aria-current="page"]:hover .blob-nav__body {
      transform: scale(1.12);
    }
    .blob-nav__link:active .blob-nav__body,
    .blob-nav__link[aria-current="page"]:active .blob-nav__body {
      transform: scale(var(--press-scale));
    }
  }
  @keyframes blob-rest {
    0%,
    100% {
      transform: translateY(-2%);
    }
    50% {
      transform: translateY(2%);
    }
  }
  @media (max-width: 40.625rem) {
    .blob-nav {
      width: var(--blob-nav-width-compact);
    }
    .blob-nav__label {
      font-size: var(--text-base);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .blob-nav__float {
      animation: none;
    }
    .blob-nav__body {
      transition: none;
    }
    .blob-nav__link:active .blob-nav__body {
      transform: none;
    }
    .blob-nav__link[aria-current="page"]:active .blob-nav__body {
      transform: scale(1.08);
    }
  }
  @media (forced-colors: active) {
    /* System colors keep the circles legible when shadows are suppressed. */
    .blob-nav__body {
      forced-color-adjust: none;
      background: Canvas;
      color: LinkText;
      border: var(--focus-width) solid LinkText;
      box-shadow: none;
    }
    .blob-nav__link[aria-current="page"] .blob-nav__body,
    .blob-nav__link:hover .blob-nav__body {
      background: Highlight;
      color: HighlightText;
      border-color: Highlight;
      box-shadow: none;
    }
    .blob-nav__link:focus-visible .blob-nav__body {
      outline-color: Highlight;
      background: Highlight;
      color: HighlightText;
      border-color: Highlight;
    }
    .blob-nav__link:active .blob-nav__body,
    .blob-nav__link[aria-current="page"]:active .blob-nav__body {
      background: LinkText;
      color: Canvas;
      border-color: LinkText;
    }
    .blob-nav__motion {
      border-color: ButtonText;
      color: ButtonText;
      background: ButtonFace;
    }
  }
</style>

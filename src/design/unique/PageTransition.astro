---
/** Unique: the page transition's cover and view-transition choreography.
 * The runtime (page-transition.ts) builds the cover only while a link
 * navigation is in flight; nothing renders at rest. */
---

<script>
  import { installPageTransition } from "./page-transition";
  installPageTransition();
</script>
<style is:global>
  /* Runtime geometry, written by page-transition.ts; these are the resting
     defaults (centre of the screen). */
  :root {
    --page-x: 50%;
    --page-y: 50%;
  }
  .page-cover {
    --page-ball-r: 0;
    --page-ball-size: auto;
    --page-ball-font: var(--text-lead);
    --cover-paint: var(--color-accent);
    --cover-ink: var(--color-accent-contrast);
    position: fixed;
    inset: 0;
    z-index: var(--layer-cover);
    pointer-events: auto;
    color: var(--cover-ink);
  }
  .page-cover[data-tone="peach"] {
    --cover-paint: var(--color-surface-strong);
    --cover-ink: var(--color-accent);
  }
  .page-cover__ball {
    position: absolute;
    top: var(--page-y);
    left: var(--page-x);
    display: grid;
    place-items: center;
    min-width: var(--page-ball-min);
    max-width: var(--page-ball-max);
    aspect-ratio: 1;
    padding: var(--space-s);
    border-radius: var(--radius-round);
    background: var(--cover-paint);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    translate: -50% -50%;
  }
  /* A ball link: the cover ball takes its exact size and serif label. */
  .page-cover[data-from="ball"] .page-cover__ball {
    width: var(--page-ball-size);
    min-width: 0;
    max-width: none;
    padding: 0;
    font-family: var(--font-serif);
    font-size: var(--page-ball-font);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-display);
    text-align: center;
    white-space: normal;
    overflow: visible;
    text-overflow: clip;
  }
  /* A pill or text link: the seed is its own painted pill, in place, in
     the paint the visitor was hovering, wearing its words; the cover is
     that same paint. No cap is needed: it is the link's real size. */
  .page-cover[data-from="pill"],
  .page-cover[data-from="text"] {
    --seed-t: 0;
    --seed-r: 0;
    --seed-b: 0;
    --seed-l: 0;
    --seed-radius: 0;
    --cover-paint: var(--ball-fill-hover);
    --cover-ink: var(--ball-ink);
  }
  .page-cover[data-from="pill"][data-tone="wine"] {
    --cover-paint: var(--ball-fill-current-hover);
    --cover-ink: var(--ball-ink-current);
  }
  .page-cover:is([data-from="pill"], [data-from="text"]) .page-cover__ball {
    inset: var(--seed-t) var(--seed-r) var(--seed-b) var(--seed-l);
    display: flex;
    align-items: center;
    justify-content: flex-start;
    box-sizing: border-box;
    min-width: 0;
    max-width: none;
    aspect-ratio: auto;
    padding-block: 0;
    border-radius: var(--radius-pill);
    overflow: visible;
    translate: none;
  }
  .page-cover:is([data-from="pill"], [data-from="text"]) .page-cover__ball > * {
    flex-shrink: 0;
  }
  .page-cover[data-from="text"] .page-cover__ball {
    padding-inline: 0;
  }
  .page-cover__sheet {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--cover-paint);
    clip-path: circle(0 at var(--page-x) var(--page-y));
  }
  .page-cover__title {
    max-width: var(--shell-width);
    font-family: var(--font-serif);
    font-size: var(--text-cover);
    font-weight: var(--weight-medium);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    text-align: center;
    text-wrap: balance;
    opacity: 0;
  }
  /* Choreography: the ball pops where you clicked (a ball, pill or text
     link is already there, so it only presses), swells over the page from
     that shape, and the name lands while it swells. */
  .page-cover {
    --after-pop: var(--duration-fast);
    --title-at: calc(var(--after-pop) + var(--duration-swell) / 2);
  }
  .page-cover__ball {
    animation:
      page-ball-pop var(--duration-fast) var(--ease-pop) backwards,
      page-ball-hush var(--duration-fast) linear var(--after-pop) forwards;
  }
  .page-cover[data-from="ball"] .page-cover__ball {
    animation:
      page-ball-press var(--duration-fast) var(--ease-feedback),
      page-ball-hush var(--duration-fast) linear var(--after-pop) forwards;
  }
  .page-cover:is([data-from="pill"], [data-from="text"]) .page-cover__ball {
    animation:
      page-ball-press var(--duration-fast) var(--ease-feedback),
      page-ball-hush var(--duration-fast) linear var(--after-pop) forwards;
  }
  .page-cover__sheet {
    animation: page-swell var(--duration-swell) var(--ease-swell)
      var(--after-pop) forwards;
  }
  /* The pill swells as a pill: each edge runs out past the screen while its
     ends stay round, so the shape the visitor clicked is the one that
     floods the page. */
  .page-cover:is([data-from="pill"], [data-from="text"]) .page-cover__sheet {
    animation-name: page-swell-pill;
  }
  .page-cover__title {
    animation: page-title-in var(--duration-hover) var(--ease-settle)
      var(--title-at) forwards;
  }
  @keyframes page-ball-pop {
    from {
      scale: 0;
    }
  }
  @keyframes page-ball-press {
    50% {
      scale: var(--press-scale);
    }
  }
  @keyframes page-ball-hush {
    to {
      color: transparent;
    }
  }
  @keyframes page-swell {
    from {
      clip-path: circle(var(--page-ball-r) at var(--page-x) var(--page-y));
    }
    to {
      clip-path: circle(var(--page-reach) at var(--page-x) var(--page-y));
    }
  }
  @keyframes page-swell-pill {
    from {
      clip-path: inset(
        var(--seed-t) var(--seed-r) var(--seed-b) var(--seed-l) round
          var(--seed-radius)
      );
    }
    to {
      clip-path: inset(
        calc(var(--page-reach) / -4) round calc(var(--page-reach) / 2)
      );
    }
  }
  @keyframes page-title-in {
    from {
      opacity: 0;
      translate: 0 var(--motion-rise);
    }
    to {
      opacity: 1;
      translate: none;
    }
  }
  /* Uncover: the old snapshot is the cover; it shrinks back into the spot
     it grew from while the new page waits, still, underneath. */
  @media (prefers-reduced-motion: no-preference) {
    html[data-page-cover]::view-transition-old(root) {
      z-index: 1;
      animation: page-uncover var(--duration-uncover) var(--ease-settle) both;
    }
    html[data-page-cover]::view-transition-new(root) {
      animation: none;
      mix-blend-mode: normal;
    }
  }
  @keyframes page-uncover {
    from {
      clip-path: circle(var(--page-reach) at var(--page-x) var(--page-y));
    }
    to {
      clip-path: circle(0 at var(--page-x) var(--page-y));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .page-cover {
      display: none;
    }
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none;
    }
  }
</style>

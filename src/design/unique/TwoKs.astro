---
/** Koffee & Kahwa's opening: two Ks, side by side, the first turns its back
 * and the two close into one chinar leaf. The paths are the café's mark as
 * its own generator drew it (saffron Kahwa K, walnut Koffee K, for cream
 * grounds); they are artwork, copied, never redrawn. One arrival, on a real
 * first visit only; reduced motion and a settled page show the leaf. */
import Inline from "../primitives/Inline.astro";

interface Props {
  line: string;
  caption: string;
}

const { line, caption } = Astro.props;
---

<figure class="two-ks">
  <svg
    class="two-ks__art"
    viewBox="-72 -114 144 182"
    aria-hidden="true"
    focusable="false"
  >
    <path
      class="two-ks__k two-ks__k--kahwa"
      d="M-1.30,9.57 L-1.30,37.00 L-1.30,38.00 L-1.30,66.00 L-4.70,66.00 L-4.70,38.00 L-19.30,38.00 L-19.30,28.50 L-19.30,7.00 L-21.70,7.00 L-21.70,31.02 L-22.74,32.12 L-53.08,35.62 L-40.37,7.85 L-22.27,-0.81 L-54.35,-15.82 L-70.88,-52.55 L-30.84,-48.18 L-21.70,-38.41 L-21.70,-11.00 L-19.30,-11.00 L-19.30,-35.85 L-19.30,-80.00 L-1.30,-112.00 L-1.30,-16.60 Z"
      fill="#E8A33D"></path>
    <path
      class="two-ks__k two-ks__k--koffee"
      d="M1.30,9.57 L1.30,37.00 L1.30,38.00 L1.30,66.00 L4.70,66.00 L4.70,38.00 L19.30,38.00 L19.30,28.50 L19.30,7.00 L21.70,7.00 L21.70,31.02 L22.74,32.12 L53.08,35.62 L40.37,7.85 L22.27,-0.81 L54.35,-15.82 L70.88,-52.55 L30.84,-48.18 L21.70,-38.41 L21.70,-11.00 L19.30,-11.00 L19.30,-35.85 L19.30,-80.00 L1.30,-112.00 L1.30,-16.60 Z"
      fill="#3B2418"></path>
  </svg>
  <figcaption class="two-ks__words">
    <h2 class="two-ks__line"><Inline text={line} links="plain" /></h2>
    <p class="two-ks__caption"><Inline text={caption} links="plain" /></p>
  </figcaption>
</figure>

<style>
  .two-ks {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
    justify-items: start;
    margin-top: var(--space-2xl);
    padding-block: var(--space-2xl);
    border-block: var(--rule-width) solid var(--color-border);
  }
  .two-ks__art {
    display: block;
    height: var(--kk-art-height);
    width: auto;
    overflow: visible;
    justify-self: center;
  }
  .two-ks__k {
    transform-box: fill-box;
    transform-origin: center;
  }
  .two-ks__words {
    display: grid;
    gap: var(--space-s);
    padding: 0;
  }
  .two-ks__line {
    margin: 0;
    font-size: var(--text-page);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }
  .two-ks__caption {
    max-width: 36ch;
    color: var(--color-text-soft);
    font-size: var(--text-lead);
  }
  @media (min-width: 40.626rem) {
    .two-ks {
      grid-template-columns: auto minmax(0, 1fr);
      gap: var(--space-4xl);
    }
    .two-ks__art {
      justify-self: start;
    }
  }
  /* Arrival only, not on a page that is already there (a prism face, or
     stepping in from the prism). The Kahwa K starts facing the same way as
     the Koffee K and both stand apart; it turns, then they close. */
  @media (prefers-reduced-motion: no-preference) {
    :global(:root:not([data-prism-settled])) .two-ks__k--kahwa {
      animation:
        kk-turn var(--duration-kk-turn) var(--ease-settle) var(--delay-kk)
          backwards,
        kk-join-kahwa var(--duration-kk-join) var(--ease-settle)
          calc(var(--delay-kk) + var(--duration-kk-turn)) backwards;
    }
    :global(:root:not([data-prism-settled])) .two-ks__k--koffee {
      animation: kk-join-koffee var(--duration-kk-join) var(--ease-settle)
        calc(var(--delay-kk) + var(--duration-kk-turn)) backwards;
    }
  }
  @keyframes kk-turn {
    from {
      scale: -1 1;
    }
    to {
      scale: 1 1;
    }
  }
  @keyframes kk-join-kahwa {
    from {
      translate: calc(-1 * var(--kk-apart)) 0;
    }
    to {
      translate: 0 0;
    }
  }
  @keyframes kk-join-koffee {
    from {
      translate: var(--kk-apart) 0;
    }
    to {
      translate: 0 0;
    }
  }
</style>

---
// Unique specimen: Burooj's photo, circular peach frame, personal caption.
import Link from "../primitives/Link.astro";
interface Props {
  src: string;
  alt: string;
  caption: string;
  href: string;
  [data: `data-${string}`]: string | undefined;
}
const { src, alt, caption, href, ...data } = Astro.props;
---

<figure {...data}>
  <img
    src={src}
    alt={alt}
    width="1080"
    height="1920"
    decoding="async"
    fetchpriority="high"
  />
  <figcaption>
    <Link href={href} arrow>
      {caption}
    </Link>
  </figcaption>
</figure>
<style>
  figure {
    margin: 0;
  }
  img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: var(--portrait-position);
    border: var(--portrait-border) solid var(--color-surface-strong);
    border-radius: var(--radius-round);
  }
  figcaption {
    padding: 0;
    font-size: var(--text-sm);
    margin-top: var(--space-s);
    text-align: center;
    color: var(--color-text-soft);
  }
  @media (max-width: 40.625rem) {
    figure {
      width: var(--portrait-width-compact);
    }
    img {
      width: var(--portrait-width-compact);
      border-width: var(--space-2xs);
      flex-shrink: 0;
    }
    figcaption {
      margin-top: var(--space-xs);
      white-space: nowrap;
    }
  }
</style>

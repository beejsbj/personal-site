---
// Unique specimen: Burooj's photo, circular peach frame, personal caption.
import Link from "../primitives/Link.astro";
---

<figure>
  <img
    src="/images/burooj4.jpg"
    alt="Burooj Rashid wearing round sunglasses"
    width="1080"
    height="1920"
    decoding="async"
    fetchpriority="high"
  />
  <figcaption>
    That's me.
    <br />
    <Link href="/about" arrow>
      A little more about me
    </Link>
  </figcaption>
</figure>
<style>
  figure {
    padding-top: var(--space-2xl);
    margin: 0;
  }
  img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: var(--portrait-position);
    border: var(--portrait-border) solid var(--color-surface-strong);
    border-radius: var(--radius-round);
  }
  figcaption {
    padding: 0;
    font-size: var(--text-xs);
    margin-top: var(--space-m);
    text-align: center;
    color: var(--color-text-soft);
  }
  @media (max-width: 40.625rem) {
    figure {
      display: flex;
      align-items: center;
      gap: var(--space-l);
      padding-top: var(--space-xs);
    }
    img {
      width: var(--portrait-width-compact);
      border-width: var(--space-2xs);
      flex-shrink: 0;
    }
    figcaption {
      text-align: left;
      margin: 0;
    }
  }
</style>

---
// Unique specimen: Burooj's photo, circular peach frame, personal caption.
// Arrival: the photo settles in and its ring breathes twice. A nearby fine
// pointer may tilt it through --tilt-x/--tilt-y (set by the homepage scene).
import Link from "../primitives/Link.astro";
---

<figure>
  <img
    src="/images/burooj4.jpg"
    alt="Burooj Rashid wearing round sunglasses"
    width="1080"
    height="1920"
    decoding="async"
    fetchpriority="high"
  />
  <figcaption>
    <Link href="/about" arrow>
      That's me
    </Link>
  </figcaption>
</figure>
<style>
  figure {
    position: relative;
    margin: 0;
  }
  img {
    --tilt-x: var(--motion-tilt);
    --tilt-y: var(--motion-tilt);
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: var(--portrait-position);
    border: var(--portrait-border) solid var(--color-surface-strong);
    border-radius: var(--radius-round);
    transform: perspective(var(--motion-perspective)) rotateX(var(--tilt-x))
      rotateY(var(--tilt-y));
  }
  /* Breathing ring: a second peach circle that swells and fades. */
  figure::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    aspect-ratio: 1;
    border: var(--portrait-border) solid var(--color-surface-strong);
    border-radius: var(--radius-round);
    opacity: 0;
    pointer-events: none;
  }
  figcaption {
    padding: 0;
    font-size: var(--text-sm);
    margin-top: var(--space-s);
    text-align: center;
    color: var(--color-text-soft);
  }
  @media (prefers-reduced-motion: no-preference) {
    img {
      animation: portrait-in var(--duration-settle) var(--ease-settle)
        var(--stagger) backwards;
      transition:
        transform var(--duration-hover) var(--ease-settle),
        translate var(--duration-hover) var(--ease-settle);
    }
    figure::before {
      animation: ring-breathe calc(var(--duration-settle) * 2) ease-out
        calc(var(--stagger) * 4) 2;
    }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    figure:hover img {
      translate: 0 calc(-1 * var(--motion-lift));
    }
    figure:hover::before {
      animation: ring-breathe calc(var(--duration-settle) * 2) ease-out infinite;
    }
  }
  @keyframes portrait-in {
    from {
      opacity: 0;
      transform: scale(var(--press-scale));
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes ring-breathe {
    from {
      opacity: var(--ring-opacity);
      transform: none;
    }
    to {
      opacity: 0;
      transform: scale(var(--ring-scale));
    }
  }
  @media (max-width: 40.625rem) {
    figure {
      width: var(--portrait-width-compact);
    }
    img {
      width: var(--portrait-width-compact);
      border-width: var(--space-2xs);
      flex-shrink: 0;
    }
    figure::before {
      border-width: var(--space-2xs);
    }
    figcaption {
      margin-top: var(--space-xs);
      white-space: nowrap;
    }
  }
</style>

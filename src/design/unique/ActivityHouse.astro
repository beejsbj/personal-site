---
import { buildHouseModel } from "../../lib/activity-house-model.mjs";
import {
  buildHouseScene,
  renderHouseMarkup,
  renderRoomDetail,
} from "../../lib/house-scene.mjs";

interface Props {
  catalog: unknown;
  projects: unknown[];
  events: unknown[];
  editorHref?: string;
  rehearsal?: boolean;
}

const { catalog, projects, events, editorHref, rehearsal = false } = Astro.props;
const input = { catalog, projects, events };
const model = buildHouseModel(input);
const scene = buildHouseScene(model);
const selected = scene.rooms[0];
const safeInput = JSON.stringify(input).replace(/</g, "\\u003c");
---

<section
  class="activity-house"
  data-activity-house
  data-busy={String(scene.busy)}
  data-rehearsal={rehearsal ? "available" : undefined}
>
  <header class="activity-house__heading">
    <p class="activity-house__eyebrow">What’s happening, drawn as a floorplan</p>
    <h1>Step into the house.</h1>
    <p class="activity-house__lead">
      Every room is a project or a corner of my life. When something is actually
      going on — an agent tinkering, a server digesting, a milestone landing —
      the lights come on and whoever is working turns up.
    </p>
    {
      (editorHref || rehearsal) && (
        <p class="activity-house__tools">
          {editorHref && <a href={editorHref}>Arrange the house</a>}
          {rehearsal && (
            <a href="?visitors=pretend" data-house-rehearse>
              Rehearse with pretend visitors
            </a>
          )}
        </p>
      )
    }
  </header>

  <p class="house-status" data-house-status role="status">{scene.status}</p>

  <div class="activity-house__body">
    <div
      class="house-building"
      data-house-building
      role="group"
      aria-label="Rooms of the house"
      set:html={renderHouseMarkup(scene, { selectedId: selected?.id })}
    />
    <aside
      class="house-detail"
      data-house-detail
      aria-label="Selected room"
      set:html={renderRoomDetail(selected)}
    />
  </div>

  <noscript>
    <section class="house-walk" aria-labelledby="house-walk-title">
      <h2 id="house-walk-title">Every room, in walking order</h2>
      {
        scene.rooms.map((room) => (
          <details>
            <summary>{room.title}</summary>
            <p>{room.summary}</p>
            {room.note && <p>Latest: {room.note.title}</p>}
            {room.href && room.href !== "/house" && (
              <a href={room.href}>Go to {room.title}</a>
            )}
          </details>
        ))
      }
    </section>
  </noscript>

  <script
    is:inline
    type="application/json"
    data-house-input
    set:html={safeInput}
  ></script>
</section>

<script>
  import { installActivityHouse } from "./activity-house";
  import { installLiveActivity } from "../../lib/live-activity";
  installActivityHouse();
  installLiveActivity();
</script>

<style is:global>
  /* Global because the same markup is redrawn in the browser from house-scene. */
  .activity-house {
    display: grid;
    gap: var(--space-m);
    width: var(--shell-width);
    max-width: var(--house-map-max);
    margin-inline: auto;
    padding-block: var(--space-xl) var(--space-3xl);
  }
  .activity-house__eyebrow,
  .house-detail__eyebrow {
    color: var(--house-ink-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-heading);
    text-transform: uppercase;
  }
  .activity-house__heading h1 {
    margin-top: var(--space-2xs);
  }
  .activity-house__lead {
    max-width: var(--intro-width);
    margin-top: var(--space-s);
    font-size: var(--text-lead);
  }
  .activity-house__tools {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    margin-top: var(--space-s);
    font-size: var(--text-sm);
  }
  .activity-house__tools a,
  .house-detail a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: var(--color-link-rule);
    text-underline-offset: var(--underline-offset);
  }

  .house-status {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
    font-family: var(--font-serif);
    font-size: var(--text-lead);
    font-style: italic;
    color: var(--color-text-soft);
  }
  .house-status::before {
    content: "";
    flex: none;
    inline-size: var(--space-xs);
    block-size: var(--space-xs);
    border: var(--rule-width) solid var(--color-accent);
    border-radius: var(--radius-round);
  }
  [data-busy="true"] > .house-status::before {
    background: var(--color-accent);
    animation: house-pulse var(--house-pulse-duration) ease-in-out infinite;
  }

  .activity-house__body {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }
  @media (min-width: 62.5rem) {
    .activity-house__body {
      grid-template-columns: minmax(0, 1fr) var(--house-inspector-width);
    }
    .house-detail {
      position: sticky;
      top: var(--space-l);
    }
  }

  /* ---------- The plan, from above ---------- */
  .house-building {
    display: grid;
    gap: var(--space-xs);
    padding-bottom: var(--house-mat-height);
  }
  .house-plan {
    display: grid;
    gap: var(--house-plan-wall);
    padding: var(--house-plan-outer);
    background: var(--color-text);
  }
  .house-plan__wing {
    display: flex;
    flex-wrap: wrap;
    gap: var(--house-plan-wall);
  }
  .house-plan__hall {
    display: grid;
    place-items: center;
    block-size: var(--house-hall-height);
    background-color: var(--house-wash-soft);
    background-image: var(--texture);
  }
  .house-plan__hall span,
  .house-entry__label,
  .house-plan__title {
    color: var(--house-ink-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-heading);
    text-transform: uppercase;
  }
  .house-plan__hall span {
    padding-inline: var(--space-l);
    border-block: var(--rule-width) dashed var(--color-border);
  }
  .house-plan__title {
    justify-self: start;
    font-weight: var(--weight-medium);
  }
  .house-plan__rug {
    stroke-dasharray: 2 2;
  }

  .house-room,
  .house-entry {
    --house-floor: var(--house-wash);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
    min-inline-size: 0;
    min-block-size: var(--house-room-height);
    padding: var(--house-room-pad);
    background-color: var(--house-floor);
    background-image: var(--texture);
    color: var(--color-text);
    text-align: start;
  }
  .house-room {
    flex: 1 1 var(--house-room-min);
    border: 0;
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-feedback);
  }
  .house-room[data-wide] {
    flex-basis: var(--house-room-wide);
  }
  .house-room[data-lit="true"] {
    --house-floor: var(--house-lit-wash);
    background-image: radial-gradient(
      circle at var(--space-l) var(--space-l),
      var(--house-glow),
      transparent 75%
    );
  }
  .house-room:hover {
    --house-floor: var(--color-hover);
  }
  .house-room[aria-pressed="true"] {
    outline: var(--house-focus-outline) solid var(--color-accent);
    outline-offset: calc(var(--house-focus-outline) * -2);
  }
  .house-room:focus-visible {
    outline: var(--house-focus-outline) dashed var(--color-accent);
    outline-offset: calc(var(--house-focus-outline) * -2);
  }

  /* A gap in the wall toward the hallway, with the door's swing drawn in. */
  .house-room__door,
  .house-entry__door {
    position: absolute;
    z-index: 1;
    inset-inline-end: var(--space-m);
    inline-size: var(--house-door-size);
    block-size: var(--house-plan-wall);
    background: var(--house-floor);
  }
  .house-room__door::after,
  .house-entry__door::after {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inline-size: 100%;
    aspect-ratio: 1;
    border-inline-start: var(--rule-width) solid var(--color-text-soft);
  }
  [data-wing="studios"] .house-room__door,
  .house-entry__door {
    bottom: calc(var(--house-plan-wall) * -1);
  }
  [data-wing="studios"] .house-room__door::after,
  .house-entry__door::after {
    bottom: 100%;
    border-block-start: var(--rule-width) dashed var(--color-border);
    border-inline-end: var(--rule-width) dashed var(--color-border);
    border-start-end-radius: 100%;
  }
  [data-wing="around"] .house-room__door {
    top: calc(var(--house-plan-wall) * -1);
  }
  [data-wing="around"] .house-room__door::after {
    top: 100%;
    border-block-end: var(--rule-width) dashed var(--color-border);
    border-inline-end: var(--rule-width) dashed var(--color-border);
    border-end-end-radius: 100%;
  }

  .house-room__label {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    column-gap: var(--space-xs);
    row-gap: var(--space-2xs);
    padding-inline-end: var(--house-door-size);
  }
  /* The plan symbol for a ceiling light: a circle with a cross through it. */
  .house-room__lamp {
    inline-size: var(--house-lamp-size);
    aspect-ratio: 1;
    border: var(--rule-width) solid var(--color-text-soft);
    border-radius: var(--radius-round);
    background:
      linear-gradient(45deg, transparent 46%, var(--color-text-soft) 46% 54%, transparent 54%),
      linear-gradient(-45deg, transparent 46%, var(--color-text-soft) 46% 54%, transparent 54%);
  }
  .house-room[data-lit="true"] .house-room__lamp {
    border-color: var(--color-text);
    background-color: var(--house-glow);
    box-shadow: 0 0 0 var(--space-2xs) var(--house-glow);
  }
  .house-room__label strong {
    color: var(--color-accent);
    font-family: var(--font-serif);
    font-size: var(--text-lead);
    font-weight: var(--weight-medium);
    line-height: var(--leading-heading);
  }
  .house-room__whisper {
    grid-column: 2;
    font-family: var(--font-serif);
    font-size: var(--text-sm);
    font-style: italic;
    line-height: var(--leading-tight);
  }
  .house-room__floor {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-around;
    gap: var(--space-s);
    inline-size: 100%;
    margin-block: auto;
  }
  .house-room__furniture {
    flex: none;
    inline-size: var(--house-furniture-width);
    fill: var(--house-wash-soft);
    stroke: var(--color-text-soft);
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .house-room__note {
    max-inline-size: min(var(--house-note-width), calc(100% - var(--house-door-size)));
    padding: var(--space-2xs) var(--space-xs);
    border: var(--rule-width) solid var(--color-border);
    background: var(--house-wash-soft);
    box-shadow: var(--rule-width) var(--rule-width) 0 var(--color-border);
    color: var(--color-text-soft);
    font-size: var(--text-xs);
    line-height: var(--leading-tight);
    rotate: var(--house-note-tilt);
  }
  .house-room__note > span {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }
  .house-room__note time {
    margin-inline-end: var(--space-2xs);
    color: var(--color-accent);
    font-weight: var(--weight-bold);
  }

  /* ---------- The front door and the mat outside it ---------- */
  .house-entry {
    flex: 1 1 var(--house-porch-width);
    align-items: center;
    justify-content: center;
  }
  .house-entry .house-room__door {
    top: calc(var(--house-plan-wall) * -1);
  }
  .house-entry__door {
    inset-inline: 0;
    margin-inline: auto;
    bottom: calc(var(--house-plan-outer) * -1);
    block-size: var(--house-plan-outer);
  }
  .house-entry__mat {
    position: absolute;
    top: calc(100% + var(--house-plan-outer) + var(--space-2xs));
    left: 50%;
    display: flex;
    align-items: center;
    gap: var(--space-s);
    min-inline-size: calc(var(--house-door-size) * 2);
    min-block-size: calc(var(--house-mat-height) - var(--space-xs));
    padding: var(--space-2xs) var(--space-xs);
    border: var(--rule-width) dashed var(--color-border);
    border-radius: var(--radius-note);
    translate: -50% 0;
    justify-content: center;
  }
  .house-entry__welcome {
    color: var(--color-text-soft);
    font-family: var(--font-serif);
    font-size: var(--text-sm);
    font-style: italic;
  }

  /* ---------- People, seen from above ---------- */
  .house-figure {
    display: inline-grid;
    justify-items: center;
    gap: var(--rule-width);
  }
  .house-figure svg {
    block-size: var(--house-figure-height);
    inline-size: auto;
    overflow: visible;
  }
  .house-figure__name {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    line-height: var(--leading-display);
  }
  .house-figure__head,
  .house-figure__body {
    fill: var(--house-wash-soft);
    stroke: var(--color-text);
    stroke-width: 1.4;
  }
  .house-figure__tool {
    fill: none;
    stroke: var(--color-text);
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .house-figure__prop {
    fill: var(--color-text);
    stroke: var(--color-text);
    stroke-width: 1;
  }
  .house-figure[data-figure="visitor"] .house-figure__body {
    fill: var(--color-accent);
    stroke: var(--color-accent-pressed);
  }
  .house-figure[data-figure="visitor"] .house-figure__prop {
    fill: var(--house-glow);
  }
  .house-figure[data-figure="visitor"] .house-figure__name {
    color: var(--color-accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .house-figure[data-figure="resident"] svg {
      animation: house-breathe calc(var(--house-motion-duration) / 2)
        ease-in-out infinite;
    }
    .house-figure[data-figure="visitor"] {
      animation: house-wander var(--house-motion-duration) ease-in-out infinite;
    }
    .house-figure:nth-child(odd) {
      animation-delay: calc(var(--house-motion-duration) / -2.7);
    }
    .house-figure:nth-child(3n) {
      animation-delay: calc(var(--house-motion-duration) / -1.6);
    }
    .house-figure[data-arriving] {
      animation:
        house-arrive var(--house-walk-in) ease-out both,
        house-wander var(--house-motion-duration) ease-in-out
          var(--house-walk-in) infinite;
    }
    [data-wing="around"] .house-figure[data-arriving] {
      animation-name: house-arrive-down, house-wander;
    }
  }

  /* ---------- The postcard ---------- */
  .house-detail {
    display: grid;
    gap: var(--space-s);
    padding: var(--space-l);
    border: var(--house-wall-width) solid var(--color-text);
    border-radius: var(--radius-note);
    background: var(--house-wash-soft);
    box-shadow: var(--house-wall-width) var(--house-wall-width) 0
      var(--color-text);
  }
  .house-detail h2 {
    font-size: var(--text-section);
  }
  .house-detail h2:focus {
    outline: none;
  }
  .house-detail h3 {
    margin-bottom: var(--space-2xs);
    font-size: var(--text-lead);
  }
  .house-detail section {
    padding-top: var(--space-s);
    border-top: var(--rule-width) solid var(--color-border);
  }
  .house-detail__summary,
  .house-detail__quiet {
    font-size: var(--text-copy);
  }
  .house-detail__quiet {
    color: var(--color-text-soft);
    font-style: italic;
  }
  .house-detail__visit {
    justify-self: start;
    font-size: var(--text-sm);
  }
  .house-detail__people,
  .house-detail__now,
  .house-detail__lately {
    display: grid;
    gap: var(--space-s);
    padding: 0;
    list-style: none;
  }
  .house-detail__people li {
    display: flex;
    align-items: flex-end;
    gap: var(--space-s);
  }
  .house-detail__people .house-figure__name {
    display: none;
  }
  .house-detail__people li > span:last-child,
  .house-detail__lately li,
  .house-detail__now li {
    display: grid;
    gap: var(--rule-width);
    font-size: var(--text-sm);
    line-height: var(--leading-tight);
  }
  .house-detail__role,
  .house-detail__lately time {
    color: var(--color-text-soft);
    font-size: var(--text-xs);
  }
  .house-detail__doing {
    font-family: var(--font-serif);
    font-style: italic;
  }
  .house-detail__lately span,
  .house-detail__now span {
    color: var(--color-text-soft);
  }

  .house-walk {
    display: grid;
    gap: var(--space-xs);
  }

  @keyframes house-breathe {
    50% {
      scale: 1.06;
    }
  }
  @keyframes house-wander {
    0%,
    100% {
      translate: 0 0;
    }
    30% {
      translate: calc(var(--house-motion-drift) / -2)
        calc(var(--house-motion-drift) / 3);
    }
    65% {
      translate: calc(var(--house-motion-drift) / 3)
        calc(var(--house-motion-drift) / -3);
    }
  }
  /* People walk in through the door from the hallway. */
  @keyframes house-arrive {
    from {
      translate: 0 var(--house-room-height);
      opacity: 0;
    }
  }
  @keyframes house-arrive-down {
    from {
      translate: 0 calc(var(--house-room-height) * -1);
      opacity: 0;
    }
  }
  @keyframes house-pulse {
    50% {
      opacity: 0.35;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-busy="true"] > .house-status::before {
      animation: none;
    }
  }
</style>

---
import { buildHouseModel } from "../../lib/activity-house-model.mjs";

interface Props {
  catalog: unknown;
  projects: unknown[];
  events: unknown[];
  editorHref?: string;
}

const { catalog, projects, events, editorHref } = Astro.props;
const input = { catalog, projects, events };
const model = buildHouseModel(input);
const safeInput = JSON.stringify(input).replace(/</g, "\\u003c");
const dateFor = (item: any) => item.observedAt ?? item.occurredAt ?? item.date;
const readableDate = (item: any) => {
  const date = new Date(dateFor(item));
  return Number.isFinite(date.getTime())
    ? new Intl.DateTimeFormat("en", {
        month: "short",
        day: "numeric",
        year: "numeric",
      }).format(date)
    : "Reviewed update";
};
const residentsFor = (roomId: string) =>
  model.residents.filter((resident: any) => resident.roomId === roomId);
const selected = model.rooms[0];
---

<section class="activity-house" data-activity-house>
  <header class="activity-house__heading">
    <p class="activity-house__eyebrow">A working floorplan</p>
    <div class="activity-house__heading-row">
      <div>
        <h1>Step into the house.</h1>
        <p>
          Projects, places, and the public traces they leave behind. Choose a
          room to look closer.
        </p>
      </div>
      {editorHref && (
        <a class="activity-house__arrange" href={editorHref}>
          Arrange the house
        </a>
      )}
    </div>
  </header>

  <div class="activity-house__controls" data-house-controls hidden>
    <label class="activity-house__search">
      <span>Find a room</span>
      <input
        type="search"
        data-house-search
        placeholder="Search the house"
        disabled
      />
    </label>
    <div class="activity-house__filters" role="group" aria-label="Filter rooms">
      <button
        type="button"
        data-house-filter="all"
        aria-pressed="true"
        disabled
      >
        All
      </button>
      <button
        type="button"
        data-house-filter="active"
        aria-pressed="false"
        disabled
      >
        Happening now
      </button>
      <button
        type="button"
        data-house-filter="project"
        aria-pressed="false"
        disabled
      >
        Projects
      </button>
      <button
        type="button"
        data-house-filter="place"
        aria-pressed="false"
        disabled
      >
        Places
      </button>
    </div>
  </div>

  <div class="activity-house__body">
    <div class="activity-house__plan-wrap">
      <p class="activity-house__status" data-house-status role="status">
        {model.rooms.some((room: any) => room.active)
          ? "Fresh postcards are in the house."
          : "No fresh postcards just now."}
      </p>
      <div
        class="activity-house__plan"
        data-house-plan
        aria-label="House floorplan"
      >
        {model.rooms.map((room: any, index: number) => (
          <button
            type="button"
            class="house-room"
            data-house-room={room.id}
            data-kind={room.kind}
            data-active={String(room.active)}
            aria-pressed={index === 0 ? "true" : "false"}
            disabled
          >
            <span class="house-room__door" aria-hidden="true"></span>
            <span
              class="house-room__art"
              data-furnishing={room.furnishing}
              aria-hidden="true"
            >
              <i></i>
              <i></i>
              <i></i>
            </span>
            <span class="house-room__kind">
              {room.kind === "place" ? "Place" : "Project"}
            </span>
            <strong>{room.title}</strong>
            <span class="house-room__latest">
              {room.events[0]
                ? `Reviewed: ${room.events[0].title}`
                : room.summary}
            </span>
            <span class="house-room__postcard">
              {room.active ? "Fresh postcard" : "No fresh postcard"}
            </span>
            {residentsFor(room.id).map((resident: any) => (
              <span class="house-resident">
                <span aria-hidden="true">{resident.name.slice(0, 1)}</span>
                {resident.name} · {resident.role}
              </span>
            ))}
            {room.occupants.map(
              (occupant: any) =>
                occupant.actor && (
                  <span class="house-occupant">
                    <span aria-hidden="true">
                      {occupant.actor.name.slice(0, 1)}
                    </span>
                    {occupant.actor.name} · {occupant.actor.role}
                  </span>
                ),
            )}
          </button>
        ))}
      </div>
      <p class="activity-house__plan-caption">
        A doorway means a room can be opened. An ink resident belongs here; a
        filled portrait appears only with a fresh postcard.
      </p>
    </div>

    <aside
      class="activity-house__inspector"
      data-house-inspector
      aria-label="Selected room"
    >
      {selected ? (
        <div data-house-inspector-content>
          <p class="activity-house__detail-eyebrow">
            {selected.kind === "place" ? "Place" : "Project"}
          </p>
          <h2>{selected.title}</h2>
          <p>{selected.summary}</p>
          {selected.href && <a href={selected.href}>Visit this room</a>}
          <section class="activity-house__inspector-section">
            <h3>Fresh postcards</h3>
            {selected.occupants.length ? (
              <ul>
                {selected.occupants.map((item: any) => (
                  <li>
                    {item.actor && (
                      <strong>
                        {item.actor.name} · {item.actor.role}:{" "}
                      </strong>
                    )}
                    <a href={item.href}>{item.title}</a>
                    <span>{item.summary}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p>No fresh postcard for this room.</p>
            )}
          </section>
          <section class="activity-house__inspector-section">
            <h3>Reviewed milestones</h3>
            {selected.events.length ? (
              <ol>
                {selected.events.map((item: any) => (
                  <li>
                    <time datetime={dateFor(item)}>{readableDate(item)}</time>
                    <a href={item.href}>{item.title}</a>
                    <span>{item.summary}</span>
                  </li>
                ))}
              </ol>
            ) : (
              <p>No reviewed milestones are displayed for this room yet.</p>
            )}
          </section>
        </div>
      ) : (
        <p data-house-inspector-content>There are no rooms to inspect yet.</p>
      )}
    </aside>
  </div>

  <section class="activity-house__list" aria-labelledby="house-list-title">
    <h2 id="house-list-title">Rooms in walking order</h2>
    <p>
      The room list stays available when the illustrated plan is not
      interactive.
    </p>
    <div data-house-list>
      {model.rooms.map((room: any) => (
        <details>
          <summary>{room.title}</summary>
          <p>{room.summary}</p>
          <p>
            {room.active
              ? "Fresh postcard in this room."
              : "No fresh postcard for this room."}
          </p>
          {room.href && <a href={room.href}>Visit this room</a>}
          {room.events.length > 0 && (
            <p>Latest reviewed milestone: {room.events[0].title}</p>
          )}
        </details>
      ))}
    </div>
  </section>

  <script
    is:inline
    type="application/json"
    data-house-input
    set:html={safeInput}
  ></script>
</section>

<script>
  import { installActivityHouse } from "./activity-house";
  import { installLiveActivity } from "../../lib/live-activity";
  installActivityHouse();
  installLiveActivity();
</script>

<style>
  .activity-house {
    display: grid;
    gap: var(--space-l);
    width: var(--shell-width);
    max-width: var(--house-map-max);
    margin-inline: auto;
    padding-block: var(--space-xl);
  }
  .activity-house__heading {
    display: grid;
    gap: var(--space-2xs);
  }
  .activity-house__eyebrow,
  .activity-house__detail-eyebrow,
  .house-room__kind {
    color: var(--house-ink-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-heading);
    text-transform: uppercase;
  }
  .activity-house__heading-row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-m);
  }
  .activity-house__heading h1 {
    margin-top: var(--space-2xs);
  }
  .activity-house__heading p:not(.activity-house__eyebrow) {
    max-width: var(--intro-width);
    margin-top: var(--space-s);
    font-size: var(--text-lead);
  }
  .activity-house__arrange {
    color: var(--color-accent);
    font-size: var(--text-sm);
    text-decoration: underline;
    text-decoration-color: var(--color-link-rule);
  }
  .activity-house__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: var(--space-s);
    border-block: var(--rule-width) solid var(--color-border);
  }
  .activity-house__controls[hidden] {
    display: none;
  }
  .activity-house__search {
    display: grid;
    gap: var(--space-2xs);
    color: var(--house-ink-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-heading);
    text-transform: uppercase;
  }
  .activity-house__search input {
    min-height: var(--control-min-height);
    min-width: var(--house-detail-min);
    padding-inline: var(--space-s);
    border: var(--rule-width) solid var(--color-text);
    background: var(--house-wash-soft);
    color: var(--color-text);
    font-size: var(--text-sm);
    letter-spacing: normal;
    text-transform: none;
  }
  .activity-house__filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }
  .activity-house__filters button {
    min-height: var(--control-min-height);
    padding-inline: var(--space-s);
    border: var(--rule-width) solid var(--color-text);
    background: var(--house-wash-soft);
    color: var(--color-text);
    font-size: var(--text-sm);
  }
  .activity-house__filters button[aria-pressed="true"] {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }
  .activity-house__body {
    display: grid;
    gap: var(--space-l);
    align-items: start;
  }
  .activity-house__status {
    color: var(--house-ink-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-s);
  }
  .activity-house__plan {
    position: relative;
    display: grid;
    grid-template-columns: repeat(
      auto-fit,
      minmax(min(100%, var(--house-detail-min)), 1fr)
    );
    gap: var(--space-s);
    padding: var(--space-xl);
    border: var(--house-wall-width) solid var(--color-text);
    background-color: var(--house-wash-soft);
    background-image: var(--texture);
    box-shadow: var(--house-wall-width) var(--house-wall-width)
      var(--color-text);
    isolation: isolate;
  }
  .activity-house__plan::before,
  .activity-house__plan::after {
    content: "";
    position: absolute;
    z-index: var(--layer-decoration);
    background: var(--house-wash);
  }
  .activity-house__plan::before {
    inset-block: var(--space-xl);
    inset-inline: calc(50% - var(--space-s));
    inline-size: var(--space-l);
  }
  .activity-house__plan::after {
    inset-inline: var(--space-xl);
    inset-block-start: calc(50% - var(--space-s));
    block-size: var(--space-l);
  }
  .house-room {
    position: relative;
    z-index: 1;
    display: grid;
    align-content: end;
    gap: var(--space-2xs);
    min-width: 0;
    min-block-size: var(--house-detail-min);
    padding: var(--house-room-pad);
    padding-block-end: calc(var(--house-room-pad) + var(--house-door-size));
    border: var(--house-wall-width) solid var(--color-text);
    background: var(--house-wash);
    color: var(--color-text);
    text-align: start;
    transition:
      transform var(--duration-fast) var(--ease-feedback),
      background-color var(--duration-fast) var(--ease-feedback);
  }
  .house-room[data-active="true"] {
    background: var(--color-surface-strong);
  }
  .house-room:focus-visible {
    outline: var(--house-focus-outline) solid var(--color-accent);
    outline-offset: var(--focus-offset);
  }
  .house-room[hidden] {
    display: none;
  }
  .house-room > strong {
    position: relative;
    z-index: 1;
    color: var(--color-accent);
    font-family: var(--font-serif);
    font-size: var(--text-card);
    font-weight: var(--weight-medium);
    line-height: var(--leading-heading);
  }
  .house-room__latest {
    position: relative;
    z-index: 1;
    color: var(--house-ink-muted);
    font-size: var(--text-xs);
  }
  .house-room__door {
    position: absolute;
    inset-block-end: calc(-1 * var(--house-wall-width));
    inset-inline-start: var(--space-l);
    inline-size: var(--house-door-size);
    block-size: var(--house-door-size);
    border-inline: var(--house-wall-width) solid var(--color-text);
    border-block-start: var(--house-wall-width) solid var(--color-text);
    border-radius: var(--radius-note) var(--radius-note) 0 0;
    background: var(--house-wash-soft);
  }
  .house-room__art {
    position: absolute;
    inset-block-start: var(--space-s);
    inset-inline-end: var(--space-s);
    display: block;
    inline-size: 48%;
    block-size: 34%;
    opacity: var(--disabled-opacity);
  }
  .house-room__art,
  .house-room__art i {
    border: var(--house-furnishing-line) solid var(--color-text);
  }
  .house-room__art i {
    position: absolute;
    display: block;
  }
  .house-room__art i:nth-child(1) {
    inset: var(--space-2xs);
  }
  .house-room__art i:nth-child(2) {
    inset-block-start: 20%;
    inset-inline-start: 70%;
    inline-size: 18%;
    block-size: 60%;
  }
  .house-room__art i:nth-child(3) {
    inset-block-end: 16%;
    inset-inline-start: 10%;
    inline-size: 48%;
    block-size: 16%;
  }
  .house-room__art[data-furnishing="shelves"] i {
    inline-size: 78%;
    block-size: var(--house-furnishing-line);
    border-inline: 0;
  }
  .house-room__art[data-furnishing="shelves"] i:nth-child(1) {
    inset-block-start: 22%;
  }
  .house-room__art[data-furnishing="shelves"] i:nth-child(2) {
    inset-block-start: 50%;
  }
  .house-room__art[data-furnishing="shelves"] i:nth-child(3) {
    inset-block-start: 78%;
  }
  .house-room__art[data-furnishing="table"] {
    border-radius: var(--radius-round);
    inline-size: 36%;
  }
  .house-room__art[data-furnishing="sofa"] {
    block-size: 24%;
    border-radius: var(--radius-note);
  }
  .house-room__art[data-furnishing="plants"] {
    border-radius: var(--radius-round);
    inline-size: 26%;
    block-size: 26%;
  }
  .house-room__postcard {
    position: relative;
    z-index: 1;
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
  }
  .house-resident,
  .house-occupant {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    width: max-content;
    max-width: 100%;
    color: var(--house-ink-muted);
    font-size: var(--text-xs);
  }
  .house-resident > span,
  .house-occupant > span {
    position: relative;
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    inline-size: var(--space-l);
    block-size: var(--space-l);
    border: var(--house-furnishing-line) solid var(--color-text);
    border-radius: var(--radius-round);
    font-family: var(--font-serif);
    color: var(--color-text);
  }
  .house-occupant > span {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }
  .house-resident > span::after,
  .house-occupant > span::after {
    content: "";
    position: absolute;
    inset-block-start: 72%;
    inset-inline-start: 15%;
    inline-size: 70%;
    block-size: 70%;
    border: var(--house-furnishing-line) solid var(--color-text);
    border-radius: var(--radius-note) var(--radius-note) 0 0;
    background: var(--house-wash);
    z-index: var(--layer-decoration);
  }
  .house-occupant > span::after {
    background: var(--color-accent);
  }
  .activity-house__inspector {
    min-block-size: var(--house-detail-min);
    padding: var(--house-room-pad);
    border-block: var(--house-wall-width) solid var(--color-text);
    background: var(--house-wash);
  }
  .activity-house__inspector h2 {
    margin-top: var(--space-2xs);
  }
  .activity-house__inspector > * > p:not(.activity-house__detail-eyebrow) {
    margin-top: var(--space-s);
  }
  .activity-house__inspector a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: var(--color-link-rule);
  }
  .activity-house__inspector-section {
    margin-top: var(--space-l);
    padding-top: var(--space-s);
    border-top: var(--rule-width) solid var(--color-border);
  }
  .activity-house__inspector-section h3 {
    font-size: var(--text-lead);
  }
  .activity-house__inspector-section ul,
  .activity-house__inspector-section ol {
    display: grid;
    gap: var(--space-s);
    margin-top: var(--space-s);
    list-style: none;
  }
  .activity-house__inspector-section li {
    display: grid;
    gap: var(--space-2xs);
    font-size: var(--text-sm);
  }
  .activity-house__inspector-section li span {
    color: var(--house-ink-muted);
  }
  .activity-house__inspector-section time {
    color: var(--house-ink-muted);
    font-size: var(--text-xs);
  }
  .activity-house__list {
    display: grid;
    gap: var(--space-s);
    padding-top: var(--space-l);
    border-top: var(--rule-width) solid var(--color-border);
  }
  .activity-house__list > p {
    color: var(--house-ink-muted);
  }
  .activity-house__list > div {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-s);
  }
  .activity-house__list details {
    padding: var(--space-s);
    border: var(--rule-width) solid var(--color-border);
    background: var(--house-wash-soft);
  }
  .activity-house__list summary {
    cursor: pointer;
    color: var(--color-accent);
    font-family: var(--font-serif);
    font-size: var(--text-lead);
  }
  .activity-house__list details p,
  .activity-house__list details a {
    display: block;
    margin-top: var(--space-s);
    font-size: var(--text-sm);
  }
  .activity-house__list details a {
    color: var(--color-accent);
    text-decoration: underline;
  }
  @media (hover: hover) and (pointer: fine) {
    .house-room:not(:disabled):hover {
      transform: translate(
        calc(-1 * var(--house-furnishing-line)),
        calc(-1 * var(--house-furnishing-line))
      );
      background: var(--color-hover);
    }
  }
  @media (min-width: 62.501rem) {
    .activity-house__body {
      grid-template-columns: minmax(0, 1fr) minmax(
          var(--house-detail-min),
          28%
        );
    }
  }
  @media (max-width: 40.625rem) {
    .activity-house {
      padding-block: var(--space-l);
    }
    .activity-house__heading-row {
      align-items: start;
    }
    .activity-house__search {
      width: 100%;
    }
    .activity-house__search input {
      min-width: 0;
      width: 100%;
    }
    .activity-house__plan {
      grid-template-columns: minmax(0, 1fr);
      padding: var(--space-m);
    }
    .activity-house__plan::before {
      inset-inline-start: calc(50% - var(--space-2xs));
      inline-size: var(--space-s);
    }
    .activity-house__plan::after {
      inset-block-start: calc(50% - var(--space-2xs));
      block-size: var(--space-s);
    }
    .house-room {
      min-block-size: 0;
    }
    .activity-house__list > div {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .house-room {
      transition: none;
    }
  }
</style>

<!-- Runtime redraws use DOM nodes, so these stay deliberately scoped to the house root. -->
<style is:global>
  .activity-house .house-room {
    position: relative;
    z-index: 1;
    display: grid;
    align-content: end;
    gap: var(--space-2xs);
    min-width: 0;
    min-block-size: var(--house-detail-min);
    padding: var(--house-room-pad);
    padding-block-end: calc(var(--house-room-pad) + var(--house-door-size));
    border: var(--house-wall-width) solid var(--color-text);
    background: var(--house-wash);
    color: var(--color-text);
    text-align: start;
    transition:
      transform var(--duration-fast) var(--ease-feedback),
      background-color var(--duration-fast) var(--ease-feedback);
  }
  .activity-house .house-room[data-active="true"] {
    background: var(--color-surface-strong);
  }
  .activity-house .house-room:focus-visible {
    outline: var(--house-focus-outline) solid var(--color-accent);
    outline-offset: var(--focus-offset);
  }
  .activity-house .house-room[hidden] {
    display: none;
  }
  .activity-house .house-room > strong {
    position: relative;
    z-index: 1;
    color: var(--color-accent);
    font-family: var(--font-serif);
    font-size: var(--text-card);
    font-weight: var(--weight-medium);
    line-height: var(--leading-heading);
  }
  .activity-house .house-room__latest {
    position: relative;
    z-index: 1;
    color: var(--house-ink-muted);
    font-size: var(--text-xs);
  }
  .activity-house .house-room__door {
    position: absolute;
    inset-block-end: calc(-1 * var(--house-wall-width));
    inset-inline-start: var(--space-l);
    inline-size: var(--house-door-size);
    block-size: var(--house-door-size);
    border-inline: var(--house-wall-width) solid var(--color-text);
    border-block-start: var(--house-wall-width) solid var(--color-text);
    border-radius: var(--radius-note) var(--radius-note) 0 0;
    background: var(--house-wash-soft);
  }
  .activity-house .house-room__art {
    position: absolute;
    inset-block-start: var(--space-s);

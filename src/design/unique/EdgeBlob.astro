---
/** Cropped v1 artwork with v1's job back: clicking the circle rolls the page
 * to the bottom, or back to the top. Its magnetic runtime
 * never intercepts clicks meant for content. */
---

<div class="edge-blob" data-magnetic-edge aria-hidden="true">
  <div class="edge-blob__hit">
    <span class="edge-blob__surface"></span>
  </div>
</div>
<script>
  import { installEdgeMagnet } from "./edge-magnet";
  installEdgeMagnet();
</script>
<style>
  .edge-blob {
    position: absolute;
    z-index: var(--layer-decoration);
    top: var(--edge-top);
    left: var(--edge-safe-left);
    width: var(--edge-width);
    height: var(--edge-height);
    pointer-events: none;
  }
  .edge-blob__hit,
  .edge-blob__surface {
    display: block;
    width: 100%;
    height: 100%;
  }
  .edge-blob__surface {
    border-radius: var(--radius-round);
    background: var(--color-accent);
  }
  @media (max-width: 40.625rem) {
    .edge-blob {
      top: var(--edge-top-compact);
      left: var(--edge-left-compact);
      height: var(--edge-height-compact);
    }
  }
  /* The circle's purpose: a click on it scrolls the page (edge-magnet.ts).
     While a fine pointer is over it, the page says so. */
  :global(html:has([data-magnetic-edge][data-aim])) {
    cursor: pointer;
  }
  @media (prefers-reduced-motion: reduce) {
    .edge-blob__surface {
      transition: none;
    }
  }
</style>

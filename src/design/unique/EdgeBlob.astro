---
/** Cropped v1 artwork. The shared magnetic runtime never intercepts clicks. */
---

<div class="edge-blob" data-magnetic-edge aria-hidden="true">
  <div class="edge-blob__hit">
    <span class="edge-blob__surface"></span>
  </div>
</div>
<style>
  .edge-blob {
    position: absolute;
    z-index: var(--layer-decoration);
    top: var(--edge-top);
    left: var(--edge-safe-left);
    width: var(--edge-width);
    height: var(--edge-height);
    pointer-events: none;
  }
  .edge-blob__hit,
  .edge-blob__surface {
    display: block;
    width: 100%;
    height: 100%;
  }
  .edge-blob__surface {
    border-radius: var(--radius-round);
    background: var(--color-accent);
  }
  @media (max-width: 40.625rem) {
    .edge-blob {
      top: var(--edge-top-compact);
      left: var(--edge-left-compact);
      height: var(--edge-height-compact);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .edge-blob__surface {
      transition: none;
    }
  }
</style>

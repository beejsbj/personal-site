---
import { getEntry } from "astro:content";
import { ClientRouter } from "astro:transitions";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import EdgeBlob from "../design/unique/EdgeBlob.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  pageClass?: string;
  noindex?: boolean;
  clientRouting?: boolean;
}

const siteEntry = await getEntry("site", "config");
if (!siteEntry) {
  throw new Error("Missing site config entry.");
}
const site = siteEntry.data;
const siteBaseUrl = "https://burooj.dev";
const {
  title = site.siteTitle,
  description = site.siteDescription,
  image = "/images/burooj4.jpg",
  pageClass = "page-default",
  noindex = false,
  clientRouting = true,
} = Astro.props;

const pageTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const canonicalUrl = new URL(Astro.url.pathname, siteBaseUrl).toString();
const socialImage = new URL(image, siteBaseUrl).toString();
---

<!doctype html>
<html lang="en" data-theme="default">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/images/circle.svg" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    {clientRouting && <ClientRouter />}
  </head>

  <body class={pageClass}>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <div class="site-frame">
      <EdgeBlob />
      <SiteHeader
        nav={site.nav}
        currentPath={Astro.url.pathname}
        email={site.email}
      />
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <SiteFooter email={site.email} />
    </div>
  </body>
</html>

---
import { getEntry } from "astro:content";
import { ClientRouter } from "astro:transitions";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import EdgeBlob from "../design/unique/EdgeBlob.astro";
import PageTransition from "../design/unique/PageTransition.astro";
import PeekingInitials from "../design/unique/PeekingInitials.astro";
import LensBoot from "../prism/LensBoot.astro";
import LensDecor from "../prism/LensDecor.astro";
import Prism from "../prism/Prism.astro";
import "../styles/global.css";
import "../prism/prism.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  pageClass?: string;
  noindex?: boolean;
  canonical?: string;
  clientRouting?: boolean;
  /** A tool page (/prism/harness, /prism/atlas): the site's chrome, but no
   * lens, prism or client router of its own, and never indexed. */
  tool?: boolean;
}

const siteEntry = await getEntry("site", "config");
if (!siteEntry) {
  throw new Error("Missing site config entry.");
}
const site = siteEntry.data;
const siteBaseUrl = "https://burooj.dev";
const {
  title = site.siteTitle,
  description = site.siteDescription,
  image = "/images/burooj4.jpg",
  pageClass = "page-default",
  canonical,
  tool = false,
  noindex = tool,
  clientRouting = !tool,
} = Astro.props;

const pageTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const canonicalUrl =
  canonical ?? new URL(Astro.url.pathname, siteBaseUrl).toString();
const socialImage = new URL(image, siteBaseUrl).toString();
---

<!doctype html>
<html lang="en" data-lens="daylight">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {!tool && <LensBoot />}
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/images/circle.svg" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    {clientRouting && <ClientRouter />}
  </head>

  <body class={pageClass}>
    <a class="skip-link" href="#main-content">
      {site.skipLink}
    </a>
    <div id="lens-shell" transition:persist="lens-shell"></div>
    <div class="site-frame">
      {!tool && <LensDecor />}
      {!tool && <EdgeBlob />}
      <SiteHeader site={site} currentPath={Astro.url.pathname} />
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <SiteFooter site={site} />
    </div>
    {clientRouting && <PageTransition />}
    {!tool && <PeekingInitials />}
    {!tool && <Prism />}
  </body>
</html>

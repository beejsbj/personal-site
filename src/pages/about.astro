---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { getTextPage } from "../lib/portfolio";
import { part } from "../prism/parts";

const page = await getTextPage("about");
const { Content } = await page.entry.render();
---

<BaseLayout
  title={page.title}
  description={page.description}
  pageClass="page-copy"
>
  <section class="shell page-section page-section--copy">
    <PageHeader {...page.header} page="about" />

    <article class="prose prose--copy" {...part("page.body", "about")}>
      <Content />
    </article>
  </section>
</BaseLayout>

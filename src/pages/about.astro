---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";

const entry = await getEntry("pages", "about");
if (!entry) {
  throw new Error("Missing about content entry.");
}
const { Content } = await entry.render();
---

<BaseLayout title={entry.data.title} description={entry.data.description} pageClass="page-copy">
  <section class="shell page-section page-section--copy">
    <PageHeader
      eyebrow="About"
      title="Frontend work with taste, motion, and some restraint."
      intro="I like sites that are clear enough to trust and lively enough to remember."
    />

    <article class="prose prose--copy">
      <Content />
    </article>
  </section>
</BaseLayout>

---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Link from "../design/primitives/Link.astro";

const entry = await getEntry("pages", "about");
if (!entry) {
  throw new Error("Missing about content entry.");
}
const { Content } = await entry.render();
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  pageClass="page-copy"
>
  <section class="shell page-section page-section--copy">
    <PageHeader
      eyebrow="About"
      title="Burooj, again!"
      intro="Frontend developer. Curious about people, stories, and the places we make on the web."
    >
      <div slot="actions">
        <Link href="/resume" arrow>
          Experience & resume
        </Link>
      </div>
    </PageHeader>

    <article class="prose prose--copy">
      <Content />
    </article>
  </section>
</BaseLayout>

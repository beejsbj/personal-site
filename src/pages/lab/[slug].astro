---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ExperimentPage from "../../components/ExperimentPage.astro";
import { getLab, getLabPage, labHasPage } from "../../lib/portfolio";

export async function getStaticPaths() {
  return (await getLab())
    .filter(labHasPage)
    .map((entry: CollectionEntry<"lab">) => ({
      params: { slug: entry.slug },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const labEntry = entry as CollectionEntry<"lab">;
const { slug, data } = labEntry;
const { Content } = await labEntry.render();
const { detail } = await getLabPage();
---

<BaseLayout
  title={data.title}
  description={data.summary}
  image={data.cover}
  pageClass="page-entry"
>
  <ExperimentPage slug={slug} experiment={data} copy={detail}>
    <Content />
  </ExperimentPage>
</BaseLayout>

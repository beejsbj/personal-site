---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Blocks from "../../components/Blocks.astro";
import ExperimentPage from "../../components/ExperimentPage.astro";
import { pageBody } from "../../lib/body";
import { experimentUpdates } from "../../lib/labbook";
import {
  getLab,
  getLabbook,
  getLabPage,
  getProjects,
  getSite,
  labHasPage,
} from "../../lib/portfolio";
import { graduatedProject } from "../../lib/rules";

export async function getStaticPaths() {
  return (await getLab())
    .filter(labHasPage)
    .map((entry: CollectionEntry<"lab">) => ({
      params: { slug: entry.slug },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const labEntry = entry as CollectionEntry<"lab">;
const { slug, data } = labEntry;
const [site, { detail, labbook: book }, labbook, projects, { blocks }] =
  await Promise.all([
    getSite(),
    getLabPage(),
    getLabbook(),
    getProjects(),
    pageBody(labEntry),
  ]);
const project = graduatedProject(data, projects);
---

<BaseLayout
  title={data.title}
  description={data.summary}
  image={data.cover}
  pageClass="page-entry"
>
  <ExperimentPage
    slug={slug}
    experiment={data}
    updates={experimentUpdates(labbook, slug)}
    graduatedTo={
      project && {
        title: project.data.title,
        href: `/projects/${project.slug}`,
      }
    }
    copy={detail}
    updateLabels={{ kinds: site.updateKinds, sources: site.updateSources }}
    redacted={book.redacted}
  >
    <Blocks blocks={blocks} slug={slug} copy={site.blocks} />
  </ExperimentPage>
</BaseLayout>

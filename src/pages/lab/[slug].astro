---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import MediaRail from "../../components/MediaRail.astro";
import Link from "../../design/primitives/Link.astro";
import { getLab, getLabPage, labHasPage } from "../../lib/portfolio";
import { part } from "../../prism/parts";

export async function getStaticPaths() {
  return (await getLab())
    .filter(labHasPage)
    .map((entry: CollectionEntry<"lab">) => ({
      params: { slug: entry.slug },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const labEntry = entry as CollectionEntry<"lab">;
const { slug, data } = labEntry;
const { Content } = await labEntry.render();
const { detail } = await getLabPage();
---

<BaseLayout
  title={data.title}
  description={data.summary}
  image={data.cover}
  pageClass="page-entry"
>
  <section class="shell entry-page">
    <PageHeader
      eyebrow={detail.eyebrow}
      title={data.title}
      intro={data.summary}
      marks={{
        title: part("lab.title", slug),
        intro: part("lab.summary", slug),
      }}
    />

    <div class="entry-page__meta" {...part("lab.meta", slug)}>
      <div>
        <span class="entry-page__label">{detail.labels.type}</span>
        <p>{data.type}</p>
      </div>
      <div>
        <span class="entry-page__label">{detail.labels.era}</span>
        <p>{data.sourceEra}</p>
      </div>
    </div>

    {data.links.length > 0 && (
      <div class="entry-page__links" {...part("lab.links", slug)}>
        {data.links.map((link: { label: string; url: string }) => (
          <Link treatment="action" href={link.url} newTab>
            {link.label}
          </Link>
        ))}
      </div>
    )}

    <MediaRail media={data.media} {...part("lab.media", slug)} />

    <article class="prose" {...part("lab.body", slug)}>
      <Content />
    </article>
  </section>
</BaseLayout>

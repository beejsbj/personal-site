---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import LabCard from "../../components/LabCard.astro";
import Inline from "../../design/primitives/Inline.astro";
import Link from "../../design/primitives/Link.astro";
import { getLab, getLabPage, labDetail } from "../../lib/portfolio";
import { part } from "../../prism/parts";

const page = await getLabPage();
const entries = await getLab();
---

<BaseLayout
  title={page.title}
  description={page.description}
  pageClass="page-lab"
>
  <section class="shell page-section page-section--header">
    <PageHeader {...page.header} page="lab" />
  </section>
  <section class="shell page-section" aria-label={page.listLabel}>
    <div class="lab-grid lab-grid--dense">
      {entries.map((entry) => (
        <LabCard
          slug={entry.slug}
          href={labDetail(entry)}
          title={entry.data.title}
          summary={entry.data.summary}
          type={entry.data.type}
          sourceEra={entry.data.sourceEra}
          cover={entry.data.cover}
        />
      ))}
    </div>
    <p class="lab-more" {...part("lab.more")}>
      <Link href={page.more.href} arrow>
        {page.more.label}
      </Link>
    </p>
    <p class="lab-aside" {...part("lab.aside")}><Inline text={page.aside} /></p>
  </section>
</BaseLayout>
<style>
  .lab-more {
    margin-top: var(--space-2xl);
  }
  .lab-aside {
    margin-top: var(--space-m);
    max-width: var(--reading-width);
    font-size: var(--text-copy);
    color: var(--color-text-soft);
  }
</style>

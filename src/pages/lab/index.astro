---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LabRoom from "../../components/LabRoom.astro";
import { getLab, getLabPage, labDetail } from "../../lib/portfolio";

const page = await getLabPage();
const entries = (await getLab()).map((entry) => ({
  ...entry.data,
  slug: entry.slug,
  detail: labDetail(entry),
}));
---

<BaseLayout
  title={page.title}
  description={page.description}
  pageClass="page-lab"
>
  <LabRoom page={page} entries={entries} />
</BaseLayout>

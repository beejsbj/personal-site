---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Homepage from "../components/Homepage.astro";
import { getFeatured, getHome, getSite, updateId } from "../lib/portfolio";

const home = await getHome();
const site = await getSite();

// Featured by the shared rule (src/lib/rules.ts), as many as home.md asks.
const featuredProjects = (await getFeatured()).slice(0, home.work.limit);

// The shared stream filters eligibility before applying its display limit.
const recentUpdates: CollectionEntry<"updates">[] = await getCollection("updates");

const homepageData = {
  home,
  projects: featuredProjects.map((project) => ({
    ...project.data,
    slug: project.slug,
    href: `/projects/${project.slug}`,
  })),
  updates: recentUpdates.map((update) => ({ ...update.data, id: updateId(update) })),
  labels: { kinds: site.updateKinds, sources: site.updateSources },
};
---

<BaseLayout
  title={home.title}
  description={home.description}
  image={home.hero.portrait.src}
  pageClass="page-warm-home"
>
  <Homepage {...homepageData} />
</BaseLayout>

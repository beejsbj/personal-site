---
import { getCollection, getEntry } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Homepage from "../components/Homepage.astro";
import { generatedActivity } from "../lib/generated-activity";

const homeEntry = await getEntry("pages", "home");
if (!homeEntry) {
  throw new Error("Missing home content entry.");
}

const siteEntry = await getEntry("site", "config");
if (!siteEntry) {
  throw new Error("Missing site config entry.");
}
const site = siteEntry.data;

const featuredProjects: CollectionEntry<"projects">[] = (
  await getCollection("projects")
)
  .filter(
    (entry: CollectionEntry<"projects">) =>
      !entry.data.hidden && entry.data.featured,
  )
  .sort(
    (left: CollectionEntry<"projects">, right: CollectionEntry<"projects">) =>
      left.data.order - right.data.order,
  )
  .slice(0, 3);

// The shared stream filters eligibility before applying its display limit.
const recentUpdates: CollectionEntry<"updates">[] =
  await getCollection("updates");

const homepageData = {
  site,
  projects: featuredProjects.map((project) => ({
    ...project.data,
    href: `/projects/${project.slug}`,
  })),
  updates: [
    ...recentUpdates.map((update) => update.data),
    ...generatedActivity,
  ],
};
---

<BaseLayout
  title={homeEntry.data.title}
  description={homeEntry.data.description}
  image="/images/burooj4.jpg"
  pageClass="page-warm-home"
>
  <Homepage {...homepageData} />
</BaseLayout>

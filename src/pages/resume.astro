---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";

const entry = await getEntry("pages", "resume");
if (!entry) {
  throw new Error("Missing resume content entry.");
}
const { Content } = await entry.render();
---

<BaseLayout title={entry.data.title} description={entry.data.description} pageClass="page-copy">
  <section class="shell page-section page-section--copy">
    <PageHeader
      eyebrow="Resume"
      title="A concise view of the work behind the portfolio."
      intro="Frontend roles, freelance work, and the threads that led into this rebuild."
    />

    <article class="prose prose--copy">
      <Content />
    </article>
  </section>
</BaseLayout>

---
// The resume lives under About now. Vercel redirects /resume before it
// gets here; this keeps the old address working wherever the app answers
// it directly (dev, the built handler), query string and all.
import { getLegacyRedirect } from "../lib/legacyRedirects";
export const prerender = false;
return Astro.redirect(getLegacyRedirect(Astro.url) ?? "/about/resume", 301);
---

---
/** Daylight's side of the fuzz harness for the Lab itself: the room on
 * fixture experiments, with a fixture Labbook, so every state can be seen
 * and tested whatever src/content holds. /prism/fixtures/lab is a full
 * room; ?fixture=shelf-only has nothing on the Bench,
 * ?fixture=no-covers has no pictures and ?fixture=no-featured gives no
 * experiment pride of place. ?labbook=none is a Lab with no updates. scripts/tests/lab-daylight.browser.mjs and
 * labbook-daylight.browser.mjs read it. Rendered on demand: its page
 * entries point at /lab/<slug>, where nothing is built. */
import type { ComponentProps } from "astro/types";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import LabRoom from "../../../../components/LabRoom.astro";
import Labbook from "../../../../components/Labbook.astro";
import { penUser } from "../../../../lib/labbook";
import { getLabPage, getRelatable, getSite } from "../../../../lib/portfolio";
import { labbookFixture } from "../../../../prism/labbook-fixture";

export const prerender = false;

const [page, site, relatable] = await Promise.all([
  getLabPage(),
  getSite(),
  getRelatable(),
]);
type Entries = ComponentProps<typeof LabRoom>["entries"];
const room: Entries = [
  {
    slug: "fixture-linkout",
    detail: "https://example.com/fixture-linkout",
    title: "A sketch that lives elsewhere",
    summary: "It opens where it lives, in another place on the web.",
    place: "bench",
    cover: "/images/lab/motion-path-graph.svg",
    order: 1,
  },
  {
    slug: "fixture-bare",
    detail: "/lab/fixture-bare",
    title: "A try with nothing to show yet",
    summary: "No picture: only what it is about.",
    place: "bench",
    order: 2,
  },
  {
    slug: "fixture-featured",
    detail: "/lab/fixture-featured",
    title: "The one with pride of place",
    summary:
      "The featured experiment leads the Bench and gets more room, though its order comes last. It has a page of its own telling how it was made.",
    place: "bench",
    featured: true,
    cover: "/images/lab/beating-shapes.png",
    order: 9,
  },
  {
    slug: "fixture-note",
    detail: "https://example.com/fixture-note",
    title: "A link out with no picture",
    summary: "It lives elsewhere too, and has only its words here.",
    place: "bench",
    order: 3,
  },
  {
    slug: "fixture-quiet",
    detail: "https://example.com/fixture-quiet",
    title: "An old sketch, gone quiet",
    summary: "On the Shelf, and still opening where it always lived.",
    place: "shelf",
    cover: "/images/lab/beating-shapes.png",
    order: 2,
  },
  {
    slug: "fixture-archive",
    detail: "/lab/fixture-archive",
    title: "An archive piece with a page",
    summary: "On the Shelf, with its making told on a page here.",
    place: "shelf",
    cover: "/images/lab/motion-path-graph.svg",
    order: 1,
  },
  {
    slug: "fixture-plain",
    detail: "/lab/fixture-plain",
    title: "A shelf piece with only words",
    summary: "No picture here either.",
    place: "shelf",
    order: 3,
  },
];
const fixtures: Record<string, Entries> = {
  room,
  "shelf-only": room.filter((entry) => entry.place === "shelf"),
  "no-covers": room.map((entry) => ({ ...entry, cover: undefined })),
  "no-featured": room.map((entry) => ({ ...entry, featured: undefined })),
};
const asked = Astro.url.searchParams;
const entries = fixtures[asked.get("fixture") ?? "room"];
if (!entries) return new Response("No such fixture.", { status: 404 });

// The fixture Labbook is about two experiments in the room (one that lives
// elsewhere, one with a page) and the first real project.
const written = labbookFixture({
  experiments: ["fixture-quiet", "fixture-featured"],
  project: relatable.projects[0]?.slug,
});
const labbook = asked.get("labbook") === "none" ? [] : written.labbook;
---

<BaseLayout title="Lab fixture" pageClass="page-lab" tool>
  <LabRoom page={page} entries={entries}>
    <Labbook
      slot="labbook"
      class="shell page-section"
      updates={labbook}
      copy={page.labbook}
      labels={{ kinds: site.updateKinds, sources: site.updateSources }}
      shown={{ ...relatable, lab: room }}
      penUser={penUser(site)}
    />
  </LabRoom>
</BaseLayout>

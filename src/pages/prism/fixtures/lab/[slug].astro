---
/** Daylight's side of the fuzz harness: an experiment's own page, on a
 * fixture experiment (src/prism/fixtures.ts). /prism/harness shows the same
 * fixtures to the shells; Daylight is rendered on the server, so its page
 * is built here. scripts/tests/lab-entry.browser.mjs reads it. */
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import ExperimentPage from "../../../../components/ExperimentPage.astro";
import { experimentUpdates } from "../../../../lib/labbook";
import { getLabPage, getProjects, getSite } from "../../../../lib/portfolio";
import { graduatedProject } from "../../../../lib/rules";
import {
  experimentFixtures,
  type ExperimentFixture,
} from "../../../../prism/fixtures";

type Target = { slug: string; title: string; href: string };

export async function getStaticPaths() {
  const projects: Target[] = (await getProjects()).map((project) => ({
    slug: project.slug,
    title: project.data.title,
    href: `/projects/${project.slug}`,
  }));
  return experimentFixtures(projects).map((fixture) => ({
    params: { slug: fixture.entry.slug },
    props: { fixture, projects },
  }));
}

const { fixture, projects } = Astro.props as {
  fixture: ExperimentFixture;
  projects: Target[];
};
const { entry, labbook } = fixture;
const [site, { detail, labbook: book }] = await Promise.all([getSite(), getLabPage()]);
---

<BaseLayout
  title={entry.title}
  description={entry.summary}
  image={entry.cover}
  pageClass="page-entry"
  tool
>
  <ExperimentPage
    slug={entry.slug}
    experiment={entry}
    updates={experimentUpdates(labbook, entry.slug)}
    graduatedTo={graduatedProject(entry, projects)}
    copy={detail}
    updateLabels={{ kinds: site.updateKinds, sources: site.updateSources }}
    redacted={book.redacted}
  >
    <Fragment set:html={entry.html} />
  </ExperimentPage>
</BaseLayout>

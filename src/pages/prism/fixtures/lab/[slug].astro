---
/** Daylight's side of the fuzz harness: an experiment's own page, on a
 * fixture experiment: one built in src/prism/fixtures.ts, or one written
 * as a real experiment is, in src/content/fixtures. /prism/harness shows
 * the same fixtures to the shells; Daylight is rendered on the server, so
 * its page is built here. scripts/tests/lab-entry.browser.mjs and
 * blocks.browser.mjs read it. */
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Blocks from "../../../../components/Blocks.astro";
import ExperimentPage from "../../../../components/ExperimentPage.astro";
import { labPayload } from "../../../../lib/body";
import { experimentUpdates } from "../../../../lib/labbook";
import { getLabPage, getProjects, getSite } from "../../../../lib/portfolio";
import { graduatedProject } from "../../../../lib/rules";
import {
  experimentFixtures,
  type ExperimentFixture,
} from "../../../../prism/fixtures";

type Target = { slug: string; title: string; href: string };

export async function getStaticPaths() {
  const projects: Target[] = (await getProjects()).map((project) => ({
    slug: project.slug,
    title: project.data.title,
    href: `/projects/${project.slug}`,
  }));
  const written: ExperimentFixture[] = await Promise.all(
    (await getCollection("fixtures")).map(
      async (entry: CollectionEntry<"fixtures">) => ({
        entry: await labPayload(entry),
        labbook: [],
      }),
    ),
  );
  return [...experimentFixtures(projects), ...written].map((fixture) => ({
    params: { slug: fixture.entry.slug },
    props: { fixture, projects },
  }));
}

const { fixture, projects } = Astro.props as {
  fixture: ExperimentFixture;
  projects: Target[];
};
const { entry, labbook } = fixture;
const [site, { detail, labbook: book }] = await Promise.all([
  getSite(),
  getLabPage(),
]);
---

<BaseLayout
  title={entry.title}
  description={entry.summary}
  image={entry.cover}
  pageClass="page-entry"
  tool
>
  <ExperimentPage
    slug={entry.slug}
    experiment={entry}
    updates={experimentUpdates(labbook, entry.slug)}
    graduatedTo={graduatedProject(entry, projects)}
    copy={detail}
    updateLabels={{ kinds: site.updateKinds, sources: site.updateSources }}
    redacted={book.redacted}
  >
    <Blocks
      blocks={entry.blocks}
      slug={entry.slug}
      copy={site.blocks}
      arranged
    />
  </ExperimentPage>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not Found" description="This page does not exist." pageClass="page-copy">
  <section class="shell page-section page-section--copy">
    <p class="section-intro__eyebrow">404</p>
    <h1 class="section-intro__title">That page wandered off.</h1>
    <p class="section-intro__intro">
      The good news is the rebuilt site is much smaller, so getting back on track is easier too.
    </p>
    <a class="button button--solid" href="/">Return home</a>
  </section>
</BaseLayout>

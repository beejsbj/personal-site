---
import BaseLayout from "../layouts/BaseLayout.astro";
import Heading from "../design/primitives/Heading.astro";
import Link from "../design/primitives/Link.astro";
---

<BaseLayout
  title="Not Found"
  description="This page does not exist."
  pageClass="page-copy"
>
  <section class="shell page-section page-section--copy">
    <p class="section-intro__eyebrow">404</p>
    <Heading level={1} scale="page">
      That page wandered off.
    </Heading>
    <p class="section-intro__intro">
      Try the homepage, or follow one of the links above.
    </p>
    <div>
      <Link treatment="action" tone="wine" href="/">
        Return home
      </Link>
    </div>
  </section>
</BaseLayout>

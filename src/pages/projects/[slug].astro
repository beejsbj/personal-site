---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import MediaRail from "../../components/MediaRail.astro";
import ProjectJourney from "../../components/ProjectJourney.astro";
import TwoKs from "../../design/unique/TwoKs.astro";
import Link from "../../design/primitives/Link.astro";
import TagList from "../../design/primitives/TagList.astro";
import { getProjects, getProjectsPage } from "../../lib/portfolio";
import { part } from "../../prism/parts";

export async function getStaticPaths() {
  return (await getProjects()).map((entry: CollectionEntry<"projects">) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const projectEntry = entry as CollectionEntry<"projects">;
const { slug, data } = projectEntry;
const { Content } = await projectEntry.render();
const { detail } = await getProjectsPage();
// A journey opens on the finished thing: its first picture, full width,
// before any words about it.
type Media = CollectionEntry<"projects">["data"]["media"][number];
const hero = data.journey
  ? data.media.find((item: Media) => item.type === "image")
  : undefined;
const heroSmall = hero?.src.replace(/\.\w+$/, "-800.webp");
---

<BaseLayout
  title={data.title}
  description={data.summary}
  image={data.cover}
  pageClass="page-entry"
>
  <section class="shell entry-page">
    <PageHeader
      eyebrow={data.kind}
      title={data.title}
      intro={data.summary}
      marks={{
        title: part("project.title", slug),
        intro: part("project.summary", slug),
      }}
    />

    {hero && (
      <figure class="entry-hero" {...part("project.media", slug)}>
        <img
          src={hero.src}
          srcset={hero.width && hero.width > 1000 ? `${heroSmall} 800w, ${hero.src} ${hero.width}w` : undefined}
          sizes="(min-width: 71.25rem) 71.25rem, 92vw"
          alt={hero.alt ?? ""}
          width={hero.width}
          height={hero.height}
          fetchpriority="high"
          decoding="async"
        />
        {hero.caption && <figcaption>{hero.caption}</figcaption>}
      </figure>
    )}

    <div class="entry-page__meta" {...part("project.meta", slug)}>
      <div>
        <span class="entry-page__label">{detail.labels.role}</span>
        <p>{data.role}</p>
      </div>
      <div>
        <span class="entry-page__label">{detail.labels.location}</span>
        <p>{data.location}</p>
      </div>
      <div>
        <span class="entry-page__label">{detail.labels.date}</span>
        <p>{data.dateLabel}</p>
      </div>
    </div>

    {data.links.length > 0 && (
      <div class="entry-page__links" {...part("project.links", slug)}>
        {data.links.map((link: { label: string; url: string }) => (
          <Link treatment="pill" href={link.url} arrow newTab>
            {link.label}
          </Link>
        ))}
      </div>
    )}

    <TagList items={data.tools} label={`${data.title} tools`} {...part("project.tools", slug)} />

    {data.journey ? (
      data.journey.opening?.art === "two-ks" && (
        <TwoKs
          line={data.journey.opening.line}
          caption={data.journey.opening.caption}
        />
      )
    ) : (
      <MediaRail media={data.media} {...part("project.media", slug)} />
    )}

    {data.journey ? (
      <div class="entry-page__story" {...part("project.body", slug)}>
        <article class="prose">
          <Content />
        </article>
        <ProjectJourney journey={data.journey} labels={detail.labels} />
      </div>
    ) : (
      <article class="prose" {...part("project.body", slug)}>
        <Content />
      </article>
    )}
    <div class="entry-page__links">
      <Link href={detail.back.href} treatment="pill" arrow>
        {detail.back.label}
      </Link>
    </div>
  </section>
</BaseLayout>

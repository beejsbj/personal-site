---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import MediaRail from "../../components/MediaRail.astro";
import Link from "../../design/primitives/Link.astro";
import TagList from "../../design/primitives/TagList.astro";

export async function getStaticPaths() {
  const entries = (await getCollection("projects")).filter(
    (entry: CollectionEntry<"projects">) => !entry.data.hidden,
  );
  return entries.map((entry: CollectionEntry<"projects">) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const projectEntry = entry as CollectionEntry<"projects">;
const { Content } = await projectEntry.render();
---

<BaseLayout
  title={projectEntry.data.title}
  description={projectEntry.data.summary}
  image={projectEntry.data.cover}
  pageClass="page-entry"
>
  <section class="shell entry-page">
    <PageHeader
      eyebrow="Project"
      title={projectEntry.data.title}
      intro={projectEntry.data.summary}
    />

    <div class="entry-page__meta">
      <div>
        <span class="entry-page__label">Role</span>
        <p>{projectEntry.data.role}</p>
      </div>
      <div>
        <span class="entry-page__label">Where</span>
        <p>{projectEntry.data.location}</p>
      </div>
      <div>
        <span class="entry-page__label">When</span>
        <p>{projectEntry.data.dateLabel}</p>
      </div>
    </div>

    {projectEntry.data.links.length > 0 && (
      <div class="entry-page__links">
        {projectEntry.data.links.map((link: { label: string; url: string }) => (
          <Link treatment="action" href={link.url} newTab>
            {link.label}
          </Link>
        ))}
      </div>
    )}

    <TagList
      items={projectEntry.data.tools}
      label={`${projectEntry.data.title} tools`}
    />

    <MediaRail media={projectEntry.data.media} />

    <article class="prose">
      <Content />
    </article>
  </section>
</BaseLayout>

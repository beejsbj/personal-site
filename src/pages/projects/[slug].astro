---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import MediaRail from "../../components/MediaRail.astro";
import Link from "../../design/primitives/Link.astro";
import TagList from "../../design/primitives/TagList.astro";
import { getProjects, getProjectsPage } from "../../lib/portfolio";
import { part } from "../../prism/parts";

export async function getStaticPaths() {
  return (await getProjects()).map((entry: CollectionEntry<"projects">) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const projectEntry = entry as CollectionEntry<"projects">;
const { slug, data } = projectEntry;
const { Content } = await projectEntry.render();
const { detail } = await getProjectsPage();
---

<BaseLayout
  title={data.title}
  description={data.summary}
  image={data.cover}
  pageClass="page-entry"
>
  <section class="shell entry-page">
    <PageHeader
      eyebrow={data.kind}
      title={data.title}
      intro={data.summary}
      marks={{
        title: part("project.title", slug),
        intro: part("project.summary", slug),
      }}
    />

    <div class="entry-page__meta" {...part("project.meta", slug)}>
      <div>
        <span class="entry-page__label">{detail.labels.role}</span>
        <p>{data.role}</p>
      </div>
      <div>
        <span class="entry-page__label">{detail.labels.location}</span>
        <p>{data.location}</p>
      </div>
      <div>
        <span class="entry-page__label">{detail.labels.date}</span>
        <p>{data.dateLabel}</p>
      </div>
    </div>

    {data.links.length > 0 && (
      <div class="entry-page__links" {...part("project.links", slug)}>
        {data.links.map((link: { label: string; url: string }) => (
          <Link treatment="action" href={link.url} newTab>
            {link.label}
          </Link>
        ))}
      </div>
    )}

    <TagList items={data.tools} label={`${data.title} tools`} {...part("project.tools", slug)} />

    <MediaRail media={data.media} {...part("project.media", slug)} />

    <article class="prose" {...part("project.body", slug)}>
      <Content />
    </article>
    <div class="entry-page__links">
      <Link href={detail.back.href} arrow>
        {detail.back.label}
      </Link>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ProjectTimeline from "../../components/ProjectTimeline.astro";
import { getProjects, getProjectsPage } from "../../lib/portfolio";

const page = await getProjectsPage();
const projects = await getProjects();
---

<BaseLayout
  title={page.title}
  description={page.description}
  pageClass="page-projects"
>
  <section class="shell page-section page-section--header">
    <PageHeader {...page.header} page="projects" />
  </section>
  <section class="shell page-section" aria-label={page.listLabel}>
    <ProjectTimeline projects={projects} />
  </section>
</BaseLayout>
